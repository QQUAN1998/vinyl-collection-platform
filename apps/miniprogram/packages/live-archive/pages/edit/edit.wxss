@import "../../app.wxss";
.half { flex: 1; min-width: 0; }
.date-control { position:relative; }
.date-picker .select { display:flex; align-items:center; justify-content:space-between; padding-right:44px; }
.date-placeholder { color:var(--muted); }
.date-arrow { margin-left:12rpx; color:var(--action); font-size:24rpx; }
.date-control .date-clear { position:absolute; right:0; top:0; width:44px; min-width:44px; height:100%; min-height:44px; padding:0; margin:0; display:flex; align-items:center; justify-content:center; font-size:34rpx; color:var(--muted); background:transparent; border:0; border-radius:0; }
.price-row { display:flex; align-items:center; gap:12rpx; margin-bottom:12rpx; }
.price-currency { flex:none; }
.price-currency .select { padding:20rpx 14rpx; font-size:25rpx; }
.price-amount { flex:1; min-width:0; }
.price-preset { flex:none; min-height:44px; display:flex; align-items:center; color:var(--action); font-size:24rpx; }
.price-remove { flex:none; padding:0; width:48rpx; min-height:44px; color:var(--muted); font-size:36rpx; }
.price-add { display:inline-flex; color:var(--action); padding:8rpx 0; min-height:64rpx; font-size:24rpx; }
.cover-preview { display: block; width: 220rpx; height: 294rpx; border-radius: 12rpx; background: var(--soft); }
.page { padding-top: 4rpx; padding-bottom: calc(168rpx + env(safe-area-inset-bottom)); }
.edit-actions { position: fixed; z-index: 10; left: 0; right: 0; bottom: 0; padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); background: var(--paper); border-top: 1rpx solid var(--line); }
.edit-actions .primary { width: 100%; }


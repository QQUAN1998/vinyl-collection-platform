/* stats-polish */
/* One layout for record, live and shared statistics. Tokens come from theme-service. */
.board{font-size:13px;line-height:1.5}
.title-row{margin-bottom:14px;min-height:38px}
.title-row .muted{font-size:12px}
.year-select{width:104px;min-height:36px;padding:8px 14px;border-radius:22px;background:transparent}
.card{padding:20px;border-radius:24px;border:1px solid var(--color-line);box-shadow:none}
.h2{font-size:16px;line-height:1.4;letter-spacing:0;gap:8px}
.h2 .ico{width:17px;height:17px}
.currency-card{position:relative;overflow:hidden;background:#171a17!important;color:#f7f8f2!important;border:0;padding:22px 22px 24px}
.currency-card::after{content:'';position:absolute;right:-42px;top:-60px;width:160px;height:160px;border:1px solid #ffffff12;border-radius:50%;pointer-events:none}
.currency-card .h2{font-size:12px;font-weight:500;margin-bottom:22px;color:#c9d0c3}
.currency-card .ico{width:16px;height:16px}
.currency-total{align-items:flex-end;gap:12px;padding:10px 0 16px}
.currency-total .amount{display:block;max-width:calc(100% - 44px);color:#f7f8f2!important;font-size:36px;line-height:1.1;font-weight:600;letter-spacing:-1px}
.currency-total>text:first-child{font-size:10px;letter-spacing:1px;opacity:.6;padding-bottom:4px}
.metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:10px}
.metric{padding:14px 12px 16px;min-height:112px;border-radius:20px;gap:18px;border:1px solid var(--color-line);background:var(--theme-card-surface)}
.metric:first-child{background:#d1ff66!important;border-color:#d1ff66;color:#171a17!important}
.metric-label{display:flex;align-items:center;gap:5px;min-height:30px;font-size:10px;font-weight:500;white-space:normal}
.metric-label text{white-space:normal!important;line-height:1.4;overflow:visible!important}
.metric-label .ico{width:13px;height:13px;flex:none}
.number{display:flex;align-items:baseline;gap:3px;font-size:28px;font-weight:600;letter-spacing:-1px;line-height:1.15;max-width:100%}
.number .unit{font-size:9px;margin:0;letter-spacing:0;flex:none}
.stack{gap:12px;margin-top:12px}
.module .between{gap:10px;align-items:flex-start}
.module .between>.muted{font-size:10px;padding-top:4px}
.trend-axis{padding:0 10px;margin:2px 0 18px;font-size:9px;letter-spacing:.5px}
.trend-detail{display:grid;grid-template-columns:72px minmax(0,1fr) auto;align-items:center;gap:12px;padding:14px 0 0;border-top:1px solid var(--color-line)}
.trend-detail .select{min-width:0;min-height:36px;background:var(--color-soft);border:0;border-radius:20px;padding:8px 11px;font-size:11px;gap:4px}
.trend-detail>view{display:flex;flex-direction:column;gap:4px;min-width:0}
.trend-count{font-size:20px;font-weight:600;line-height:1.2;letter-spacing:-.3px}
.trend-detail .muted{font-size:9px;word-break:break-word}
.trend-detail .pill{min-height:36px;padding:8px 0 8px 8px;background:transparent;font-size:10px;color:var(--color-muted)}
.legend{padding:12px 0;border-bottom:1px solid var(--color-line);font-size:11px}
.legend:last-child{border-bottom:0}
.legend>view{gap:8px;min-width:0}
.legend .muted{font-size:10px;margin-left:6px}
.rankrow{padding:16px 0;border-bottom:1px solid var(--color-line)}
.rankrow:last-child{border:0}
.rankbar{height:4px;margin-top:9px;border-radius:3px}
.rankbar>view{height:4px;background:#a7bb82}
.rank-avatar{border-radius:12px}
.city{background:transparent;border-bottom:1px solid var(--color-line);border-radius:0;padding:15px 0;margin:0}
.city>text:first-child{font-size:13px;font-weight:500}
.city>view{font-size:20px}
.pills{background:var(--color-soft);border-radius:20px;padding:3px;gap:0}
.pills .pill{min-height:28px;padding:6px 9px;font-size:10px;border-radius:16px}
.actions{margin-top:12px;gap:8px}
.timeline-art,.detail-row image{border-radius:8px}
.sheet{border-radius:26px;padding:22px}
@media(max-width:350px){.card{padding:17px}.currency-card{padding:20px}.currency-total .amount{font-size:32px}.metric{padding:12px 9px;min-height:108px}.number{font-size:25px}.metric-label{font-size:9px}.trend-detail{gap:8px;grid-template-columns:66px minmax(0,1fr) auto}.h2{font-size:15px}}


<view class="select-anchor" bindtap="open" aria-role="button" aria-label="{{label}}" aria-expanded="{{opened}}"><slot/></view><view wx:if="{{opened}}" class="select-overlay" catchtouchmove="noop"><view class="select-scrim" bindtap="close"/><scroll-view class="select-menu" style="{{menuStyle}}" scroll-y><button wx:for="{{rows}}" wx:key="index" class="select-option {{item.selected?'selected':''}}" data-index="{{item.index}}" bindtap="choose">{{item.label}}<text wx:if="{{item.selected}}">✓</text></button></scroll-view></view>

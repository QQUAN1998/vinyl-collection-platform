/* Shared native design tokens. Business state and custom theme selection stay intact. */
page{--color-ink:var(--color-ink);--color-muted:var(--color-muted);--color-faint:#a2a69e;--color-line:var(--color-line);--color-soft:var(--color-soft);--color-paper:var(--color-screen);--color-action:var(--color-ink);--color-select:var(--color-ink);--color-sync:var(--color-ink);--color-mustard:#d1ff66;--color-clay:var(--color-ink);--color-sky:#e7ece3;--palette-black:var(--color-ink);--palette-green-soft:#d1ff66;--palette-yellow-soft:var(--color-soft);--palette-red-soft:#e7ece3;--palette-red:var(--color-ink);--radius-card:36rpx;--radius-panel:36rpx;--radius-cover:0rpx;--safe-bottom:env(safe-area-inset-bottom);--ui-accent:#d1ff66;--ui-surface:var(--theme-card-surface);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',sans-serif;font-size:26rpx;line-height:1.5;background:var(--color-screen);color:var(--color-ink)}
.screen{padding:32rpx 40rpx calc(200rpx + env(safe-area-inset-bottom))}.screen-header{align-items:center;border:0;padding:0;min-height:72rpx;margin-bottom:40rpx}.screen-title{font-size:56rpx;line-height:1.2;font-weight:750;letter-spacing:-1.5rpx}.screen-kicker{font-size:21rpx;font-weight:500;color:var(--color-muted);letter-spacing:0}.section{margin-top:48rpx}.section-title{font-size:34rpx;line-height:1.4;font-weight:700;margin-bottom:24rpx}.caption,.muted{font-size:23rpx;font-weight:400}.primary-button,.secondary-button,.ghost-button{min-height:88rpx;font-size:26rpx;font-weight:600;border-radius:36rpx}.secondary-button{background:var(--color-soft)}.ghost-button{background:transparent}.panel,.card{border-radius:36rpx;box-shadow:none}.panel{padding:32rpx}.chip{font-size:23rpx;font-weight:500;min-height:68rpx}.divider{margin:40rpx 0;background:var(--color-line)}
@media(max-width:340px){.screen{padding-left:32rpx;padding-right:32rpx}.screen-title{font-size:50rpx}}

.screen{padding:16px 20px 124px}.ui-native-screen{padding:16px 20px 124px}.page{padding:16px 20px 124px}

.cabinet-screen {
  display: flex;
  flex-direction: column;
}

.collection-block {
  margin-bottom: 36rpx;
}

.collection-label {
  color: var(--color-action);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  line-height: 1.2;
}

.collection-count-row {
  display: flex;
  align-items: baseline;
  gap: 22rpx;
  margin-top: 24rpx;
}

.collection-count {
  color: var(--color-ink);
  font-size: 76rpx;
  font-weight: 800;
  line-height: 0.95;
}

.collection-unit {
  color: var(--color-muted);
  font-size: 28rpx;
  font-weight: 800;
}

.recent-list {
  display: grid;
  gap: 16rpx;
}

.home-catalog-section {
  margin-top: 56rpx;
  padding-bottom: 86rpx;
}

.catalog-sticky-tools {
  position: sticky;
  top: 0;
  z-index: 12;
  margin: 0 -2rpx 28rpx;
  padding: 20rpx 2rpx 12rpx;
  background: var(--color-paper);
  box-shadow: 0 18rpx 32rpx rgba(17, 20, 24, 0.04);
}

.catalog-head {
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 28rpx;
}

.catalog-head .section-title {
  margin-bottom: 0;
}

.catalog-count-label {
  flex: none;
  color: var(--color-muted);
  font-size: 23rpx;
  font-weight: 750;
}

.search-box {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 16rpx;
  align-items: center;
  min-height: 100rpx;
  box-sizing: border-box;
  padding: 14rpx 18rpx 14rpx 26rpx;
  border: 3rpx solid var(--color-action);
  border-radius: var(--radius-card);
  background: #ffffff;
  box-shadow: 0 20rpx 48rpx rgba(101, 118, 77, 0.08);
}

.catalog-search-box {
  margin-bottom: 24rpx;
}

.catalog-input {
  min-width: 0;
  height: 68rpx;
  color: var(--color-ink);
  font-size: 26rpx;
  font-weight: 850;
}

.catalog-search-button {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-card);
  background: rgba(101, 118, 77, 0.08);
  color: var(--color-action);
}

.catalog-search-button.is-clear {
  background: rgba(101, 118, 77, 0.14);
}

.search-action-icon {
  width: 32rpx;
  height: 32rpx;
}

.catalog-smart-chips {
  min-height: 56rpx;
  display: flex;
  gap: 12rpx;
  overflow-x: auto;
  padding: 0;
}

.smart-filter-chip {
  flex: 0 0 auto;
  min-height: 52rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-card);
  background: transparent;
  color: var(--color-ink);
  font-size: 22rpx;
  font-weight: 900;
}

.smart-filter-chip text {
  color: var(--color-action);
}

.smart-filter-chip.is-active {
  border-color: rgba(101, 118, 77, 0.42);
  background: rgba(101, 118, 77, 0.08);
}

.all-album-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 28rpx 20rpx;
}

.album-tile {
  min-width: 0;
  display: grid;
  gap: 12rpx;
}

.album-tile-cover {
  width: 100%;
  aspect-ratio: 1;
  display: block;
  overflow: hidden;
  border-radius: var(--radius-cover);
  background: var(--color-soft);
  box-shadow: 0 16rpx 36rpx rgba(17, 20, 24, 0.08);
}

.album-tile-cover image {
  width: 100%;
  height: 100%;
}

.album-tile-title,
.album-tile-meta {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.album-tile-title {
  color: var(--color-ink);
  font-size: 24rpx;
  font-weight: 950;
  line-height: 1.2;
}

.album-tile-meta {
  color: var(--color-muted);
  font-size: 22rpx;
  font-weight: 850;
}

.catalog-empty {
  margin-top: 18rpx;
  padding: 34rpx;
  border-radius: var(--radius-card);
  background: var(--color-soft);
}

.catalog-empty-title {
  color: var(--color-ink);
  font-size: 28rpx;
  font-weight: 900;
}

.catalog-empty-desc {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.5;
}

.catalog-empty-action {
  margin-top: 22rpx;
}

.photo-wall-section {
  margin-bottom: 46rpx;
}

.photo-wall-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.photo-wall {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.photo-tile {
  width: 100%;
  aspect-ratio: 1;
  display: block;
  overflow: hidden;
  border-radius: var(--radius-cover);
  background: var(--color-soft);
  box-shadow: none;
}

.photo-tile:first-child {
  grid-column: auto;
  grid-row: auto;
}

.photo-tile-image {
  width: 100%;
  height: 100%;
}

.photo-tile.is-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed rgba(17, 20, 24, 0.18);
  background: #f1f2ef;
  box-shadow: none;
}

.placeholder-disc {
  width: 54rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-card);
  background: rgba(101, 118, 77, 0.12);
  color: rgba(101, 118, 77, 0.66);
  opacity: 1;
}

.placeholder-icon {
  width: 30rpx;
  height: 30rpx;
}

.add-fab {
  position: fixed;
  right: 50rpx;
  bottom: calc(154rpx + var(--safe-bottom));
  z-index: 21;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #65764d, #4f6042);
  box-shadow: 0 20rpx 44rpx rgba(101, 118, 77, 0.26);
}

.add-fab::before,
.add-fab::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 36rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #ffffff;
  transform: translate(-50%, -50%);
}

.add-fab::after {
  transform: translate(-50%, -50%) rotate(90deg);
}

.add-fab-hover {
  opacity: 0.88;
}

.album-card-modal {
  position: fixed;
  inset: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 34rpx;
  box-sizing: border-box;
}

.album-card-scrim {
  position: absolute;
  inset: 0;
  background: rgba(17, 20, 24, 0.46);
}

.album-modal-card {
  position: relative;
  z-index: 1;
  width: 626rpx;
  max-height: 82vh;
  box-sizing: border-box;
  overflow: auto;
  padding: 22rpx;
  border: 1rpx solid rgba(101, 118, 77, 0.28);
  border-radius: var(--radius-panel);
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 30rpx 80rpx rgba(17, 20, 24, 0.28);
  animation: album-card-rise 180ms ease-out;
}

.album-modal-card::before {
  content: "";
  position: absolute;
  inset: 14rpx;
  pointer-events: none;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  border-radius: var(--radius-panel);
}

.album-modal-card.rarity-n {
  border-color: rgba(101, 118, 77, 0.54);
  background: linear-gradient(145deg, #ffffff, #f6faf1);
}

.album-modal-card.rarity-r {
  border-color: rgba(95, 143, 147, 0.58);
  background: linear-gradient(145deg, #ffffff, #edf7f8);
}

.album-modal-card.rarity-sr {
  border-color: rgba(128, 106, 145, 0.62);
  background: linear-gradient(145deg, #ffffff, #f7f1fb);
}

.album-modal-card.rarity-ssr {
  border-color: rgba(191, 201, 210, 0.92);
  background: linear-gradient(145deg, #ffffff, #f7f9fa 44%, #eef2f4);
  box-shadow: 0 24rpx 70rpx rgba(151, 164, 176, 0.22), 0 28rpx 72rpx rgba(17, 20, 24, 0.2);
  animation: album-card-rise 180ms ease-out, ssr-card-glow 3.8s ease-in-out infinite;
}

.album-modal-card.rarity-ur {
  border-color: rgba(244, 190, 50, 0.78);
  background: linear-gradient(145deg, #fffdf4, #f4fff9 48%, #fff5d1);
  box-shadow: 0 24rpx 76rpx rgba(244, 190, 50, 0.28), 0 28rpx 72rpx rgba(17, 20, 24, 0.2);
  animation: album-card-rise 180ms ease-out, ur-card-glow 3.4s ease-in-out infinite;
}

@keyframes album-card-rise {
  from {
    opacity: 0;
    transform: translateY(26rpx) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes ssr-card-glow {
  0%, 100% {
    box-shadow: 0 24rpx 70rpx rgba(151, 164, 176, 0.2), 0 28rpx 72rpx rgba(17, 20, 24, 0.2);
  }
  50% {
    box-shadow: 0 24rpx 76rpx rgba(205, 214, 222, 0.42), 0 28rpx 72rpx rgba(17, 20, 24, 0.2);
  }
}

@keyframes ur-card-glow {
  0%, 100% {
    box-shadow: 0 24rpx 76rpx rgba(244, 190, 50, 0.24), 0 28rpx 72rpx rgba(17, 20, 24, 0.2);
  }
  50% {
    box-shadow: 0 28rpx 88rpx rgba(244, 190, 50, 0.42), 0 28rpx 72rpx rgba(17, 20, 24, 0.2);
  }
}

.modal-close {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  z-index: 2;
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: rgba(17, 20, 24, 0.62);
  font-size: 44rpx;
  line-height: 1;
}

.modal-favorite-star {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  z-index: 3;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(101, 118, 77, 0.24);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.84);
  color: rgba(101, 118, 77, 0.7);
  font-size: 34rpx;
  font-weight: 950;
  line-height: 1;
  box-shadow: 0 10rpx 24rpx rgba(17, 20, 24, 0.08);
}

.modal-favorite-star.is-collected {
  border-color: rgba(244, 190, 50, 0.56);
  background: #fff7d6;
  color: #b37d00;
}

.favorite-star-icon {
  width: 34rpx;
  height: 34rpx;
}

.modal-cover-wrap {
  position: relative;
  width: 360rpx;
  aspect-ratio: 1;
  margin: 8rpx auto 18rpx;
  overflow: hidden;
  border: 4rpx solid var(--color-action);
  border-radius: var(--radius-cover);
  background: var(--color-soft);
}

.modal-cover-wrap::after {
  content: "";
  position: absolute;
  top: -35%;
  bottom: -35%;
  left: -70%;
  width: 52%;
  opacity: 0;
  transform: rotate(18deg);
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.86), transparent);
}

.modal-cover {
  width: 100%;
  height: 100%;
}

.rarity-n .modal-cover-wrap {
  border-color: #65764d;
  box-shadow: 0 18rpx 44rpx rgba(17, 20, 24, 0.14), 0 0 0 4rpx rgba(101, 118, 77, 0.14);
}

.rarity-r .modal-cover-wrap {
  border-color: #5f8f93;
  box-shadow: 0 18rpx 44rpx rgba(17, 20, 24, 0.14), 0 0 0 4rpx rgba(95, 143, 147, 0.16), 0 0 34rpx rgba(95, 143, 147, 0.16);
}

.rarity-sr .modal-cover-wrap {
  border-color: #806a91;
  box-shadow: 0 18rpx 44rpx rgba(17, 20, 24, 0.14), 0 0 0 4rpx rgba(128, 106, 145, 0.2), 0 0 32rpx rgba(128, 106, 145, 0.16);
}

.rarity-ssr .modal-cover-wrap {
  border-color: #b7c1ca;
  box-shadow: 0 18rpx 44rpx rgba(17, 20, 24, 0.14), 0 0 0 4rpx rgba(255, 255, 255, 0.86), 0 0 34rpx rgba(176, 188, 198, 0.28);
  animation: ssr-cover-breathe 3.2s ease-in-out infinite;
}

.rarity-ur .modal-cover-wrap {
  border-color: #f4be32;
  box-shadow: 0 18rpx 44rpx rgba(17, 20, 24, 0.14), 0 0 0 4rpx rgba(244, 190, 50, 0.28), 0 0 36rpx rgba(244, 190, 50, 0.34);
  animation: ur-cover-breathe 2.8s ease-in-out infinite;
}

.rarity-ssr .modal-cover-wrap::after,
.rarity-ur .modal-cover-wrap::after {
  animation: rarity-shine 2.8s ease-in-out infinite;
}

@keyframes rarity-shine {
  0%, 42% {
    left: -70%;
    opacity: 0;
  }
  54% {
    opacity: 0.84;
  }
  72%, 100% {
    left: 120%;
    opacity: 0;
  }
}

@keyframes ssr-cover-breathe {
  0%, 100% {
    box-shadow: 0 16rpx 38rpx rgba(17, 20, 24, 0.13), 0 0 0 3rpx rgba(176, 188, 198, 0.18), 0 0 24rpx rgba(176, 188, 198, 0.16);
  }
  50% {
    box-shadow: 0 18rpx 42rpx rgba(17, 20, 24, 0.14), 0 0 0 4rpx rgba(255, 255, 255, 0.72), 0 0 42rpx rgba(191, 201, 210, 0.32);
  }
}

@keyframes ur-cover-breathe {
  0%, 100% {
    box-shadow: 0 16rpx 38rpx rgba(17, 20, 24, 0.13), 0 0 0 3rpx rgba(244, 190, 50, 0.22), 0 0 30rpx rgba(244, 190, 50, 0.22);
  }
  50% {
    box-shadow: 0 20rpx 46rpx rgba(17, 20, 24, 0.14), 0 0 0 4rpx rgba(255, 223, 105, 0.46), 0 0 50rpx rgba(244, 190, 50, 0.4);
  }
}

.modal-card-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.rarity-corner {
  position: relative;
  min-width: 134rpx;
  min-height: 72rpx;
  box-sizing: border-box;
  display: grid;
  align-content: center;
  justify-items: center;
  padding: 7rpx 16rpx;
  overflow: hidden;
  border-radius: var(--radius-card);
  background: rgba(17, 20, 24, 0.84);
  color: #ffffff;
}

.rarity-n .rarity-corner {
  background: #65764d;
}

.rarity-r .rarity-corner {
  background: linear-gradient(135deg, #5f8f93, #2563eb);
}

.rarity-sr .rarity-corner {
  background: linear-gradient(135deg, #a78bfa, #6d28d9);
}

.rarity-ssr .rarity-corner {
  background: linear-gradient(135deg, #ffffff, #b7c1ca 48%, #eef2f4);
  color: var(--color-ink);
}

.rarity-ur .rarity-corner {
  background: linear-gradient(135deg, #f7d046, #b66b00);
  color: var(--color-ink);
}

.rarity-ssr .rarity-corner::after,
.rarity-ur .rarity-corner::after {
  content: "";
  position: absolute;
  top: -40%;
  bottom: -40%;
  left: -70%;
  width: 64%;
  opacity: 0;
  transform: rotate(18deg);
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.72), transparent);
  animation: rarity-badge-sweep 2.6s ease-in-out infinite;
}

@keyframes rarity-badge-sweep {
  0%, 46% {
    left: -70%;
    opacity: 0;
  }
  58% {
    opacity: 0.72;
  }
  100% {
    left: 108%;
    opacity: 0;
  }
}

.rarity-code {
  font-size: 30rpx;
  font-weight: 950;
  line-height: 1;
}

.rarity-name {
  margin-top: 4rpx;
  font-size: 18rpx;
  font-weight: 900;
}

.modal-title {
  margin-top: 12rpx;
  color: var(--color-ink);
  font-size: 40rpx;
  font-weight: 950;
  line-height: 1.08;
}

.modal-subtitle {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  font-weight: 850;
}

.modal-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.modal-tags view {
  min-height: 46rpx;
  display: flex;
  align-items: center;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(101, 118, 77, 0.1);
  color: var(--color-ink);
  font-size: 21rpx;
  font-weight: 900;
}

.modal-tracks {
  display: grid;
  gap: 8rpx;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--color-line);
}

.modal-track-scroll {
  height: 144rpx;
  max-height: 144rpx;
}

.modal-tracks-title {
  color: var(--color-ink);
  font-size: 24rpx;
  font-weight: 950;
}

.modal-track {
  display: grid;
  grid-template-columns: 36rpx 1fr;
  gap: 10rpx;
  color: var(--color-muted);
  font-size: 22rpx;
  font-weight: 820;
  line-height: 1.3;
}

.modal-track text:first-child {
  color: var(--color-action);
  font-weight: 950;
}

.modal-actions {
  display: grid;
  grid-template-columns: 44rpx repeat(3, minmax(0, 1fr)) 44rpx;
  gap: 10rpx;
  align-items: center;
  margin-top: 20rpx;
}

.circle-action,
.modal-action-button {
  min-height: 64rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-radius: var(--radius-card);
  font-weight: 950;
}

.circle-action {
  position: relative;
  background: transparent;
  color: transparent;
  font-size: 0;
}

.circle-action::before {
  content: "";
  position: absolute;
  top: 50%;
  width: 32rpx;
  height: 38rpx;
  transform: translateY(-50%);
  border-radius: var(--radius-card);
  background: rgba(17, 20, 24, 0.28);
  clip-path: polygon(88% 8%, 88% 92%, 12% 50%);
}

.circle-action.is-prev::before {
  left: 4rpx;
}

.circle-action.is-next::before {
  right: 4rpx;
  transform: translateY(-50%) rotate(180deg);
}

.modal-action-button {
  border: 1rpx solid rgba(101, 118, 77, 0.18);
  background: rgba(255, 255, 255, 0.62);
  color: var(--color-ink);
  font-size: 22rpx;
}

.modal-action-icon {
  flex: none;
  width: 28rpx;
  height: 28rpx;
}

.modal-edit-action {
  background: #efe7c8;
  color: #4f6042;
}

.modal-detail-action {
  background: var(--palette-black);
  color: #ffffff;
}

.modal-wall-action {
  background: rgba(101, 118, 77, 0.12);
  color: var(--color-action);
}

.modal-wall-action.is-on-wall {
  background: rgba(17, 20, 24, 0.08);
  color: rgba(17, 20, 24, 0.68);
}

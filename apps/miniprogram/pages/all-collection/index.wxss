@import "../cabinet/index.wxss";

.all-collection-screen {
  display: flex;
  flex-direction: column;
  gap: 36rpx;
}

.owner-panel {
  display: grid;
  grid-template-columns: 92rpx 1fr;
  gap: 22rpx;
  align-items: center;
  padding: 28rpx;
  border: 1rpx solid rgba(26, 26, 26, 0.08);
  border-radius: var(--radius-card);
  background: var(--palette-black);
}

.owner-avatar {
  width: 92rpx;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--color-mustard);
  color: var(--color-ink);
  font-size: 36rpx;
  font-weight: 950;
}

.owner-copy {
  min-width: 0;
}

.owner-title {
  overflow: hidden;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 950;
  line-height: 1.15;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.owner-desc {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.35;
}

.row-meta {
  color: var(--color-muted);
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.35;
}

.collection-summary-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.summary-cell {
  min-width: 0;
  min-height: 128rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 24rpx;
  border-radius: var(--radius-card);
}

.summary-cell:nth-child(1) {
  background: var(--palette-green-soft);
}

.summary-cell:nth-child(2) {
  background: var(--palette-yellow-soft);
}

.summary-cell:nth-child(3) {
  background: var(--palette-red);
  color: #ffffff;
}

.summary-value {
  overflow: hidden;
  font-size: 34rpx;
  font-weight: 950;
  line-height: 1.12;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.summary-label {
  font-size: 22rpx;
  font-weight: 850;
  opacity: 0.82;
}

.collection-search-tools {
  display: grid;
  gap: 20rpx;
}

.collection-search-box {
  min-height: 104rpx;
}

.collection-search-scopes {
  width: 100%;
  white-space: nowrap;
}

.collection-scope-chip {
  min-height: 56rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-right: 14rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-card);
  background: transparent;
  color: var(--color-action);
  font-size: 23rpx;
  font-weight: 900;
}

.collection-scope-chip.is-active {
  border-color: rgba(101, 118, 77, 0.38);
  background: rgba(101, 118, 77, 0.1);
  color: var(--color-ink);
}

.all-list-section {
  margin-top: 8rpx;
}

.head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 22rpx;
}

.head-row .section-title {
  margin-bottom: 0;
}

.all-album-list {
  display: grid;
  gap: 0;
}

.all-album-row {
  min-height: 144rpx;
  display: grid;
  grid-template-columns: 118rpx 1fr auto;
  gap: 22rpx;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-line);
}

.all-album-row-hover {
  background: rgba(101, 118, 77, 0.08);
}

.all-album-cover {
  width: 118rpx;
  height: 118rpx;
  border-radius: var(--radius-cover);
  background: var(--color-soft);
}

.all-album-copy {
  min-width: 0;
}

.all-album-title {
  overflow: hidden;
  color: var(--color-ink);
  font-size: 31rpx;
  font-weight: 950;
  line-height: 1.16;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.all-album-meta {
  overflow: hidden;
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 23rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.all-album-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}

.all-album-tags text {
  min-height: 36rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: rgba(101, 118, 77, 0.1);
  color: var(--color-ink);
  font-size: 19rpx;
  font-weight: 900;
}

.all-album-rarity {
  min-width: 76rpx;
  min-height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-card);
  background: var(--color-action);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 950;
}

.all-album-rarity.rarity-r {
  background: #5f8f93;
}

.all-album-rarity.rarity-sr {
  background: #806a91;
}

.all-album-rarity.rarity-ssr {
  background: linear-gradient(135deg, #ffffff, #b7c1ca 48%, #eef2f4);
  color: var(--color-ink);
}

.all-album-rarity.rarity-ur {
  background: linear-gradient(135deg, #f7d046, #b66b00);
  color: var(--color-ink);
}

.all-modal-actions {
  grid-template-columns: 44rpx 1fr 44rpx;
  max-width: 360rpx;
  margin-left: auto;
  margin-right: auto;
}

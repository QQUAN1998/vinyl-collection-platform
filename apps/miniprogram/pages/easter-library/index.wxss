.easter-screen {
  padding-bottom: 180rpx;
}

.password-panel,
.library-summary {
  border: 2rpx solid var(--color-line);
  border-radius: var(--radius-card);
  padding: 44rpx;
  background: var(--palette-black);
  color: var(--theme-card-surface);
}

.password-kicker,
.library-pill {
  color: var(--color-action);
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.password-title,
.library-title {
  margin-top: 18rpx;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.1;
}

.password-copy,
.library-copy {
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.5;
}

.password-input {
  box-sizing: border-box;
  width: 100%;
  height: 96rpx;
  margin-top: 34rpx;
  padding: 0 28rpx;
  border-radius: 28rpx;
  background: var(--theme-input-surface);
  color: var(--color-ink);
  font-size: 34rpx;
  font-weight: 800;
}

.password-button,
.action-button,
.sticky-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  border-radius: 28rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.password-button {
  margin-top: 24rpx;
  background: var(--color-action);
  color: var(--palette-black);
}

.library-summary {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.library-pill {
  flex-shrink: 0;
  margin-top: 8rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
}

.library-search {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 68rpx;
  align-items: center;
  height: 98rpx;
  margin-top: 30rpx;
  border: 3rpx solid var(--color-action);
  border-radius: 30rpx;
  background: var(--theme-input-surface);
}

.library-search-input {
  height: 100%;
  padding: 0 28rpx;
  color: var(--color-ink);
  font-size: 30rpx;
  font-weight: 800;
}

.library-clear {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(94, 111, 68, 0.12);
  color: var(--color-action);
  font-size: 34rpx;
  font-weight: 900;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 22rpx;
}

.action-button {
  border: 2rpx solid var(--color-line);
}

.action-button.secondary {
  background: var(--theme-input-surface);
  color: var(--color-ink);
}

.action-button.primary {
  grid-column: 1 / -1;
  background: var(--palette-black);
  color: var(--theme-card-surface);
}

.library-head {
  margin-top: 38rpx;
}

.album-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.sticky-actions {
  position: fixed;
  left: 30rpx;
  right: 30rpx;
  bottom: calc(34rpx + env(safe-area-inset-bottom));
  z-index: 8;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 220rpx;
  gap: 18rpx;
  align-items: center;
  padding: 22rpx;
  border-radius: 30rpx;
  background: rgba(26, 26, 26, 0.96);
  color: var(--theme-card-surface);
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.18);
}

.sticky-title {
  font-size: 30rpx;
  font-weight: 900;
}

.sticky-subtitle {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.35;
}

.sticky-button {
  background: var(--theme-input-surface);
  color: var(--color-ink);
}

.sticky-button.is-disabled {
  opacity: 0.42;
}

@import "../../ui/pages.wxss";
/* Unified screenshot refinement */
@import "../../ui/deep-pages.wxss";

<wxs module="i18n" src="../../ui/locale.wxs"/><page-meta root-background-color="#f5f6f2" background-color="#f5f6f2" background-color-top="#f5f6f2" background-color-bottom="#f5f6f2" page-style="background:#f5f6f2;min-height:100vh;"/>
<view class="{{uiThemeClass}} screen all-collection-screen {{themeClass}}" style="padding-top:{{uiChromeHeight}}px!important;{{themeStyle}};{{uiThemeStyle}}">
  
  <view class="ui-catalog-head"><view class="ui-catalog-heading"><view class="ui-catalog-title">{{i18n.t('全部唱片',uiLanguage)}}</view><text class="ui-catalog-count {{canManageCollection?'':'ui-shared-owner'}}">{{canManageCollection?stats.albumCount+i18n.t(' 张收藏',uiLanguage):userName+i18n.t(' 的唱片柜',uiLanguage)}}</text></view><block wx:if="{{canManageCollection}}"><button wx:if="{{uiShareReady}}" class="ui-catalog-share" open-type="share" disabled="{{!collectedAlbums.length||batchDeleteMode}}" aria-label="{{i18n.t('分享全部唱片',uiLanguage)}}"><image src="/assets/ui/share.svg"/>{{i18n.t('分享',uiLanguage)}}</button><button wx:else class="ui-catalog-share" bindtap="uiPrepareShare" loading="{{uiPreparingShare}}" disabled="{{uiPreparingShare}}" aria-label="{{i18n.t('准备分享全部唱片',uiLanguage)}}"><image src="/assets/ui/share.svg"/>{{i18n.t('分享',uiLanguage)}}</button></block></view>
  <view wx:if="{{uiSharedError}}" class="ui-share-unavailable">{{i18n.t('收藏暂时不可用',uiLanguage)}}<button bindtap="loadCollection">{{i18n.t('重试',uiLanguage)}}</button></view>
  <view class="collection-search-tools">
    <view class="search-box collection-search-box ui-catalog-search"><image src="/assets/ui/search.svg"/>
      <input class="search-input" value="{{query}}" bindinput="handleQuery" placeholder="{{i18n.t('搜唱片 / 艺人 / 风格 / 年份',uiLanguage)}}" confirm-type="search" />
      <view wx:if="{{query}}" class="search-action is-clear" bindtap="clearQuery" aria-role="button" aria-label="{{i18n.t('清空搜索',uiLanguage)}}">
        <image class="search-action-icon" src="/assets/icons/close-action.png" mode="aspectFit" />
      </view>

    </view>
    <scroll-view class="collection-search-scopes" scroll-x enhanced="{{true}}" show-scrollbar="{{false}}">
      <view
        wx:for="{{searchScopes}}"
        wx:key="key"
        class="collection-scope-chip {{item.active ? 'is-active' : ''}}"
        data-scope="{{item.key}}"
        bindtap="selectSearchScope"
      >{{i18n.t(item.label,uiLanguage)}}</view>
    </scroll-view>
  </view>

  <view class="section all-list-section">
    <view class="head-row">
      <view class="section-title">{{i18n.t('收藏列表',uiLanguage)}}</view>
      <view class="row-meta">{{visibleAlbums.length}} / {{collectedAlbums.length}} {{i18n.t('张',uiLanguage)}}</view>
    </view>
    <view class="ui-catalog-results"><text>{{query?visibleAlbums.length+' / ':''}}{{collectedAlbums.length}} {{i18n.t('张唱片',uiLanguage)}}</text><view wx:if="{{canManageCollection && collectedAlbums.length}}" class="batch-toolbar">
      <view class="batch-toolbar-copy">{{batchDeleteMode ? i18n.t('点击唱片选择要删除的收藏',uiLanguage) : i18n.t('可一次选择多张唱片删除',uiLanguage)}}</view>
      <view class="batch-toolbar-actions">
        <view
          wx:if="{{batchDeleteMode}}"
          class="batch-toggle is-secondary {{allVisibleSelected ? 'is-active' : ''}}"
          bindtap="toggleSelectAllVisible"
          aria-role="button"
          aria-label="{{allVisibleSelected ? i18n.t('取消全选当前唱片',uiLanguage) : i18n.t('全选当前唱片',uiLanguage)}}"
        >{{allVisibleSelected ? i18n.t('取消全选',uiLanguage) : i18n.t('全选',uiLanguage)}}</view>
        <view
          class="batch-toggle {{batchDeleteMode ? 'is-active' : ''}}"
          bindtap="toggleBatchDeleteMode"
          aria-role="button"
          aria-label="{{batchDeleteMode ? i18n.t('完成批量删除',uiLanguage) : i18n.t('批量删除唱片',uiLanguage)}}"
        >{{batchDeleteMode ? i18n.t('完成',uiLanguage) : i18n.t('批量删除',uiLanguage)}}</view>
      </view>
    </view>

    </view>
    <view class="all-album-list" wx:if="{{visibleAlbums.length}}">
      <view
        wx:for="{{visibleAlbums}}"
        wx:key="id"
        class="all-album-row {{batchDeleteMode ? 'is-batch-mode' : ''}} {{item.batchSelected ? 'is-selected' : ''}}"
        data-album-id="{{item.id}}"
        bindtap="handleAlbumRowTap"
        hover-class="all-album-row-hover"
        aria-role="button"
      >
        <view wx:if="{{batchDeleteMode}}" class="batch-select-mark {{item.batchSelected ? 'is-selected' : ''}}" aria-hidden="true">
          <text wx:if="{{item.batchSelected}}">✓</text>
        </view>
        <image class="all-album-cover" src="{{item.cover}}" mode="aspectFill" lazy-load />
        <view class="all-album-copy">
          <view class="all-album-title">{{item.title}}</view>
          <view class="all-album-meta">{{item.artist}} · {{item.year}}</view>
          <view class="all-album-tags">
            <text>{{item.mediumLabel}}</text>
            <text>{{item.priceLabel}}</text>
          </view>
        </view>
        <view class="all-album-rarity {{item.rarityClass}}">
          <text>{{item.rarityCode}}</text>
        </view>
      </view>
    </view>
    <view wx:if="{{batchDeleteMode}}" class="batch-delete-bar">
      <view class="batch-delete-copy">
        <view class="batch-delete-title">{{i18n.t('已选择',uiLanguage)}} {{selectedCount}} {{i18n.t('张',uiLanguage)}}</view>
        <view class="batch-delete-desc">{{i18n.t('只会删除你自己的收藏',uiLanguage)}}</view>
      </view>
      <view
        class="batch-delete-button {{selectedCount ? '' : 'is-disabled'}}"
        bindtap="confirmBatchDelete"
        aria-role="button"
        aria-label="{{i18n.t('删除已选唱片',uiLanguage)}}"
      >{{i18n.t('删除',uiLanguage)}}</view>
    </view>

    <state-view
      wx:if="{{!visibleAlbums.length}}"
      tone="warning"
      title="{{collectedAlbums.length ? '没有匹配结果' : '暂无收藏'}}"
      description="{{collectedAlbums.length ? '换个关键词或筛选范围再试试。' : '添加第一张唱片'}}"
    />
  </view>

<view class="album-card-modal ui-album-dialog" wx:if="{{albumCard}}" catchtouchmove="noop"><view class="album-card-scrim" bindtap="closeAlbumCard"/><scroll-view scroll-y class="ui-album-sheet" catchtap="noop"><view class="ui-dialog-head"><text>{{i18n.t('唱片收藏',uiLanguage)}}</text><button class="ui-dialog-close" bindtap="closeAlbumCard" aria-label="{{i18n.t('关闭',uiLanguage)}}">×</button></view><image class="ui-dialog-cover" src="{{albumCard.cover}}" mode="aspectFit"/><view class="ui-dialog-meta"><view class="ui-dialog-kicker"><text>{{albumCard.mediumLabel}} · {{albumCard.year}}</text><text>{{albumCard.priceLabel}}</text></view><view class="ui-dialog-title">{{albumCard.title}}</view><view class="ui-dialog-artist">{{albumCard.artist}}</view><view wx:if="{{uiLife[albumCard.id]}}" class="ui-life">{{i18n.t('人生第',uiLanguage)}} {{uiLife[albumCard.id]}} {{i18n.t('张唱片',uiLanguage)}}</view></view><view class="ui-dialog-actions ui-dialog-readonly"><button class="ui-dialog-primary" bindtap="openCardDetail">{{i18n.t('详情',uiLanguage)}} <image class="ui-dialog-icon" src="/assets/ui/arrow.svg"/></button></view><view class="ui-dialog-pager"><button data-direction="-1" bindtap="moveAlbumCard" aria-label="{{i18n.t('上一张',uiLanguage)}}">‹</button><text>{{cardPositionLabel}}</text><button data-direction="1" bindtap="moveAlbumCard" aria-label="{{i18n.t('下一张',uiLanguage)}}">›</button></view></scroll-view></view>

</view>

<home-dock wx:if="{{canManageCollection}}" active="add"/>
<page-container show="{{uiDetailOpen}}" position="bottom" duration="280" overlay="{{true}}" bindbeforeleave="uiDismissDetail" bindafterleave="uiDetailLeft" custom-style="height:100%;background:#f5f6f2;"><detail-sheet wx:if="{{uiDetailOptions}}" id="uiDetail" options="{{uiDetailOptions}}" bindclose="uiDismissDetail"/></page-container><button style="{{uiThemeStyle}}" class="{{uiThemeClass}} ui-form-back" bindtap="uiPageBack" aria-label="{{i18n.t('返回',uiLanguage)}}"><image src="/assets/ui/back.svg"/></button>
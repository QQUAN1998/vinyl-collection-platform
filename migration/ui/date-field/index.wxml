<view class="date-control"><button class="date-trigger {{!value?'muted':''}}" bindtap="open" disabled="{{disabled}}" aria-label="{{label}}">{{value||'选择日期'}}<image class="date-icon" src="/assets/ui/calendar.svg"/></button></view>
<view wx:if="{{opened}}" class="date-overlay" catchtouchmove="noop"><view class="scrim" bindtap="close"/><view class="date-panel"><view class="date-title"><text>{{label}}</text><button class="icon-button" bindtap="close" aria-label="关闭日期选择">×</button></view><view class="date-nav"><button class="icon-button" data-step="-1" bindtap="move" aria-label="上个月">‹</button><ui-select range="{{years}}" value="{{yearIndex}}" bindchange="yearChange" label="日期年份"><view class="date-select">{{year}}年 <text>⌄</text></view></ui-select><ui-select range="{{months}}" value="{{month}}" bindchange="monthChange" label="日期月份"><view class="date-select">{{month+1}}月 <text>⌄</text></view></ui-select><button class="icon-button" data-step="1" bindtap="move" aria-label="下个月">›</button></view><view class="date-week"><text wx:for="{{weekdays}}" wx:key="*this">{{item}}</text></view><view class="date-days"><block wx:for="{{days}}" wx:key="id"><view wx:if="{{item.blank}}"/><button wx:else class="date-day {{item.selected?'selected':''}} {{item.today?'today':''}}" disabled="{{item.disabled}}" data-value="{{item.id}}" bindtap="choose" aria-label="{{item.id}}">{{item.day}}</button></block></view><view class="date-footer"><button wx:if="{{!required}}" class="date-clear" bindtap="clear">清除日期</button><button class="date-today" bindtap="today">今天</button></view></view></view>

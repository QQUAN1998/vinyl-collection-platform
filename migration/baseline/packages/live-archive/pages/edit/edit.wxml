<view class="page"><view class="field"><view class="label">演出名称 *</view><input class="field-input" value="{{draft.name}}" maxlength="200" data-key="name" aria-label="演出名称" bindinput="input" placeholder="演出名称"/></view><view class="field"><view class="label">艺人</view><input class="field-input" value="{{draft.artist}}" maxlength="500" data-key="artist" aria-label="艺人" bindinput="input" placeholder="多位艺人用 / 分隔"/></view><view class="row"><view class="field half"><view class="label">观看日期{{draft.status === '已看过' ? ' *' : ''}}</view><view class="date-control"><picker class="date-picker" mode="date" fields="day" start="1900-01-01" end="2100-12-31" value="{{dateValue}}" bindchange="dateChange" disabled="{{busy}}" aria-label="选择观看日期"><view class="select {{!draft.date ? 'date-placeholder' : ''}}">{{draft.date||'选择日期'}}<text wx:if="{{!draft.date}}" class="date-arrow">▾</text></view></picker><button wx:if="{{draft.date}}" class="date-clear" catchtap="clearDate" disabled="{{busy}}" aria-label="清除观看日期">×</button></view></view><view class="field half"><view class="label">状态</view><picker range="{{statuses}}" value="{{statusIndex}}" data-key="status" bindchange="picker" disabled="{{busy}}"><view class="select">{{draft.status}} ▾</view></picker></view></view><view class="row"><view class="field half"><view class="label">城市</view><input class="field-input" value="{{draft.city}}" maxlength="80" data-key="city" aria-label="城市" bindinput="input" placeholder="城市"/></view><view class="field half"><view class="label">类型</view><picker range="{{types}}" value="{{typeIndex}}" data-key="type" bindchange="picker" disabled="{{busy}}"><view class="select">{{draft.type}} ▾</view></picker></view></view><view class="field"><view class="label">场馆</view><input class="field-input" value="{{draft.venue}}" maxlength="160" data-key="venue" aria-label="场馆" bindinput="input" placeholder="场馆"/></view><view class="field ticket-price-field"><view class="label">票价</view>
  <view wx:for="{{ticketPrices}}" wx:key="index" class="price-row">
    <picker class="price-currency" range="{{currencies}}" value="{{item.currencyIndex}}" data-index="{{index}}" bindchange="priceCurrency" disabled="{{busy}}" aria-label="票价币种"><view class="select">{{item.currency}} ▾</view></picker>
    <input class="price-amount" type="digit" value="{{item.amount}}" placeholder="填写金额" maxlength="12" data-index="{{index}}" bindinput="priceInput" disabled="{{busy}}" aria-label="票价金额"/>
    <picker class="price-preset" range="{{pricePresets}}" data-index="{{index}}" bindchange="pricePreset" disabled="{{busy}}" aria-label="选择常用金额"><view>常用金额 ▾</view></picker>
    <button class="price-remove" data-index="{{index}}" bindtap="removePrice" disabled="{{busy}}" aria-label="移除此笔票价">×</button>
  </view>
  <button class="link price-add" bindtap="addPrice" disabled="{{busy}}">＋另一笔票价</button>
</view><view class="field"><view class="label">海报</view><image wx:if="{{draft.cover||draft.posterUrl}}" src="{{draft.cover||draft.posterUrl}}" mode="aspectFit" class="cover-preview"/><view class="actions"><button class="outline" bindtap="cover" disabled="{{busy}}">上传海报</button><button wx:if="{{draft.cover}}" class="link" bindtap="clearCover">移除上传</button></view></view><view class="field" wx:if="{{!draft.date}}"><view class="muted">请选择实际观看日期；展期不作为观看日期。</view></view><view class="field"><view class="label">来源链接</view><input class="field-input" value="{{draft.source}}" maxlength="2048" data-key="source" aria-label="来源链接" bindinput="input" placeholder="可留空"/></view><view class="field" wx:if="{{draft.tickets.length}}"><view class="label">私人票根</view><image wx:for="{{draft.tickets}}" wx:key="*this" src="{{item}}" mode="aspectFit" class="cover-preview"/></view><view class="notice" wx:if="{{message}}">{{message}}</view><view class="edit-actions"><button class="primary" bindtap="save" disabled="{{busy}}" loading="{{busy}}">保存收藏</button></view></view>

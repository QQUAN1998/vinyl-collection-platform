:host{display:block;width:100%;min-width:0}.deck{display:flex;flex-direction:column;box-sizing:border-box;min-height:calc(100vh - 110px);padding:76px 0 0;color:#171a17}.deck-top{position:fixed;z-index:60;top:0;left:0;right:0;display:flex;align-items:center;justify-content:space-between;height:68px;padding:0 24px;box-sizing:border-box;background:#f5f6f2}.deck-greeting{font-size:28px;font-weight:700;line-height:1.25;letter-spacing:-1px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1;margin-right:20px}.deck-profile{flex:none;width:40px!important;min-width:40px!important;height:40px!important;min-height:40px!important;padding:0!important;margin:0!important;line-height:1;border-radius:50%;background:#edf0e8;overflow:hidden;display:flex;align-items:center;justify-content:center}.deck-profile::after{border:0}.deck-profile image{width:100%;height:100%}.deck-profile .profile-placeholder{width:24px;height:24px}.deck-summary{padding:0 24px;display:flex;flex-direction:column;gap:6px}.deck-count{font-size:13px;color:#747871}.deck-total{font-size:11px;line-height:1.5;color:#747871;overflow-wrap:anywhere}.deck-stage{width:100%;margin-top:auto;padding-top:22px}.deck-scroll{width:100%;height:calc(68vw + 52px);max-height:392px;white-space:nowrap}.gallery-track{display:inline-flex;align-items:center;height:100%;box-sizing:content-box;vertical-align:top}.gallery-slot{flex-shrink:0;display:flex;align-items:center;height:100%;white-space:normal}.deck-slide{position:relative;width:100%;transform-origin:50% 80%;will-change:transform;transition:opacity .22s}.deck-art{width:100%;aspect-ratio:1;position:relative;background:#edf0e8;box-sizing:border-box;box-shadow:0 15px 20px -12px #171a1766,2px 2px 0 #0003,3px 3px 0 #fff8;border:1px solid #ffffff7a;transition:border-radius .5s,background .5s;}.art-picture{width:100%;height:100%;overflow:hidden}.art-picture image{display:block;width:100%;height:100%}.sleeve-gloss{pointer-events:none;position:absolute;inset:0;box-shadow:inset 0 0 0 1px #ffffff8c,inset 2px 2px 6px #fff4,inset -3px -3px 8px #0003;background:linear-gradient(135deg,#ffffff36 0%,#ffffff05 27%,#fff0 47%,#ffffff20 49%,#ffffff05 55%,#00000008 100%)}.deck-slide.is-opening{animation:cover-rise .24s ease-in forwards}.is-disc .deck-art{border-radius:50%;background:repeating-radial-gradient(circle,transparent 0px,transparent 2px,#ffffff80 2.4px,#90979422 3px),linear-gradient(125deg,#e5e9e899,#fff7 30%,#a9b0ad66 46%,#fff9 65%,#c6cdc966);box-shadow:inset 0 0 0 1px #fff9,0 16px 22px -10px #0003}.is-disc .art-picture{position:absolute;width:38%;height:38%;left:31%;top:31%;border-radius:50%;box-shadow:0 0 0 1px #0002}.is-disc .sleeve-gloss{border-radius:50%;background:linear-gradient(135deg,#fff0 20%,#fff8 35%,#fff0 48%,#fff0 70%,#fff6 90%)}.disc-hole{position:absolute;left:calc(50% - 4px);top:calc(50% - 4px);width:8px;height:8px;border-radius:50%;background:#f5f6f2;box-shadow:0 0 0 1px #171a1722}.deck-placeholder{height:100%;box-sizing:border-box;padding:20px;display:flex;flex-direction:column;justify-content:space-between;background:#edf0e8;font-size:10px}.deck-placeholder-title{font-size:22px;font-weight:700;line-height:1.3;display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden}.deck-caption{padding:16px 32px 0;display:flex;align-items:center;text-align:center;flex-direction:column;gap:5px;min-height:96px;box-sizing:border-box}.deck-title{font-size:21px;font-weight:600;line-height:1.35;max-width:100%;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.deck-artist{font-size:12px;color:#747871;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.deck-sequence{font-size:10px;color:#747871;margin-top:12px;min-height:14px}.deck-pagination{margin-top:auto;padding:22px 16px 4px}.deck-ruler{position:relative;height:30px;overflow:hidden}.ruler-track{position:absolute;left:-24px;right:-24px;top:9px;height:12px;background-image:repeating-linear-gradient(90deg,#d8dcd4 0px,#d8dcd4 2px,transparent 2px,transparent 12px);will-change:background-position}.ruler-needle{position:absolute;top:0;bottom:0;left:calc(50% - 1px);width:2px;background:#171a17;box-shadow:0 0 0 4px #f5f6f2}.deck-position{display:block;text-align:center;font-size:10px;font-variant-numeric:tabular-nums;color:#747871;margin-top:8px}.deck-empty{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:24px;padding:64px 24px}.deck-empty>image{width:100px;height:100px;opacity:.25}.deck-empty button{font-size:12px;background:#d1ff66;border-radius:22px;padding:12px 20px}.deck-empty button::after{border:0}.live-deck .deck-scroll{height:clamp(220px,calc(100vh - 385px),400px);max-height:none}.ticket-art{height:clamp(190px,calc(100vh - 415px),370px);aspect-ratio:auto;padding:12px 12px 0;border:0;box-shadow:0 14px 23px -12px #171a1760}.ticket-art .art-picture{height:calc(100% - 37px);background:#0000000a}.ticket-footer{display:flex;align-items:center;justify-content:space-between;gap:8px;height:37px;color:#fff;font-size:10px;line-height:1.3;padding:0 3px;overflow:hidden}.ticket-footer text:first-child{flex-shrink:0}.ticket-footer text:last-child{max-width:70%;text-overflow:ellipsis;white-space:nowrap;overflow:hidden}.ticket-art::before,.ticket-art::after{content:'';position:absolute;top:0;bottom:0;width:7px;pointer-events:none}.ticket-art::before{left:0;background:radial-gradient(circle at 0 6px,#f5f6f2 3px,transparent 3.5px) 0 0/7px 12px repeat-y}.ticket-art::after{right:0;background:radial-gradient(circle at 7px 6px,#f5f6f2 3px,transparent 3.5px) 0 0/7px 12px repeat-y}
@keyframes cover-rise{to{transform:translateY(-45px) scale(.96);opacity:.08}}
.live-deck .deck-scroll{height:clamp(220px,calc(100vh - 440px),345px)}.live-deck .ticket-art{height:clamp(190px,calc(100vh - 470px),315px)}.live-deck .deck-caption{padding:8px 24px 0;min-height:96px}.live-deck .deck-title{font-size:18px}.live-deck .deck-sequence{margin-top:5px}.live-deck .deck-pagination{padding-top:8px}
@media(max-height:660px){.deck{padding-top:68px}.deck-top{height:60px}.deck-greeting{font-size:25px}.deck-stage{padding-top:12px}.deck-caption{padding-top:8px;min-height:80px}.deck-pagination{padding-top:12px}.live-deck .deck-scroll{height:220px}.ticket-art{height:190px}}

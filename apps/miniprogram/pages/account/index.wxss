.account-screen {
  display: flex;
  flex-direction: column;
}

.profile {
  display: grid;
  gap: 54rpx;
}

.profile-card {
  box-sizing: border-box;
  display: grid;
  gap: 24rpx;
  padding: 34rpx;
  overflow: hidden;
  border-radius: var(--radius-card);
  background: var(--theme-profile-card-bg);
  color: var(--theme-profile-card-text);
}

.profile-edit-card {
  grid-template-columns: 108rpx minmax(0, 1fr) minmax(116rpx, auto);
  align-items: center;
}

.profile-sync-card {
  grid-template-columns: 108rpx minmax(0, 1fr);
  column-gap: 22rpx;
  row-gap: 22rpx;
}

.profile-sync-card .profile-card-copy {
  min-width: 0;
  overflow: hidden;
}

.profile-card-hover {
  opacity: 0.92;
}

.profile-identity {
  position: relative;
  width: 96rpx;
}

.profile-avatar-button {
  height: 108rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  line-height: 1;
}

.profile-avatar-button::after,
.profile-action-button::after {
  border: 0;
}

.profile-avatar {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 50%;
  background: var(--color-mustard);
  color: var(--color-ink);
  font-size: 36rpx;
  font-weight: 950;
}

.profile-tier-badge {
  min-width: 66rpx;
  height: 34rpx;
  position: absolute;
  left: 50%;
  bottom: -12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  color: var(--theme-profile-card-muted);
  font-size: 18rpx;
  font-weight: 950;
  transform: translateX(-50%);
}

.profile-card-copy {
  min-width: 0;
  display: grid;
  gap: 10rpx;
}

.profile-user-title {
  overflow: hidden;
  color: var(--theme-profile-card-text);
  font-size: 38rpx;
  font-weight: 950;
  line-height: 1.14;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-name-input {
  width: 100%;
  min-height: 48rpx;
  padding: 0;
  overflow: hidden;
  color: var(--theme-profile-card-text);
  font-size: 34rpx;
  font-weight: 950;
  line-height: 1.14;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-name-input::placeholder {
  color: var(--theme-profile-card-muted);
}

.profile-collection-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  color: var(--theme-profile-card-muted);
  font-size: 27rpx;
  font-weight: 850;
}

.profile-normal-limit {
  max-width: 100%;
  overflow: hidden;
  color: var(--theme-profile-card-faint);
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.34;
  word-break: break-all;
}

.profile-action-text,
.tool-arrow {
  color: var(--color-action);
  font-size: 24rpx;
  font-weight: 950;
  text-align: right;
}

.profile-action-button {
  min-height: 64rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 0 18rpx;
  border: 0;
  border-radius: 999rpx;
  background: var(--color-paper);
  color: var(--color-action);
  font-size: 22rpx;
  font-weight: 950;
  line-height: 64rpx;
}

.profile-sync-card .profile-action-button {
  width: 100%;
  grid-column: 1 / -1;
  min-height: 68rpx;
  justify-self: stretch;
  line-height: 68rpx;
}

.account-section {
  display: grid;
  gap: 32rpx;
}

.head-row {
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.account-section-head .section-title {
  margin-bottom: 0;
  font-size: 38rpx;
}

.device-row {
  min-height: 150rpx;
  display: grid;
  grid-template-columns: 96rpx minmax(0, 1fr) auto;
  gap: 24rpx;
  align-items: center;
  padding: 24rpx;
  border: 1rpx solid var(--theme-panel-border);
  border-radius: var(--radius-card);
  background: var(--theme-panel-tint);
}

.device-icon {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-card);
  background: var(--theme-input-surface);
}

.device-symbol {
  width: 48rpx;
  height: 48rpx;
}

.device-copy,
.tool-copy {
  min-width: 0;
}

.device-name,
.tool-title {
  overflow: hidden;
  color: var(--color-ink);
  font-size: 30rpx;
  font-weight: 950;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-meta {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 23rpx;
  font-weight: 750;
  line-height: 1.35;
}

.state-pill {
  min-height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(101, 118, 77, 0.14);
  color: var(--color-action);
  font-size: 23rpx;
  font-weight: 950;
}

.auth-row {
  min-height: 132rpx;
  display: grid;
  grid-template-columns: 76rpx minmax(0, 1fr) auto;
  gap: 22rpx;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--color-line);
}

.auth-icon {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--palette-green-soft);
  color: var(--color-action);
  font-size: 25rpx;
  font-weight: 950;
}

.auth-copy {
  min-width: 0;
}

.auth-title {
  overflow: hidden;
  color: var(--color-ink);
  font-size: 30rpx;
  font-weight: 950;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.auth-action-button {
  min-width: 172rpx;
  min-height: 72rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 0 22rpx;
  border: 0;
  line-height: 72rpx;
}

.auth-action-button::after {
  border: 0;
}

.auth-state-badge {
  min-height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(101, 118, 77, 0.12);
  color: var(--color-action);
  font-size: 23rpx;
  font-weight: 950;
}

.device-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 18rpx;
}

.device-actions-with-exit .sync-exit-button {
  grid-column: 1 / -1;
  border-color: rgba(139, 79, 61, 0.26);
  color: #8b4f3d;
}

.sync-button {
  min-height: 88rpx;
  margin-bottom: 8rpx;
}

.tool-row {
  min-height: 158rpx;
  display: grid;
  grid-template-columns: 72rpx minmax(0, 1fr) auto;
  gap: 22rpx;
  align-items: center;
  border-bottom: 1rpx solid var(--color-line);
  background: transparent;
}

.tool-row-hover {
  background: var(--theme-nav-hover);
}

.tool-icon {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-card);
  background: var(--palette-green-soft);
  color: var(--color-action);
}

.tool-symbol {
  width: 38rpx;
  height: 38rpx;
}

.theme-tool-symbol {
  width: 42rpx;
  height: 42rpx;
}

.onboarding-backdrop {
  position: fixed;
  z-index: 30;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  padding: 28rpx;
  background: rgba(26, 26, 26, 0.52);
}

.onboarding-panel {
  width: 100%;
  max-height: 86vh;
  overflow-y: auto;
  padding: 34rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-card);
  background: var(--theme-card-surface);
}

.onboarding-kicker {
  color: var(--color-action);
  font-size: 22rpx;
  font-weight: 950;
  letter-spacing: 0;
}

.onboarding-title {
  margin-top: 8rpx;
  color: var(--color-ink);
  font-size: 40rpx;
  font-weight: 950;
  line-height: 1.14;
}

.onboarding-copy {
  margin-top: 12rpx;
  color: var(--color-muted);
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.48;
}

.onboarding-step-list {
  display: grid;
  gap: 18rpx;
  margin-top: 30rpx;
}

.onboarding-step {
  display: grid;
  grid-template-columns: 54rpx 1fr;
  gap: 18rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-line);
}

.onboarding-step-index {
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--palette-green-soft);
  color: var(--color-action);
  font-size: 23rpx;
  font-weight: 950;
}

.onboarding-step-copy {
  min-width: 0;
}

.onboarding-step-title {
  color: var(--color-ink);
  font-size: 28rpx;
  font-weight: 950;
  line-height: 1.2;
}

.onboarding-step-desc {
  margin-top: 6rpx;
  color: var(--color-muted);
  font-size: 23rpx;
  font-weight: 780;
  line-height: 1.42;
}

.onboarding-actions {
  display: grid;
  grid-template-columns: 180rpx 1fr;
  gap: 18rpx;
  margin-top: 30rpx;
}

.onboarding-ghost,
.onboarding-primary {
  min-height: 88rpx;
}


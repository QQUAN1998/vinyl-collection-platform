<view class="chart-wrap" aria-label="{{label}}"><view wx:if="{{visible}}" class="ring-plot"><view class="ring-track" style="border-color:{{trackColor}}"/><view wx:for="{{segments}}" wx:key="id" class="ring-piece" style="transform:rotate({{item.start}}deg)"><view class="ring-window"><view class="ring-half" style="transform:rotate({{item.sweep}}deg)"><view class="ring-ink" style="border-color:{{item.color}}"/></view></view></view></view><view class="ring-total" style="color:{{uiThemeClass==='theme-dark'?'#f2f3ed':'#171a17'}}"><text>{{total}}</text><text>{{label}}</text></view></view>

.results-screen {
  padding-bottom: calc(220rpx + var(--safe-bottom));
}

.result-query {
  min-height: 82rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 36rpx;
  padding: 0 24rpx;
  border-radius: var(--radius-card);
  background: var(--color-soft);
  color: var(--color-ink);
  font-size: 28rpx;
  font-weight: 800;
}

.result-list {
  display: grid;
  gap: 18rpx;
}

.result-notice {
  margin: -18rpx 0 28rpx;
  padding: 18rpx 22rpx;
  border-radius: var(--radius-cover);
  background: rgba(185, 109, 91, 0.12);
  color: var(--color-ink);
  font-size: 24rpx;
  font-weight: 700;
}

.result-notice.is-warning {
  background: rgba(211, 179, 106, 0.18);
}

.result-notice.is-muted {
  background: rgba(99, 116, 77, 0.12);
}

.load-more-panel {
  display: grid;
  gap: 14rpx;
  justify-items: center;
  margin: 34rpx 0 8rpx;
}

.load-more-button {
  min-height: 76rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 300rpx;
  padding: 0 34rpx;
  border: 2rpx solid var(--color-action);
  border-radius: var(--radius-card);
  background: var(--theme-input-surface);
  color: var(--color-action);
  font-size: 26rpx;
  font-weight: 900;
}

.load-more-button.is-loading,
.load-more-button.is-done {
  border-color: rgba(99, 116, 77, 0.22);
  background: var(--color-soft);
  color: var(--color-muted);
}

.load-more-hover {
  opacity: 0.72;
}

.load-more-meta {
  color: var(--color-muted);
  font-size: 22rpx;
  font-weight: 700;
}

.floating-action {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + var(--safe-bottom));
  min-height: 104rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  border-radius: var(--radius-card);
  background: var(--color-ink);
  color: var(--theme-card-surface);
  box-shadow: 0 18rpx 44rpx rgba(17, 20, 24, 0.24);
}

.selected-count,
.next-action {
  font-size: 28rpx;
  font-weight: 900;
}

.next-action {
  min-height: 72rpx;
  display: flex;
  align-items: center;
  padding-left: 28rpx;
}

.next-action-hover {
  opacity: 0.72;
}

.next-action.is-loading {
  opacity: 0.64;
}

@import "../../ui/pages.wxss";
@import "../../ui/exact-pages.wxss";
/* Unified screenshot refinement */
@import "../../ui/deep-pages.wxss";

<wxs module="i18n" src="../../ui/locale.wxs"/><page-meta root-background-color="#f5f6f2" background-color="#f5f6f2" background-color-top="#f5f6f2" background-color-bottom="#f5f6f2" page-style="background:#f5f6f2;min-height:100vh;"/>
<view class="{{uiThemeClass}} screen tv-download-screen {{themeClass}}" style="padding-top:{{uiChromeHeight}}px!important;{{themeStyle}};{{uiThemeStyle}}">
  <view class="screen-header">
    <view class="screen-title">{{i18n.t('电视版 APK',uiLanguage)}}</view>
    <view class="screen-kicker">TV APP</view>
  </view>

  <view class="apk-status-row">
    <view class="apk-status-icon">
      <image class="apk-status-symbol" src="/assets/icons/tv-action.png" mode="aspectFit" />
    </view>
    <view class="apk-status-copy">
      <view class="apk-status-title">{{i18n.t('唱片柜电视版',uiLanguage)}}</view>
      <view class="apk-status-meta">{{fileName}} · {{fileSize}}</view>
    </view>
    <view class="apk-status-badge">ZIP</view>
  </view>

  <view class="guide-section">
    <view class="section-title">{{i18n.t('安装指引',uiLanguage)}}</view>
    <view class="guide-list">
      <view class="guide-step">
        <view class="guide-step-index">1</view>
        <view class="guide-step-copy">
          <view class="guide-step-title">{{i18n.t('下载并分享',uiLanguage)}}</view>
          <view class="guide-step-desc">{{i18n.t('点击下方按钮，下载完成后把 ZIP 压缩包分享给微信好友或文件传输助手。',uiLanguage)}}</view>
        </view>
      </view>
      <view class="guide-step">
        <view class="guide-step-index">2</view>
        <view class="guide-step-copy">
          <view class="guide-step-title">{{i18n.t('保存到电脑桌面',uiLanguage)}}</view>
          <view class="guide-step-desc">{{i18n.t('在电脑微信中下载文件，确认收到的是唱片柜-TV.zip，并保存到桌面。',uiLanguage)}}</view>
        </view>
      </view>
      <view class="guide-step">
        <view class="guide-step-index">3</view>
        <view class="guide-step-copy">
          <view class="guide-step-title">{{i18n.t('解压安装文件夹',uiLanguage)}}</view>
          <view class="guide-step-desc">{{i18n.t('解压 ZIP 后会得到“唱片柜-TV”文件夹。打开文件夹，确认里面的文件以 .apk 结尾，不能是 .apk(1)。',uiLanguage)}}</view>
        </view>
      </view>
      <view class="guide-step">
        <view class="guide-step-index">4</view>
        <view class="guide-step-copy">
          <view class="guide-step-title">{{i18n.t('复制到 U 盘',uiLanguage)}}</view>
          <view class="guide-step-desc">{{i18n.t('把解压得到的整个“唱片柜-TV”文件夹复制到 U 盘，不要只复制压缩包。',uiLanguage)}}</view>
        </view>
      </view>
      <view class="guide-step">
        <view class="guide-step-index">5</view>
        <view class="guide-step-copy">
          <view class="guide-step-title">{{i18n.t('通过 U 盘安装',uiLanguage)}}</view>
          <view class="guide-step-desc">{{i18n.t('把 U 盘插入电视，打开文件管理器进入“唱片柜-TV”文件夹，按提示允许安装未知来源应用并完成安装。',uiLanguage)}}</view>
        </view>
      </view>
      <view class="guide-step">
        <view class="guide-step-index">6</view>
        <view class="guide-step-copy">
          <view class="guide-step-title">{{i18n.t('扫码同步收藏',uiLanguage)}}</view>
          <view class="guide-step-desc">{{i18n.t('打开电视端“唱片柜”，显示登录二维码后，用小程序“我的”页面扫码绑定电视，即可同步当前收藏。',uiLanguage)}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="download-section">
    <view class="section-title">{{i18n.t('下载安装包',uiLanguage)}}</view>
    <view class="download-panel">
      <view class="download-panel-kicker">LATEST</view>
      <view class="download-panel-title">{{i18n.t('唱片柜电视版安装包',uiLanguage)}}</view>
      <view class="download-panel-meta">{{i18n.t('ZIP 内已整理好“唱片柜-TV”文件夹，下载后会直接打开微信文件分享。',uiLanguage)}}</view>
      <button
        class="primary-button download-button"
        loading="{{downloading}}"
        disabled="{{downloading}}"
        bindtap="handleDownloadShare"
        hover-class="button-hover"
      >{{downloading ? (downloadProgress ? '下载 ' + downloadProgress + '%' : i18n.t('准备下载',uiLanguage)) : i18n.t('下载并分享 ZIP',uiLanguage)}}</button>
      <view wx:if="{{downloadError}}" class="download-error">{{downloadError}}</view>
    </view>
    <view class="download-note">{{i18n.t('请先在电脑解压 ZIP，再把整个文件夹复制到 U 盘。安装完成后可继续保存在 U 盘中备用。',uiLanguage)}}</view>
  </view>
</view>
<button class="{{uiThemeClass}} ui-form-back" style="{{uiThemeStyle}}" bindtap="uiPageBack" aria-label="{{i18n.t('返回',uiLanguage)}}"><image src="/assets/ui/back.svg"/></button>
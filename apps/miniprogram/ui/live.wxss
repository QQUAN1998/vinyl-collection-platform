/* Native live presentation. Existing routes and record handlers remain unchanged. */
page{--ink:var(--color-ink);--muted:var(--color-muted);--line:var(--color-line);--soft:var(--color-soft);--paper:var(--color-screen);--action:var(--color-ink);background:var(--paper);color:var(--ink);font-size:13px;line-height:1.5}
.page{padding:16px 20px 124px}.page .title{font-size:30px;font-weight:750;line-height:1.25;letter-spacing:-1px}.page .section{margin-top:20px}.page .section-title{font-size:17px;font-weight:700;line-height:1.35;margin-bottom:16px}.page .muted,.page .tiny{font-size:11px;color:var(--color-muted)}.page .primary{background:var(--color-ink);color:var(--theme-card-surface)}.page button,.page .select,.page .search,.page input,.page textarea{border-radius:18px;font-size:13px}.page input,.page .search,.page .select{min-height:44px;border:1px solid var(--color-line);background:var(--theme-card-surface);box-sizing:border-box}.page .outline{border:1px solid var(--color-line);background:var(--theme-card-surface);color:var(--color-ink)}.page .field{margin-bottom:20px;min-width:0}.page .label{font-size:11px;font-weight:500;color:var(--color-muted);margin-bottom:8px}.page .row{gap:12px;align-items:center}.page .row .half{align-self:stretch}.page .field-input{height:44px;padding:0 14px}.page .select{display:flex;align-items:center;padding:12px 14px;line-height:20px}.page .surface{padding:20px;border-radius:18px;background:var(--theme-card-surface);border:0}.page .link{font-size:11px;font-weight:500}.page .poster-grid{gap:24px 12px}.page .poster{border-radius:18px;aspect-ratio:3/4;height:auto;min-height:0}.page .poster image{width:100%;height:100%}.page .card-name{font-size:12px;font-weight:650;margin-top:10px}.page .card-meta{font-size:10px}.page .filter-row{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0 20px}.page .filter-row ui-select{flex:1;min-width:0;font-size:10px;padding:8px;background:var(--color-soft);border-radius:18px}.page .catalog{margin-top:24px}.page .search{font-size:12px;padding:12px}.page .collection-block,.page .ui-live-recent{display:none}.page .record-card{min-width:0}.page .poster-name{font-size:15px;line-height:1.3}.page .poster-label,.page .poster .tiny{font-size:8px}.page .notice{padding:14px;background:var(--theme-card-surface);border:1px solid var(--color-line);border-radius:18px;color:#735244;font-size:12px}.page .cover-preview{border-radius:18px}.page .detail-toolbar{display:grid;grid-template-columns:1fr;gap:12px;margin-top:20px}.page .detail-toolbar .pill{display:none}.page .detail-edit{margin:0;min-height:44px;padding:12px}.page .detail-section{background:var(--theme-card-surface);border:0;padding:20px;border-radius:18px;margin-top:20px}.page .detail-section .media-grid image{border-radius:18px;height:calc((100vw - 104px)/3)}.page .detail-section .row.section-title{gap:12px}.page .source-action{margin-top:20px}.page .danger{font-size:12px}.overlay .sheet{background:var(--theme-card-surface);border-radius:18px;padding:20px;max-height:85vh;overflow-y:auto}.overlay textarea,.overlay input{border-radius:18px;background:var(--color-screen);border:1px solid var(--color-line);font-size:13px}.overlay .primary{background:var(--color-ink);color:var(--theme-card-surface);border-radius:18px}
.bottom-nav{left:16px;right:16px;bottom:calc(12px + env(safe-area-inset-bottom));padding:5px;border:1px solid var(--color-line);border-radius:18px;background:var(--theme-card-surface);box-shadow:none;gap:5px}.bottom-nav button.nav-item{min-height:55px;border-radius:18px;font-size:10px;font-weight:600;gap:4px;color:var(--color-muted);margin:0}.bottom-nav .nav-item.active{background:#d1ff66;color:var(--color-ink)}.bottom-nav .nav-icon{width:22px;height:22px;opacity:.6}.bottom-nav .active .nav-icon{opacity:1}
.ui-form-back{display:inline-flex;width:auto!important;margin:0 0 20px!important;padding:0;min-height:24px;background:none;border:0;font-size:11px;line-height:24px;color:var(--color-muted)}.ui-form-back::after{border:0}.ui-form-kicker{font-size:10px;letter-spacing:2px;color:var(--color-muted);margin:0 0 8px}.page .account-card{display:flex;align-items:center;gap:12px;padding:20px;margin:0;width:100%;border:0;border-radius:18px;background:var(--theme-card-surface);text-align:left;line-height:1.5}.page .account-avatar{width:44px;height:44px;line-height:44px;background:#d1ff66;color:var(--color-ink);flex:none}.page .account-name{font-size:23px;font-weight:750}.page .account-caption{font-size:11px}.page .account-copy{flex:1;min-width:0}.page .mine-menu{border:0;border-radius:18px;background:var(--theme-card-surface);padding:0 20px}.page .menu{padding:16px 0;margin:0;min-height:60px;font-size:13px;border-radius:0}.page .archive-summary{background:var(--color-ink);border-radius:18px;padding:20px}.page .archive-summary .title{font-size:23px;color:var(--theme-card-surface);margin:12px 0}.page .archive-summary .muted{font-size:10px;color:#c8cdc4}.page .archive-summary .numbers text{font-size:28px;color:#d1ff66}.page .archive-summary .numbers view view{font-size:11px;color:#c8cdc4}
@media(max-width:350px){.page{padding-left:16px;padding-right:16px}.page .poster-grid{gap:20px 8px}.page .account-name{font-size:21px}.page .title{font-size:28px}}

.page .poster,.page .cover-preview{padding:0;background:transparent!important;border:0;box-shadow:none;border-radius:0;overflow:visible}.page .poster::before,.page .poster::after{display:none}.page .poster image,.page .cover-preview{filter:drop-shadow(0 10px 10px #171a1730)}.page .cover-preview{height:auto!important;max-width:150px;margin:12px 0}.page .hero .poster{padding:0;background:transparent!important;border-radius:0;box-shadow:none}.page .title,.page .card-name,.page .detail-artist{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:block}.page .hero .title{font-size:30px}.page.home-gallery{padding-top:0!important}

<wxs module="i18n" src="../../ui/locale.wxs"/><page-meta root-background-color="#f5f6f2" background-color="#f5f6f2" background-color-top="#f5f6f2" background-color-bottom="#f5f6f2" page-style="background:#f5f6f2;min-height:100vh;"/>
<view class="{{uiThemeClass}} screen manual-add-screen {{themeClass}}" style="padding-top:{{uiChromeHeight}}px!important;{{themeStyle}};{{uiThemeStyle}}">
  
  <button class="ui-form-back" bindtap="cancelManualAdd"><image src="/assets/ui/back.svg"/>{{i18n.t('返回',uiLanguage)}}</button><view class="screen-header">
    <view class="screen-title">{{i18n.t('新建唱片',uiLanguage)}}</view>
    
  </view>
<view class="ui-form-card">

  <view class="cover-card" bindtap="chooseAlbumCover" hover-class="button-hover">
    <image wx:if="{{cover}}" class="manual-cover" src="{{cover}}" mode="aspectFill" />
    <view wx:else class="manual-cover-placeholder">+</view>
    <view class="cover-copy">
      <view class="cover-title">{{i18n.t('添加封面',uiLanguage)}}</view>
      <view class="cover-desc">{{i18n.t('从相册或相机选择唱片封面',uiLanguage)}}</view>
    </view>
  </view>

  <view class="section">
    
    <view class="manual-form">
      <form-field class="ui-form-full" label="专辑名" placeholder="例如：浪人情歌" value="{{manualForm.title}}" data-key="title" bind:change="handleFieldChange" />
      <form-field class="ui-form-full" label="艺人" placeholder="例如：伍佰 & China Blue" value="{{manualForm.artist}}" data-key="artist" bind:change="handleFieldChange" />
      <form-field label="发行日期" placeholder="YYYY-MM-DD" value="{{manualForm.releaseDate}}" data-key="releaseDate" bind:change="handleFieldChange" />
      <form-field label="风格" placeholder="{{i18n.t('华语流行',uiLanguage)}}" value="{{manualForm.style}}" data-key="style" bind:change="handleFieldChange" />
    </view>
  </view>

  <view class="section">
    
    <view class="manual-form">
      <form-field label="收藏日期" value="{{manualForm.collectionDate}}" data-key="collectionDate" bind:change="handleFieldChange" />
      <form-field label="购买来源" value="{{manualForm.source}}" data-key="source" bind:change="handleFieldChange" />
      <form-field label="数量" type="number" value="{{manualForm.quantity}}" data-key="quantity" bind:change="handleFieldChange" />
      <form-field label="品相" value="{{manualForm.condition}}" data-key="condition" bind:change="handleFieldChange" />
      <media-format-selector
        options="{{mediaFormats}}"
        selected-key="{{manualForm.mediumKey}}"
        bind:change="handleMediumChange"
      />
      <form-field label="价格" type="number" placeholder="{{i18n.t('可稍后补充',uiLanguage)}}" value="{{manualForm.price}}" data-key="price" bind:change="handleFieldChange" />
      <form-field class="ui-form-full" label="备注" mode="textarea" placeholder="{{i18n.t('版本、来源或特殊说明',uiLanguage)}}" value="{{manualForm.notes}}" data-key="notes" bind:change="handleFieldChange" />
    </view>
  </view>

  <view class="manual-actions">
    <view class="ghost-button" bindtap="cancelManualAdd" hover-class="button-hover">{{i18n.t('取消',uiLanguage)}}</view>
    <view class="primary-button" bindtap="saveManualAlbum" hover-class="button-hover">{{i18n.t('保存唱片',uiLanguage)}}</view>
  </view>
</view>
</view>

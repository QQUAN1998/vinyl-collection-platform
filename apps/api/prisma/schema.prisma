// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum MembershipPlan {
  MONTHLY
  YEARLY
  FOUNDING
  MANUAL
}

enum MembershipOrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CLOSED
}

enum AlbumRarity {
  N
  R
  SR
  SSR
  UR
}

enum AlbumSource {
  CATALOG
  USER_CREATED
}

enum TvDeviceStatus {
  BOUND
  UNBOUND
  DISABLED
}

enum SyncEventType {
  BOUND
  UNBOUND
  SYNC_STARTED
  SYNC_COMPLETED
  SYNC_FAILED
}

enum AuditActorType {
  USER
  SYSTEM
  OPERATOR
}

model User {
  id                   String            @id @default(cuid())
  wechatOpenId         String            @unique @map("wechat_open_id") @db.VarChar(128)
  displayName          String            @map("display_name") @db.VarChar(64)
  avatarUrl            String?           @map("avatar_url") @db.Text
  registrationSequence Int               @unique @default(autoincrement()) @map("registration_sequence")
  createdAt            DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.DateTime(3)
  memberships          Membership[]
  membershipOrders     MembershipOrder[]
  createdAlbums        Album[]           @relation("AlbumCreator")
  collections          Collection[]
  tvDevices            TvDevice[]
  syncEvents           SyncEvent[]
  auditLogs            AuditLog[]

  @@map("users")
}

model Membership {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  orderId   String?          @unique @map("order_id")
  plan      MembershipPlan
  startsAt  DateTime         @map("starts_at") @db.DateTime(3)
  expiresAt DateTime         @map("expires_at") @db.DateTime(3)
  revokedAt DateTime?        @map("revoked_at") @db.DateTime(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     MembershipOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt])
  @@map("memberships")
}

model MembershipOrder {
  id                  String                @id @default(cuid())
  userId              String                @map("user_id")
  merchantOrderNumber String                @unique @map("merchant_order_number") @db.VarChar(64)
  wechatTransactionId String?               @unique @map("wechat_transaction_id") @db.VarChar(64)
  plan                MembershipPlan
  amountCents         Int                   @map("amount_cents")
  status              MembershipOrderStatus @default(PENDING)
  paidAt              DateTime?             @map("paid_at") @db.DateTime(3)
  createdAt           DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.DateTime(3)
  user                User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  membership          Membership?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("membership_orders")
}

model Album {
  id          String       @id @default(cuid())
  title       String       @db.VarChar(200)
  artist      String       @db.VarChar(160)
  releaseYear Int?         @map("release_year")
  genre       String?      @db.VarChar(80)
  coverUrl    String?      @map("cover_url") @db.Text
  rarity      AlbumRarity  @default(N)
  source      AlbumSource  @default(CATALOG)
  createdById String?      @map("created_by")
  createdAt   DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy   User?        @relation("AlbumCreator", fields: [createdById], references: [id], onDelete: SetNull)
  tracks      AlbumTrack[]
  collections Collection[]

  @@index([artist, releaseYear])
  @@index([title])
  @@index([genre])
  @@map("albums")
}

model AlbumTrack {
  id       String @id @default(cuid())
  albumId  String @map("album_id")
  position Int
  title    String @db.VarChar(200)
  album    Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@unique([albumId, position])
  @@map("album_tracks")
}

model Collection {
  id                 String   @id @default(cuid())
  userId             String   @map("user_id")
  albumId            String   @map("album_id")
  purchasePriceCents Int?     @map("purchase_price_cents")
  collectedAt        DateTime @map("collected_at") @db.DateTime(3)
  source             String?  @db.VarChar(80)
  quantity           Int      @default(1)
  condition          String?  @db.VarChar(32)
  mediumKey          String?  @map("medium_key") @db.VarChar(32)
  note               String?  @db.Text
  createdAt          DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  album              Album    @relation(fields: [albumId], references: [id], onDelete: Restrict)

  @@unique([userId, albumId])
  @@index([userId, collectedAt])
  @@map("collections")
}

model TvDevice {
  id            String         @id @default(cuid())
  userId        String         @map("user_id")
  name          String         @db.VarChar(80)
  deviceKeyHash String         @unique @map("device_key_hash") @db.VarChar(128)
  status        TvDeviceStatus @default(BOUND)
  lastSyncedAt  DateTime?      @map("last_synced_at") @db.DateTime(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.DateTime(3)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncEvents    SyncEvent[]

  @@index([userId, status])
  @@map("tv_devices")
}

model SyncEvent {
  id         String        @id @default(cuid())
  userId     String        @map("user_id")
  tvDeviceId String?       @map("tv_device_id")
  type       SyncEventType
  payload    Json?
  createdAt  DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tvDevice   TvDevice?     @relation(fields: [tvDeviceId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([tvDeviceId, createdAt])
  @@map("sync_events")
}

model AuditLog {
  id        String         @id @default(cuid())
  userId    String?        @map("user_id")
  actorType AuditActorType @map("actor_type")
  actorId   String?        @map("actor_id") @db.VarChar(128)
  action    String         @db.VarChar(100)
  reason    String?        @db.VarChar(500)
  metadata  Json?
  createdAt DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

page {
  --color-ink: #1a1a1a;
  --color-muted: #686a63;
  --color-faint: #9a9b94;
  --color-line: #d8d5cc;
  --color-soft: #efede6;
  --color-paper: #fbfaf6;
  --color-screen: #e7e4dc;
  --color-action: #65764d;
  --color-select: #65764d;
  --color-sync: #65764d;
  --color-warning: #9a7520;
  --color-mustard: #e7d37c;
  --color-clay: #b96d5b;
  --color-sky: #c9dcdd;
  --palette-green-soft: #dfe8d3;
  --palette-yellow-soft: #f1e8c3;
  --palette-red: #b96d5b;
  --palette-red-strong: #b62d2b;
  --palette-red-soft: #ead0ca;
  --palette-black: #1a1a1a;
  --theme-nav-surface: rgba(239, 237, 230, 0.96);
  --theme-nav-border: rgba(216, 213, 204, 0.9);
  --theme-nav-muted: #898b84;
  --theme-nav-hover: rgba(255, 255, 255, 0.72);
  --theme-panel-tint: rgba(101, 118, 77, 0.07);
  --theme-panel-border: rgba(101, 118, 77, 0.1);
  --theme-card-surface: rgba(255, 255, 255, 0.88);
  --theme-input-surface: #ffffff;
  --theme-primary-button-bg: #1a1a1a;
  --theme-primary-button-text: #ffffff;
  --theme-profile-card-bg: #1a1a1a;
  --theme-profile-card-text: #ffffff;
  --theme-profile-card-muted: #e5ece5;
  --theme-profile-card-faint: #d7dee6;
  --theme-icon-filter: none;
  --radius-card: 32rpx;
  --radius-panel: 32rpx;
  --radius-cover: 12rpx;
  --shadow-cover: 0 18rpx 46rpx rgba(17, 20, 24, 0.16);
  --shadow-panel: 0 16rpx 40rpx rgba(17, 20, 24, 0.08);
  --safe-bottom: env(safe-area-inset-bottom);
  min-height: 100vh;
  background: var(--color-screen);
  color: var(--color-ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.icon-mask {
  display: block;
  flex: none;
  background: currentColor;
  -webkit-mask-position: center;
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-size: contain;
  mask-position: center;
  mask-repeat: no-repeat;
  mask-size: contain;
}

.icon-records {
  -webkit-mask-image: url("/assets/icons/records.svg");
  mask-image: url("/assets/icons/records.svg");
}

.icon-search {
  -webkit-mask-image: url("/assets/icons/search.svg");
  mask-image: url("/assets/icons/search.svg");
}

.icon-chart {
  -webkit-mask-image: url("/assets/icons/chart.svg");
  mask-image: url("/assets/icons/chart.svg");
}

.icon-user {
  -webkit-mask-image: url("/assets/icons/user.svg");
  mask-image: url("/assets/icons/user.svg");
}

.icon-add {
  -webkit-mask-image: url("/assets/icons/add.svg");
  mask-image: url("/assets/icons/add.svg");
}

.icon-close {
  -webkit-mask-image: url("/assets/icons/close.svg");
  mask-image: url("/assets/icons/close.svg");
}

.icon-star {
  -webkit-mask-image: url("/assets/icons/star.svg");

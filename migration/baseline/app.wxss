.screen {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 34rpx 32rpx calc(190rpx + var(--safe-bottom));
  background: var(--color-paper);
}

.screen-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 32rpx;
  padding-bottom: 22rpx;
  border-bottom: 2rpx solid var(--color-line);
}

.screen-title {
  margin: 0;
  color: var(--color-ink);
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.08;
}

.screen-kicker {
  color: var(--color-action);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  line-height: 1.2;
}

.section {
  margin-top: 58rpx;
}

.section-title {
  margin: 0 0 30rpx;
  color: var(--color-ink);
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.15;
}

.muted {
  color: var(--color-muted);
}

.caption {
  color: var(--color-muted);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.4;
}

.divider {
  height: 1rpx;
  margin: 54rpx 0;
  background: var(--color-line);
}

.primary-button {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-card);
  background: var(--theme-primary-button-bg);
  color: var(--theme-primary-button-text);
  font-size: 30rpx;
  font-weight: 900;
}

.primary-button.button-hover {
  background: var(--color-action);
}

.secondary-button {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-card);
  background: var(--color-soft);
  color: var(--color-ink);
  font-size: 28rpx;
  font-weight: 900;
}

.ghost-button {
  min-height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-card);
  background: var(--color-paper);
  color: var(--color-ink);
  font-size: 27rpx;
  font-weight: 900;
}

.card {
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-card);
  background: var(--color-paper);
}

.panel {
  padding: 24rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-panel);
  background: var(--color-paper);
  box-shadow: none;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.chip {
  min-height: 58rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 24rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-card);
  background: transparent;
  color: var(--color-muted);
  font-size: 23rpx;
  font-weight: 900;
}

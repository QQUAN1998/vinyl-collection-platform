:host{display:block;width:100%;min-width:0}.date-control{width:100%}.date-control .date-trigger{width:100%!important;min-height:44px;margin:0!important;padding:12px 14px;border:1px solid #e3e7de;border-radius:18px;background:#fff;display:flex;align-items:center;justify-content:space-between;gap:12px;text-align:left;font-size:13px;font-weight:400;line-height:1.5;color:#171a17;box-sizing:border-box}.date-trigger::after,.icon-button::after,.date-day::after,.date-clear::after,.date-today::after{border:0}.date-control .muted{color:#687063}.date-icon{width:18px;height:18px;flex:none}.date-overlay{position:fixed;inset:0;z-index:1100;display:flex;align-items:center;justify-content:center;padding:16px;box-sizing:border-box}.scrim{position:absolute;inset:0;background:#171a1766}.date-panel{position:relative;width:350px;max-width:100%;padding:20px;border-radius:18px;background:#fff;color:#171a17;box-sizing:border-box;box-shadow:0 16px 50px #171a1733}.date-title{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:20px;font-size:18px;font-weight:700}.date-panel .icon-button{width:36px!important;height:38px;padding:0;margin:0!important;line-height:38px;background:#eef1e9;font-size:23px;border-radius:18px;color:#171a17}.date-nav{display:grid;grid-template-columns:36px minmax(0,1.2fr) minmax(0,1fr) 36px;gap:6px;align-items:center;margin-bottom:16px}.date-select{display:flex;justify-content:space-between;align-items:center;padding:9px 10px;border:1px solid #e3e7de;border-radius:18px;font-size:12px;line-height:1.5}.date-week,.date-days{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:4px;text-align:center}.date-week{font-size:11px;color:#687063;margin-bottom:8px}.date-panel .date-day{width:100%!important;min-height:32px;height:37px;padding:0;margin:0!important;font-size:13px;line-height:35px;border:1px solid transparent;border-radius:18px;background:transparent;color:#171a17;box-sizing:border-box}.date-panel .today{border-color:#e3e7de;font-weight:700}.date-panel .selected{background:#d1ff66;font-weight:750}.date-panel .date-day[disabled]{opacity:.3}.date-footer{display:flex;justify-content:flex-end;align-items:center;gap:12px;border-top:1px solid #e3e7de;padding-top:16px;margin-top:16px}.date-panel .date-clear{width:auto!important;margin:0 auto 0 0!important;padding:0;background:none;color:#687063;font-size:11px;line-height:40px}.date-panel .date-today{width:auto!important;margin:0!important;min-height:40px;padding:10px 20px;background:#eef1e9;font-size:12px;line-height:20px;border-radius:18px}

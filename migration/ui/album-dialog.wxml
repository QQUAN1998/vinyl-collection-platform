<view class="album-card-modal ui-album-dialog" wx:if="{{albumCard}}" catchtouchmove="noop"><view class="album-card-scrim" bindtap="closeAlbumCard"/><scroll-view scroll-y class="ui-album-sheet" catchtap="noop"><view class="ui-dialog-head"><text>唱片收藏</text><button class="ui-dialog-close" bindtap="closeAlbumCard" aria-label="关闭">×</button></view><image class="ui-dialog-cover" src="{{albumCard.cover}}" mode="aspectFit"/><view class="ui-dialog-meta"><view class="ui-dialog-kicker"><text>{{albumCard.mediumLabel}} · {{albumCard.year}}</text><text>{{albumCard.priceLabel}}</text></view><view class="ui-dialog-title">{{albumCard.title}}</view><view class="ui-dialog-artist">{{albumCard.artist}}</view><view wx:if="{{uiLife[albumCard.id]}}" class="ui-life">人生第 {{uiLife[albumCard.id]}} 张唱片</view></view><view class="ui-dialog-actions"><button class="ui-dialog-primary" bindtap="openCardDetail">详情 <image class="ui-dialog-icon" src="/assets/ui/arrow.svg"/></button><button class="ui-dialog-secondary" bindtap="handleCardCollectionAction">编辑 <image class="ui-dialog-icon" src="/assets/ui/edit.svg"/></button><button class="ui-dialog-secondary" bindtap="handleWallAction">{{albumCard.isOnPhotoWall?'取消置顶':'置顶'}} <image class="ui-dialog-icon" src="/assets/ui/add.svg"/></button></view><view class="ui-dialog-pager"><button data-direction="-1" bindtap="moveAlbumCard" aria-label="上一张">‹</button><text>{{cardPositionLabel}}</text><button data-direction="1" bindtap="moveAlbumCard" aria-label="下一张">›</button></view><button class="ui-dialog-delete" bindtap="handleCardDeleteAction">删除收藏</button></scroll-view></view>

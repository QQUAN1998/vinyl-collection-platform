/* Shared secondary-page chrome. Kept outside content transforms on detail pages. */
.edit-screen .screen-header,.ui-page-title{display:block!important;margin:0 0 24px!important;font-size:20px!important;line-height:1.4!important;font-weight:650}
.screen-header{margin:0 0 24px!important;display:flex;align-items:center;gap:12px}.screen-header .screen-title{font-size:20px!important;line-height:1.4;letter-spacing:0}.screen-kicker{display:none}.screen,.settings-screen{padding-left:20px!important;padding-right:20px!important;padding-bottom:112px!important;box-sizing:border-box}.ui-form-back{position:fixed!important;left:50%!important;right:auto!important;top:auto!important;bottom:calc(16px + env(safe-area-inset-bottom))!important;transform:translateX(-50%)!important;z-index:800!important;width:44px!important;min-width:44px!important;height:44px!important;min-height:44px!important;border-radius:50%!important;background:var(--color-ink)!important;padding:12px!important;margin:0!important;font-size:0!important;line-height:20px!important;box-sizing:border-box;display:flex!important;align-items:center;justify-content:center;box-shadow:0 4px 14px #0002}.ui-form-back image{display:block;width:20px!important;height:20px!important;filter:brightness(0) invert(1)!important}.ui-form-back::after{border:0}.form-field,.field,.field-row,.row{min-width:0}.edit-form{gap:16px}.field-label,.label{font-size:12px}.section-title{font-size:17px!important}.ui-form-card{background:transparent!important;box-shadow:none!important;border:0!important;padding:0!important}

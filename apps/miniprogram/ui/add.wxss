.ui-page-title{font-size:30px;line-height:1.25;font-weight:750;letter-spacing:-1px;margin-bottom:24px}.ui-method-tabs{display:flex;gap:7px;margin-bottom:19px}.ui-add .ui-method,.page .ui-method{flex:1;min-width:0;width:auto!important;min-height:36px;margin:0!important;padding:10px;border:0;border-radius:18px;font-size:11px;font-weight:550;line-height:1.5;background:var(--color-soft);color:var(--color-ink)}.ui-method-tabs .active{background:var(--color-ink);color:var(--theme-card-surface)}.ui-method::after,.ui-primary::after,.ui-link::after,.ui-share-open::after,.ui-clear::after,.ui-manual-entry::after,.ui-more::after{border:0}.ui-add-card,.ui-share-card{padding:20px;border:1px solid transparent;border-radius:18px;background:var(--theme-card-surface);box-sizing:border-box}.ui-add-card{min-height:224px}.ui-share-card{margin-top:20px}.ui-h2{font-size:17px;line-height:1.35;font-weight:700;letter-spacing:-.4px}.ui-add-card .ui-h2{margin-bottom:19px}.ui-between{display:flex;align-items:center;justify-content:space-between;gap:12px}.ui-search-row{display:flex;align-items:stretch;gap:8px}.ui-search{display:flex;align-items:center;gap:10px;min-width:0;flex:1;padding:0 12px;background:var(--color-screen);border-radius:18px;min-height:44px}.ui-search-input{min-width:0;flex:1;width:100%;font-size:11px;height:44px;line-height:44px;color:var(--color-ink)}.ui-icon{display:block;width:18px;height:18px;flex:none}.ui-add .ui-primary,.page .ui-primary{width:auto!important;margin:0!important;padding:12px 16px;min-height:44px;line-height:20px;border:0;border-radius:18px;background:var(--color-ink);color:var(--theme-card-surface);font-size:12px;font-weight:650;flex:none}.ui-add .ui-full,.page .ui-full{width:100%!important}.ui-add .ui-clear{width:24px!important;height:28px;line-height:28px;margin:0!important;padding:0;background:transparent;color:var(--color-muted);font-size:18px}.ui-add .ui-add-textarea,.page .ui-add-textarea{display:block;width:100%;height:160px;min-height:144px;padding
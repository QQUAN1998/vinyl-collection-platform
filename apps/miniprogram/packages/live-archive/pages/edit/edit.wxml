<wxs module="i18n" src="../../../../ui/locale.wxs"/><page-meta root-background-color="#f5f6f2" background-color="#f5f6f2" background-color-top="#f5f6f2" background-color-bottom="#f5f6f2" page-style="background:#f5f6f2;min-height:100vh;"/><view class="{{uiThemeClass}} ui-editor-nav" style="{{uiThemeStyle}};height:{{uiChromeHeight}}px;padding-top:{{uiStatusHeight}}px"><button class="ui-form-back" bindtap="uiCancel"><image src="/assets/ui/back.svg"/>{{i18n.t('返回',uiLanguage)}}</button><text class="ui-editor-title">{{draft.id?i18n.t('编辑现场',uiLanguage):i18n.t('新建现场',uiLanguage)}}</text></view>
<view class="{{uiThemeClass}} page live-edit-screen" style="padding-top:{{uiChromeHeight}}px!important;;{{uiThemeStyle}}"><view class="ui-page-title">{{draft.id?i18n.t('编辑现场',uiLanguage):i18n.t('新建现场',uiLanguage)}}</view><view class="ui-form-card"><view wx:if="{{draft.cover||draft.posterUrl}}" class="live-edit-summary"><image src="{{draft.cover||draft.posterUrl}}" mode="aspectFit" catchtap="uiImageActions" aria-role="button" aria-label="查看或保存图片"/><view><text>{{draft.name}}</text><text>{{draft.artist}} · {{draft.date}}</text></view><button class="ui-replace-cover" bindtap="cover">{{i18n.t('替换海报',uiLanguage)}}</button></view><view class="field"><view class="label">{{i18n.t('演出名称 *',uiLanguage)}}</view><input class="field-input" value="{{draft.name}}" maxlength="200" data-key="name" aria-label="{{i18n.t('演出名称',uiLanguage)}}" bindinput="input" placeholder="{{i18n.t('演出名称',uiLanguage)}}"/></view><view class="field"><view class="label">{{i18n.t('艺人',uiLanguage)}}</view><input class="field-input" value="{{draft.artist}}" maxlength="500" data-key="artist" aria-label="{{i18n.t('艺人',uiLanguage)}}" bindinput="input" placeholder="{{i18n.t('多位艺人用 / 分隔',uiLanguage)}}"/></view><view class="row date-row"><view class="field half"><view class="label">{{i18n.t('观看日期',uiLanguage)}} *</view><date-field value="{{draft.date||''}}" label="观看日期" disabled="{{busy}}" bindchange="dateChange" bindclear="clearDate"/></view></view><view class="row"><view class="field half"><view class="label">{{i18n.t('城市',uiLanguage)}}</view><input class="field-input" value="{{draft.city}}" maxlength="80" data-key="city" aria-label="{{i18n.t('城市',uiLanguage)}}" bindinput="input" placeholder="{{i18n.t('城市',uiLanguage)}}"/></view><view class="field half"><view class="label">{{i18n.t('类型',uiLanguage)}}</view><ui-select range="{{types}}" value="{{typeIndex}}" data-key="type" bindchange="picker" disabled="{{busy}}"><view class="select ui-disclosure-row"><text>{{draft.type}}</text><image class="ui-disclosure ui-disclosure-down" src="/assets/ui/chevron-down.svg" mode="aspectFit" aria-hidden="true"/></view></ui-select></view></view><view class="field"><view class="label">{{i18n.t('场馆',uiLanguage)}}</view><input class="field-input" value="{{draft.venue}}" maxlength="160" data-key="venue" aria-label="{{i18n.t('场馆',uiLanguage)}}" bindinput="input" placeholder="{{i18n.t('场馆',uiLanguage)}}"/></view><view class="field ticket-price-field"><view class="label">{{i18n.t('票价',uiLanguage)}}</view>
  <view wx:for="{{ticketPrices}}" wx:key="index" class="price-row">
    <ui-select class="price-currency" range="{{currencies}}" value="{{item.currencyIndex}}" data-index="{{index}}" bindchange="priceCurrency" disabled="{{busy}}" aria-label="{{i18n.t('票价币种',uiLanguage)}}"><view class="select ui-disclosure-row"><text>{{item.currency}}</text><image class="ui-disclosure ui-disclosure-down" src="/assets/ui/chevron-down.svg" mode="aspectFit" aria-hidden="true"/></view></ui-select>
    <input class="price-amount" type="digit" value="{{item.amount}}" placeholder="{{i18n.t('填写金额',uiLanguage)}}" maxlength="12" data-index="{{index}}" bindinput="priceInput" disabled="{{busy}}" aria-label="{{i18n.t('票价金额',uiLanguage)}}"/>
    <ui-select class="price-preset" range="{{pricePresets}}" data-index="{{index}}" bindchange="pricePreset" disabled="{{busy}}" aria-label="{{i18n.t('选择常用金额',uiLanguage)}}"><view class="ui-disclosure-row"><text>{{i18n.t('常用金额',uiLanguage)}}</text><image class="ui-disclosure ui-disclosure-down" src="/assets/ui/chevron-down.svg" mode="aspectFit" aria-hidden="true"/></view></ui-select>
    <button class="price-remove" data-index="{{index}}" bindtap="removePrice" disabled="{{busy}}" aria-label="{{i18n.t('移除此笔票价',uiLanguage)}}">×</button>
  </view>
  <button class="link price-add" bindtap="addPrice" disabled="{{busy}}">{{i18n.t('＋另一笔票价',uiLanguage)}}</button>
</view><view class="field"><view class="label">{{i18n.t('海报',uiLanguage)}}</view><image wx:if="{{draft.cover||draft.posterUrl}}" src="{{draft.cover||draft.posterUrl}}" mode="aspectFit" class="cover-preview" catchtap="uiImageActions" aria-role="button" aria-label="查看或保存图片"/><view class="actions"><button class="outline" bindtap="cover" disabled="{{busy}}"><image class="ui-action-icon" src="/assets/ui/upload.svg"/>{{i18n.t('上传海报',uiLanguage)}}</button><button wx:if="{{draft.cover}}" class="link" bindtap="clearCover">{{i18n.t('移除上传',uiLanguage)}}</button></view></view><view class="field" wx:if="{{!draft.date}}"><view class="muted">{{i18n.t('请选择实际观看日期；展期不作为观看日期。',uiLanguage)}}</view></view><view class="field"><view class="label">{{i18n.t('来源链接',uiLanguage)}}</view><input class="field-input" value="{{draft.source}}" maxlength="2048" data-key="source" aria-label="{{i18n.t('来源链接',uiLanguage)}}" bindinput="input" placeholder="{{i18n.t('可留空',uiLanguage)}}"/></view><view class="field" wx:if="{{draft.tickets.length}}"><view class="label">{{i18n.t('私人票根',uiLanguage)}}</view><image wx:for="{{draft.tickets}}" wx:key="*this" src="{{item}}" mode="aspectFit" class="cover-preview"/></view><view class="notice" wx:if="{{i18n.t(message,uiLanguage)}}">{{i18n.t(message,uiLanguage)}}</view><view class="edit-actions"><button class="outline" bindtap="uiCancel" disabled="{{busy}}">{{i18n.t('取消',uiLanguage)}}</button><button class="primary" bindtap="save" disabled="{{busy}}" loading="{{busy}}">{{i18n.t('保存收藏',uiLanguage)}}</button></view></view></view>
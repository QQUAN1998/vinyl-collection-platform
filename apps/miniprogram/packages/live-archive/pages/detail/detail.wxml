<wxs module="i18n" src="../../../../ui/locale.wxs"/><page-meta root-background-color="#f5f6f2" background-color="#f5f6f2" background-color-top="#f5f6f2" background-color-bottom="#f5f6f2" page-style="background:#f5f6f2;min-height:100vh;"/>
<view class="{{uiThemeClass}} page ui-detail-page {{uiClosing?'ui-closing':''}}" style="padding-top:{{uiChromeHeight}}px!important;transform:translateY({{uiDragY}}px);opacity:{{uiDetailOpacity}};;{{uiThemeStyle}}"><view wx:if="{{i18n.t(message,uiLanguage)}}" class="notice">{{i18n.t(message,uiLanguage)}}</view><block wx:if="{{record}}"><view class="hero"><view class="poster theme-{{record.theme}}" bindtouchstart="uiCoverStart" catchtouchmove="uiCoverMove" bindtouchend="uiCoverEnd" bindtouchcancel="uiCoverCancel"><image wx:if="{{record.cover||record.posterUrl}}" src="{{record.cover||record.posterUrl}}" mode="widthFix" show-menu-by-longpress="{{true}}" catchtap="previewPoster" aria-role="button" aria-label="查看或保存图片"/><block wx:else><text class="poster-label">LIVE ARCHIVE</text><text class="poster-name">{{record.name}}</text><text class="tiny">{{record.date}}</text></block></view><view class="facts"><view class="title">{{record.name}}</view><view class="detail-artist">{{record.artist||record.type}}</view><view class="muted detail-date">{{record.date||i18n.t('日期待定',uiLanguage)}}</view><view class="muted detail-place">{{record.city}}{{record.city&&record.venue ? ' · ' : ''}}{{record.venue}}</view></view></view><view class="fact-grid"><view class="fact-item"><text>{{i18n.t('观看日期',uiLanguage)}}</text><text>{{record.date||i18n.t('未填写',uiLanguage)}}</text></view><view class="fact-item"><text>{{i18n.t('城市',uiLanguage)}}</text><text>{{record.city||i18n.t('未填写',uiLanguage)}}</text></view><view class="fact-item"><text>{{i18n.t('类型',uiLanguage)}}</text><text>{{record.type}}</text></view></view><view class="detail-toolbar" wx:if="{{!shared}}"><button class="outline detail-edit" bindtap="edit" disabled="{{busy}}"><image class="ui-action-icon" src="/assets/ui/edit.svg"/>{{i18n.t('编辑现场',uiLanguage)}}</button></view><view wx:else class="pill section">{{record.type}}</view><block wx:if="{{!shared}}"><view class="section detail-section"><view class="row section-title"><text>{{i18n.t('票根',uiLanguage)}}</text><button class="link tiny" data-kind="tickets" bindtap="upload" disabled="{{busy}}"><image class="ui-action-icon" src="/assets/ui/upload.svg"/>{{i18n.t('上传',uiLanguage)}}</button></view><view class="media-grid"><image wx:for="{{record.tickets}}" wx:key="*this" src="{{item}}" mode="aspectFill" data-kind="tickets" data-index="{{index}}" bindtap="preview" bindlongpress="mediaMenu"/></view><text wx:if="{{!record.tickets.length}}" class="muted">{{i18n.t('未上传',uiLanguage)}}</text></view><view class="section detail-section"><view class="row section-title"><text>{{i18n.t('现场照片',uiLanguage)}}</text><button class="link tiny" data-kind="photos" bindtap="upload" disabled="{{busy}}">{{i18n.t('添加',uiLanguage)}}</button></view><view class="media-grid"><image wx:for="{{record.photos}}" wx:key="*this" src="{{item}}" mode="aspectFill" data-kind="photos" data-index="{{index}}" bindtap="preview" bindlongpress="mediaMenu"/></view><text class="muted">{{record.photos.length ? i18n.t('长按图片调整顺序、封面或删除',uiLanguage) : i18n.t('未上传',uiLanguage)}}</text></view><view class="section detail-section"><view class="row section-title"><text>{{i18n.t('曲目',uiLanguage)}}</text><button class="link tiny" data-panel="songs" bindtap="panel"><image class="ui-action-icon" src="/assets/ui/edit.svg"/>{{i18n.t('编辑',uiLanguage)}}</button></view><view wx:for="{{record.songs}}" wx:key="index" class="song"><text class="muted">{{index+1}}</text><text>{{item}}</text></view><text wx:if="{{!record.songs.length}}" class="muted">{{i18n.t('未记录',uiLanguage)}}</text></view><view class="section detail-section"><view class="row section-title"><text>{{i18n.t('费用与同行',uiLanguage)}}</text><button class="link tiny" data-panel="expenses" bindtap="panel"><image class="ui-action-icon" src="/assets/ui/edit.svg"/>{{i18n.t('编辑',uiLanguage)}}</button></view><view class="muted">{{i18n.t('同行人 ·',uiLanguage)}} {{record.companion||i18n.t('未填写',uiLanguage)}}</view><view wx:for="{{record.expenses}}" wx:key="index" class="row expense"><text>{{item.type}}</text><text>{{i18n.money(item.currency,item.amount)}}</text></view></view><view wx:if="{{record.source}}" class="section source-action"><button class="link source-link" bindtap="copySource">{{i18n.t('复制来源链接 ↗',uiLanguage)}}</button></view><button class="danger section" bindtap="remove" disabled="{{busy}}">{{i18n.t('删除收藏',uiLanguage)}}</button></block></block></view>
<view wx:if="{{panel}}" class="overlay"><view class="sheet"><view class="row section-title"><text>{{panel==='songs'?i18n.t('曲目',uiLanguage):i18n.t('费用与同行',uiLanguage)}}</text><button class="link" bindtap="close">{{i18n.t('关闭',uiLanguage)}}</button></view><block wx:if="{{panel==='songs'}}"><textarea class="large-input" placeholder="{{i18n.t('每行一首曲目',uiLanguage)}}" value="{{songsText}}" data-key="songsText" bindinput="input" maxlength="40000"/></block><block wx:else><input placeholder="{{i18n.t('同行人',uiLanguage)}}" value="{{companion}}" data-key="companion" bindinput="input" maxlength="300"/><view class="label section">{{i18n.t('每行：类别,金额,币种',uiLanguage)}}</view><textarea class="large-input" placeholder="票价,680,CNY" value="{{expensesText}}" data-key="expensesText" bindinput="input" maxlength="10000"/><view class="muted section">{{i18n.t('类别：票价、交通、住宿、其他。币种：CNY/HKD/USD/EUR/GBP/JPY/TWD/KRW。',uiLanguage)}}</view></block><view wx:if="{{i18n.t(message,uiLanguage)}}" class="notice">{{i18n.t(message,uiLanguage)}}</view><button class="primary section" bindtap="savePanel" disabled="{{busy}}" loading="{{busy}}">{{i18n.t('保存',uiLanguage)}}</button></view></view>
<button style="{{uiThemeStyle}}" class="{{uiThemeClass}} ui-form-back" bindtap="uiPageBack" aria-label="{{i18n.t('返回',uiLanguage)}}"><image src="/assets/ui/back.svg"/></button>
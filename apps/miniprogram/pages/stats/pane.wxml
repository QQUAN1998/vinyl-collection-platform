<wxs module="i18n" src="../../ui/locale.wxs"/>
<view class="{{uiThemeClass}} ui-native-screen" style="{{uiThemeStyle}}"><space-header wx:if="{{!uiReadOnly}}" avatar="{{uiAvatar}}"/><view wx:if="{{uiShareLoading||uiShareError}}" class="ui-guide-hint"><text>{{uiShareLoading?'正在读取分享…':uiShareError}}</text><button wx:if="{{uiShareError}}" bindtap="uiRetryShare">{{i18n.t('重试',uiLanguage)}}</button></view><stats-board visible="{{visible}}" wx:else share-source="{{uiShareSource}}" avatar="{{uiAvatar}}" collection-share-ready="{{uiCollectionShareReady}}" collection-preparing="{{uiCollectionPreparing}}" bindcollectionshare="uiCollectionShare" records="{{uiRecords}}" kind="{{uiKind||'vinyl'}}" owner="{{uiOwner}}" read-only="{{uiReadOnly}}" snapshot-options="{{uiSnapshotOptions}}" bindselect="uiSelect" bindsnapshot="uiShare"/></view>
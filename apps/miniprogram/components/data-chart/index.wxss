:host{display:block;width:100%;min-width:0}
.chart-wrap{position:relative;height:180px;margin:14px 0;background:transparent!important}
.ring-plot{position:absolute;left:50%;top:50%;width:136px;height:136px;margin-left:-68px;margin-top:-68px;pointer-events:none}
.ring-track,.ring-ink{position:absolute;left:0;top:0;width:136px;height:136px;box-sizing:border-box;border:18px solid;border-radius:50%}
.ring-piece{position:absolute;left:0;top:0;width:136px;height:136px;transform-origin:68px 68px}
.ring-window{position:absolute;left:68px;top:0;width:68px;height:136px;overflow:hidden}
.ring-half{position:absolute;left:-68px;top:0;width:68px;height:136px;overflow:hidden;transform-origin:68px 68px}
.ring-total{position:absolute;left:0;right:0;top:0;bottom:0;display:flex;align-items:center;justify-content:center;flex-direction:column;pointer-events:none}
.ring-total text:first-child{font-size:30px;font-weight:600;line-height:1.2;letter-spacing:-1px}
.ring-total text:last-child{font-size:10px;color:#889080;margin-top:5px}

@import "../../ui/preference-theme.wxss";

<wxs module="i18n" src="../../ui/locale.wxs"/>
<view class="{{uiThemeClass}} n-view home-dock" style="{{uiThemeStyle}}"><switch-cabinet current="{{kind}}"/><view class="n-view dock-actions"><button class="n-button dock-button {{active==='add'?'is-active':''}}" data-action="add" bindtap="open" aria-label="{{i18n.t('添加',uiLanguage)}}"><image class="n-image" src="/assets/ui/nav-add.svg" mode="aspectFit"/></button><button class="n-button dock-button {{active==='stats'?'is-active':''}}" data-action="stats" bindtap="open" aria-label="{{i18n.t('统计',uiLanguage)}}"><image class="n-image" src="/assets/ui/nav-stats.svg" mode="aspectFit"/></button><button class="n-button dock-button {{active==='home'?'is-active':''}}" data-action="home" bindtap="open" aria-label="{{i18n.t('首页',uiLanguage)}}"><image class="n-image" src="/assets/ui/nav-home.svg" mode="aspectFit"/></button></view></view>

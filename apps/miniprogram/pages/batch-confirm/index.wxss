.confirm-screen {
  padding-bottom: calc(140rpx + var(--safe-bottom));
}

.confirm-section {
  margin-top: 0;
}

.field-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22rpx;
}

.medium-batch-field {
  margin-top: 24rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.section-head .section-title {
  margin-bottom: 0;
}

.price-list {
  display: grid;
  gap: 0;
}

.price-row {
  min-height: 126rpx;
  display: grid;
  grid-template-columns: 92rpx 1fr 142rpx;
  gap: 20rpx;
  align-items: center;
  border-bottom: 1rpx solid var(--color-line);
}

.price-cover {
  width: 92rpx;
  height: 92rpx;
  border-radius: var(--radius-cover);
  background: var(--color-soft);
}

.price-copy {
  min-width: 0;
}

.price-title {
  overflow: hidden;
  color: var(--color-ink);
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.price-year {
  margin-top: 7rpx;
  color: var(--color-muted);
  font-size: 23rpx;
  font-weight: 700;
}

.price-input-shell {
  min-height: 72rpx;
  display: grid;
  grid-template-columns: 32rpx 1fr;
  align-items: center;
  padding: 0 16rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-card);
  background: var(--color-paper);
}

.price-symbol {
  color: var(--color-muted);
  font-size: 24rpx;
  font-weight: 900;
}

.price-input {
  min-height: 70rpx;
  color: var(--color-ink);
  font-size: 24rpx;
  font-weight: 900;
}

.confirm-button {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + var(--safe-bottom));
  min-height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-card);
  background: var(--color-action);
  color: var(--theme-card-surface);
  font-size: 30rpx;
  font-weight: 900;
  box-shadow: 0 18rpx 44rpx rgba(101, 118, 77, 0.26);
}

.confirm-button-hover {
  background: var(--color-ink);
}

@import "../../ui/pages.wxss";
/* Unified screenshot refinement */
@import "../../ui/deep-pages.wxss";

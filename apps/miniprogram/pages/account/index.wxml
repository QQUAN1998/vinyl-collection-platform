<view class="screen account-screen">
  <view class="screen-header">
    <view class="screen-title">我的</view>
    <view class="screen-kicker">{{userLabel}}</view>
  </view>

  <view class="profile">
    <view class="profile-card profile-edit-card" bindtap="openUserProfile" hover-class="profile-card-hover" aria-role="button">
      <view class="profile-identity">
        <image wx:if="{{userProfile.avatar}}" class="profile-avatar" src="{{userProfile.avatar}}" mode="aspectFill" />
        <view wx:else class="profile-avatar">{{avatarInitial}}</view>
        <view class="profile-tier-badge">{{tierLabel}}</view>
      </view>
      <view class="profile-card-copy">
        <view class="profile-user-title">{{userProfile.name}}</view>
        <view class="profile-collection-summary">
          <text class="profile-stat">唱片 {{summary.albumCount}}</text>
          <text class="profile-stat">艺人 {{summary.artistCount}}</text>
        </view>
        <view class="profile-normal-limit">{{collectionLimitText}}</view>
      </view>
      <view class="profile-arrow">›</view>
    </view>

    <view class="account-section account-device-section">
      <view class="head-row account-section-head">
        <view class="section-title">电视绑定</view>
      </view>
      <view class="device-row">
        <view class="device-icon">
          <image class="device-symbol" src="/assets/icons/tv-action.png" mode="aspectFit" />
        </view>
        <view class="device-copy">
          <view class="device-name">{{tvDeviceName}}</view>
          <view class="row-meta">{{tvMeta}}</view>
        </view>
        <view class="state-pill">{{tvStatusLabel}}</view>
      </view>
      <view class="primary-button sync-button" bindtap="manualSync" hover-class="button-hover">手动同步</view>
    </view>

    <view class="account-section account-service-section">
      <view class="head-row account-section-head">
        <view class="section-title">平台服务</view>
      </view>
      <view class="tool-row" data-title="导入收藏稍后接入" bindtap="showPlaceholder" hover-class="tool-row-hover">
        <view class="tool-icon">
          <image class="tool-symbol" src="/assets/icons/import-action.png" mode="aspectFit" />
        </view>
        <view class="tool-copy">
          <view class="tool-title">导入收藏</view>
          <view class="row-meta">从表格或文本批量导入</view>
        </view>
        <view class="tool-arrow">›</view>
      </view>
      <view class="tool-row" data-title="已导出当前收藏" bindtap="showPlaceholder" hover-class="tool-row-hover">
        <view class="tool-icon">
          <image class="tool-symbol" src="/assets/icons/export-action.png" mode="aspectFit" />
        </view>
        <view class="tool-copy">
          <view class="tool-title">导出收藏</view>
          <view class="row-meta">备份当前唱片柜资料</view>
        </view>
        <view class="tool-arrow">›</view>
      </view>
      <view class="tool-row" bindtap="openUserGuide" hover-class="tool-row-hover" aria-role="button">
        <view class="tool-icon">
          <image class="tool-symbol" src="/assets/icons/share-action.png" mode="aspectFit" />
        </view>
        <view class="tool-copy">
          <view class="tool-title">小程序操作手册</view>
          <view class="row-meta">不会使用看这里</view>
        </view>
        <view class="tool-arrow">›</view>
      </view>
    </view>
  </view>

  <bottom-nav active="account" />
</view>

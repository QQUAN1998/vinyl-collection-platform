.archive-title {
  margin-top: 14rpx;
  color: var(--color-muted);
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.25;
}

.archive-share {
  min-width: 104rpx;
  min-height: 64rpx;
  margin: 0;
  padding: 0 22rpx;
  border: 0;
  border-radius: 999rpx;
  background: var(--color-ink);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 64rpx;
}

.archive-share::after {
  border: 0;
}

.archive-list {
  display: grid;
  gap: 18rpx;
}

.archive-filters {
  display: grid;
  gap: 22rpx;
  margin-bottom: 24rpx;
  padding: 22rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-panel);
  background: #f7fffb;
}

.filter-group {
  display: grid;
  gap: 12rpx;
}

.filter-label {
  color: var(--color-muted);
  font-size: 22rpx;
  font-weight: 900;
}

.filter-scroll {
  width: 100%;
  white-space: nowrap;
}

.filter-chip {
  min-height: 58rpx;
  display: inline-flex;
  align-items: center;
  margin-right: 12rpx;
  padding: 0 24rpx;
  border-radius: var(--radius-card);
  background: var(--color-soft);
  color: var(--color-muted);
  font-size: 23rpx;
  font-weight: 900;
}

.filter-chip.is-active {
  background: var(--color-ink);
  color: #ffffff;
}

.archive-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22rpx 16rpx;
}

.album-tile {
  min-width: 0;
}

.album-tile-cover {
  width: 100%;
  aspect-ratio: 1;
  display: block;
  overflow: hidden;
  border-radius: var(--radius-cover);
  background: var(--color-soft);
  box-shadow: var(--shadow-cover);
}

.album-tile-cover image {
  width: 100%;
  height: 100%;
}

.album-tile-title {
  overflow: hidden;
  margin-top: 10rpx;
  color: var(--color-ink);
  font-size: 23rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.album-tile-meta {
  margin-top: 4rpx;
  color: var(--color-muted);
  font-size: 20rpx;
  font-weight: 800;
}

.preview-modal {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
}

.preview-scrim {
  position: absolute;
  inset: 0;
  background: rgba(17, 20, 24, 0.42);
}

.preview-card {
  position: relative;
  z-index: 1;
  width: 586rpx;
  max-height: 78vh;
  box-sizing: border-box;
  overflow: auto;
  padding: 20rpx;
  border-radius: var(--radius-panel);
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 28rpx 72rpx rgba(17, 20, 24, 0.26);
}

.preview-card::before {
  content: "";
  position: absolute;
  inset: 14rpx;
  pointer-events: none;
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  border-radius: var(--radius-panel);
}

.preview-card.rarity-n {
  border: 1rpx solid #12b981;
  background: linear-gradient(145deg, #ffffff, #f2fbf6);
}

.preview-card.rarity-r {
  border: 1rpx solid rgba(22, 211, 209, 0.78);
  background: linear-gradient(145deg, #ffffff, #effdff);
}

.preview-card.rarity-sr {
  border: 1rpx solid rgba(139, 92, 246, 0.82);
  background: linear-gradient(145deg, #ffffff, #f6f0ff);
}

.preview-card.rarity-ssr {
  border: 1rpx solid rgba(191, 201, 210, 0.92);
  background: linear-gradient(145deg, #ffffff, #f7f9fa 44%, #eef2f4);
  box-shadow: 0 24rpx 70rpx rgba(151, 164, 176, 0.22), 0 28rpx 72rpx rgba(17, 20, 24, 0.2);
  animation: ssr-card-glow 3.8s ease-in-out infinite;
}

.preview-card.rarity-ur {
  border: 1rpx solid rgba(244, 190, 50, 0.78);
  background: linear-gradient(145deg, #fffdf4, #f4fff9 48%, #fff5d1);
  box-shadow: 0 24rpx 76rpx rgba(244, 190, 50, 0.28), 0 28rpx 72rpx rgba(17, 20, 24, 0.2);
  animation: ur-card-glow 3.4s ease-in-out infinite;
}

@keyframes ssr-card-glow {
  0%, 100% { box-shadow: 0 24rpx 70rpx rgba(151, 164, 176, 0.2), 0 28rpx 72rpx rgba(17, 20, 24, 0.2); }
  50% { box-shadow: 0 24rpx 76rpx rgba(205, 214, 222, 0.42), 0 28rpx 72rpx rgba(17, 20, 24, 0.2); }
}

@keyframes ur-card-glow {
  0%, 100% { box-shadow: 0 24rpx 76rpx rgba(244, 190, 50, 0.24), 0 28rpx 72rpx rgba(17, 20, 24, 0.2); }
  50% { box-shadow: 0 28rpx 88rpx rgba(244, 190, 50, 0.42), 0 28rpx 72rpx rgba(17, 20, 24, 0.2); }
}

.preview-close {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  z-index: 2;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: rgba(17, 20, 24, 0.62);
  font-size: 44rpx;
}

.preview-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.rarity-corner {
  min-width: 132rpx;
  min-height: 70rpx;
  box-sizing: border-box;
  display: grid;
  align-content: center;
  justify-items: center;
  padding: 7rpx 16rpx;
  border-radius: var(--radius-card);
  background: rgba(17, 20, 24, 0.84);
  color: #ffffff;
}

.rarity-ssr .rarity-corner,
.rarity-ur .rarity-corner {
  position: relative;
  overflow: hidden;
}

.rarity-ssr .rarity-corner::after,
.rarity-ur .rarity-corner::after {
  content: "";
  position: absolute;
  top: -40%;
  bottom: -40%;
  left: -70%;
  width: 64%;
  opacity: 0;
  transform: rotate(18deg);
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.72), transparent);
  animation: rarity-badge-sweep 2.6s ease-in-out infinite;
}

.rarity-n .rarity-corner {
  background: #12b981;
}

.rarity-r .rarity-corner {
  background: linear-gradient(135deg, #16d3d1, #2563eb);
}

.rarity-sr .rarity-corner {
  background: linear-gradient(135deg, #a78bfa, #6d28d9);
}

.rarity-ssr .rarity-corner {
  background: linear-gradient(135deg, #ffffff, #b7c1ca 48%, #eef2f4);
  color: var(--color-ink);
}

.rarity-ur .rarity-corner {
  background: linear-gradient(135deg, #f7d046, #b66b00);
  color: var(--color-ink);
}

@keyframes rarity-badge-sweep {
  0%, 46% {
    left: -70%;
    opacity: 0;
  }
  58% {
    opacity: 0.72;
  }
  100% {
    left: 108%;
    opacity: 0;
  }
}

.rarity-corner view {
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1;
}

.rarity-corner text {
  margin-top: 4rpx;
  font-size: 14rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.rarity-corner .rarity-name {
  margin-top: 2rpx;
  font-size: 18rpx;
  letter-spacing: 0;
}

.preview-cover-wrap {
  position: relative;
  overflow: hidden;
  width: 376rpx;
  aspect-ratio: 1;
  box-sizing: border-box;
  margin-left: auto;
  margin-right: auto;
  margin-bottom: 18rpx;
  border: 4rpx solid #12b981;
  border-radius: var(--radius-cover);
  background: var(--color-soft);
}

.preview-cover-wrap::after {
  content: "";
  position: absolute;
  top: -35%;
  bottom: -35%;
  left: -70%;
  width: 50%;
  opacity: 0;
  transform: rotate(18deg);
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.86), transparent);
}

.rarity-ssr .preview-cover-wrap::after,
.rarity-ur .preview-cover-wrap::after {
  animation: rarity-shine 2.8s ease-in-out infinite;
}

@keyframes rarity-shine {
  0%,
  42% {
    left: -70%;
    opacity: 0;
  }
  54% {
    opacity: 0.84;
  }
  72%,
  100% {
    left: 120%;
    opacity: 0;
  }
}

.preview-cover {
  width: 100%;
  height: 100%;
}

.rarity-n .preview-cover-wrap {
  border-color: #12b981;
  box-shadow: 0 18rpx 44rpx rgba(17, 20, 24, 0.14), 0 0 0 4rpx rgba(18, 185, 129, 0.16);
}

.rarity-r .preview-cover-wrap {
  border-color: #16d3d1;
  box-shadow: 0 18rpx 44rpx rgba(17, 20, 24, 0.14), 0 0 0 4rpx rgba(37, 99, 235, 0.18), 0 0 34rpx rgba(22, 211, 209, 0.14);
}

.rarity-sr .preview-cover-wrap {
  border-color: #7c3aed;
  box-shadow: 0 18rpx 44rpx rgba(17, 20, 24, 0.14), 0 0 0 4rpx rgba(167, 139, 250, 0.26), 0 0 32rpx rgba(124, 58, 237, 0.18);
}

.rarity-ssr .preview-cover-wrap {
  border-color: #b7c1ca;
  box-shadow: 0 18rpx 44rpx rgba(17, 20, 24, 0.14), 0 0 0 4rpx rgba(255, 255, 255, 0.86), 0 0 34rpx rgba(176, 188, 198, 0.28);
  animation: ssr-cover-breathe 3.2s ease-in-out infinite;
}

.rarity-ur .preview-cover-wrap {
  border-color: #f4be32;
  box-shadow: 0 18rpx 44rpx rgba(17, 20, 24, 0.14), 0 0 0 4rpx rgba(244, 190, 50, 0.28), 0 0 36rpx rgba(244, 190, 50, 0.34);
  animation: ur-cover-breathe 2.8s ease-in-out infinite;
}

@keyframes ssr-cover-breathe {
  0%, 100% { box-shadow: 0 16rpx 38rpx rgba(17, 20, 24, 0.13), 0 0 0 3rpx rgba(176, 188, 198, 0.18), 0 0 24rpx rgba(176, 188, 198, 0.16); }
  50% { box-shadow: 0 18rpx 42rpx rgba(17, 20, 24, 0.14), 0 0 0 4rpx rgba(255, 255, 255, 0.72), 0 0 42rpx rgba(191, 201, 210, 0.32); }
}

@keyframes ur-cover-breathe {
  0%, 100% { box-shadow: 0 16rpx 38rpx rgba(17, 20, 24, 0.13), 0 0 0 3rpx rgba(244, 190, 50, 0.22), 0 0 30rpx rgba(244, 190, 50, 0.22); }
  50% { box-shadow: 0 20rpx 46rpx rgba(17, 20, 24, 0.14), 0 0 0 4rpx rgba(255, 223, 105, 0.46), 0 0 50rpx rgba(244, 190, 50, 0.4); }
}

.preview-title {
  margin-top: 8rpx;
  color: var(--color-ink);
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.08;
}

.preview-meta {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  font-weight: 800;
}

.preview-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.preview-tags view {
  min-height: 46rpx;
  display: flex;
  align-items: center;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #eef6f3;
  color: var(--color-ink);
  font-size: 21rpx;
  font-weight: 900;
}

.preview-actions {
  display: grid;
  grid-template-columns: 68rpx 108rpx 1fr 68rpx;
  gap: 10rpx;
  align-items: center;
  margin-top: 18rpx;
}

.preview-tracks {
  display: grid;
  gap: 8rpx;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--color-line);
  max-height: 150rpx;
  overflow: auto;
}

.preview-tracks-title {
  color: var(--color-ink);
  font-size: 24rpx;
  font-weight: 900;
}

.preview-track {
  display: grid;
  grid-template-columns: 36rpx 1fr;
  gap: 10rpx;
  color: var(--color-muted);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.3;
}

.preview-track text:first-child {
  color: var(--color-action);
  font-weight: 900;
}

.preview-circle,
.preview-detail,
.preview-share {
  min-height: 72rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-weight: 900;
}

.preview-circle {
  position: relative;
  background: transparent;
  color: transparent;
  font-size: 0;
}

.preview-circle::before {
  content: "";
  position: absolute;
  top: 50%;
  width: 48rpx;
  height: 54rpx;
  transform: translateY(-50%);
  border-radius: var(--radius-card);
  background: rgba(17, 20, 24, 0.36);
  clip-path: polygon(88% 8%, 88% 92%, 12% 50%);
}

.preview-circle.is-prev::before {
  left: 8rpx;
}

.preview-circle.is-next::before {
  right: 8rpx;
  transform: translateY(-50%) rotate(180deg);
}

.preview-detail {
  background: linear-gradient(135deg, #12b981, #0ea672);
  color: #ffffff;
  font-size: 28rpx;
  border-radius: var(--radius-card);
}

.preview-share {
  margin: 0;
  padding: 0;
  border: 1rpx solid rgba(17, 20, 24, 0.12);
  background: rgba(255, 255, 255, 0.72);
  color: var(--color-ink);
  font-size: 26rpx;
  line-height: 1;
  border-radius: var(--radius-card);
}

.preview-share::after {
  border: 0;
}

<view class="screen detail-screen {{themeClass}}" style="{{themeStyle}}">
  <block wx:if="{{album}}">
    <image class="detail-cover" src="{{album.cover}}" mode="aspectFit" />
    <view class="detail-title">{{album.title}}</view>
    <view class="detail-artist">{{album.artist}}</view>

    <view class="fact-grid">
      <view class="fact" wx:for="{{detailFacts}}" wx:key="label">
        <view class="fact-label">{{item.label}}</view>
        <view class="fact-value">{{item.value}}</view>
      </view>
    </view>

    <view wx:if="{{collectionItem}}" class="detail-actions">
      <view class="ghost-button edit-button" bindtap="openEdit" hover-class="button-hover">编辑收藏</view>
    </view>
    <view wx:else class="notice detail-collection-notice">
      <view class="notice-title">还没有加入收藏</view>
      <view class="notice-desc">加入后可以继续维护品相、价格和备注。</view>
      <media-format-selector
        label="选择收藏形式"
        options="{{mediaFormats}}"
        selected-key="{{pendingMediumKey}}"
        bind:change="handleMediumChange"
      />
      <view class="secondary-action" bindtap="addToCollection" hover-class="secondary-action-hover">加入收藏</view>
    </view>

    <view class="section">
      <view class="section-title">曲目</view>
      <view class="track-list">
        <view class="track-row" wx:for="{{tracks}}" wx:key="position">
          <text class="track-index">{{item.position || index + 1}}</text>
          <text class="track-name">{{item.title}}</text>
          <text class="track-duration">{{item.durationLabel || "--"}}</text>
          <view
            class="track-preview-button {{previewPlayingKey === item.previewKey ? 'is-playing' : ''}}"
            data-index="{{index}}"
            data-key="{{item.previewKey}}"
            bindtap="handleTrackPreview"
            aria-label="试听{{item.title}}"
            hover-class="track-preview-button-hover"
          >
            <text wx:if="{{previewLoadingKey === item.previewKey}}">...</text>
            <text wx:elif="{{previewPlayingKey === item.previewKey}}">Ⅱ</text>
            <text wx:else>▶</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <state-view
    wx:else
    tone="warning"
    title="没有找到这张专辑"
    description="可能是本地资料还没有同步。"
  />
</view>

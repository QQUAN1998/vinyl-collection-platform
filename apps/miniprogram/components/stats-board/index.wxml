<wxs module="i18n" src="../../ui/locale.wxs"/>
<view class="{{uiThemeClass}} n-view board" style="{{uiThemeStyle}}">
  <view wx:if="{{readOnly}}" class="n-view snapshot-user"><image class="n-image avatar" src="{{avatar||'/assets/ui/brand/default-avatar.jpg'}}" mode="aspectFill"/><view class="n-view "><view class="n-view h2">{{owner}}</view><text class="n-text muted">{{kind==='live'?i18n.t('演出集',uiLanguage):i18n.t('唱片柜',uiLanguage)}} · {{viewScope==='timeline'?timelineYear:year}}</text></view></view>
  <view wx:if="{{viewScope!=='timeline'}}" class="n-view card currency-card"><view class="n-view currency-head"><view class="n-view h2"><image class="n-image ico inverse" src="/assets/ui/wallet.svg"/>{{i18n.t('花费',uiLanguage)}}</view><ui-select range="{{years}}" value="{{yearIndex}}" bindchange="yearChange" disabled="{{readOnly}}"><view class="n-view select year-select" aria-label="{{i18n.t('统计年份',uiLanguage)}}"><text class="n-text">{{i18n.t(year,uiLanguage)}}</text><image class="n-text select-chevron ui-disclosure ui-disclosure-down" src="/assets/ui/chevron-down.svg" mode="aspectFit" aria-hidden="true"/></view></ui-select></view><view wx:for="{{totals}}" wx:key="currency" class="n-view currency-total"><text class="n-text ">{{item.currency}}</text><view class="n-view amount" data-exact="{{item.exact}}" bindtap="exactAmount"><rolling-number value="{{item.value}}" prefix="{{item.symbol}}" color="#f7f8f2"/></view></view></view>
  <view wx:if="{{viewScope!=='timeline'}}" class="n-view metrics"><view class="n-view metric" wx:for="{{metrics}}" wx:key="label"><view class="n-view metric-label"><image class="n-image ico" src="/assets/ui/{{item.icon}}.svg"/><text class="n-text ">{{i18n.t(item.label,uiLanguage)}}</text></view><view class="n-view number"><rolling-number value="{{item.value}}"/><text class="n-text unit">{{i18n.t(item.unit,uiLanguage)}}</text></view></view></view>
  <view class="n-view stack">
    <block wx:for="{{layout}}" wx:for-item="module" wx:key="id"><view wx:if="{{module.visible}}" class="n-view card module" data-module="{{module.id}}">
      <block wx:if="{{module.id==='calendar'}}"><view class="n-view between"><view class="n-view h2"><image class="n-image ico" src="/assets/ui/calendar.svg"/>{{i18n.t(module.label,uiLanguage)}}</view><text class="n-text muted">{{i18n.t(year,uiLanguage)}}</text></view><view class="n-view calendar-summary"><text class="n-text">{{selectedMonthLabel}}</text><text class="n-text calendar-total">{{selectedMonthCount}} {{kind==='live'?i18n.t('场',uiLanguage):i18n.t('张',uiLanguage)}}</text><text class="n-text muted">{{selectedMonthCosts}}</text></view><scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="n-scroll-view month-rail" scroll-into-view="month-{{selectedMonth+1}}" scroll-with-animation><view class="n-view month-track"><view wx:for="{{months}}" wx:key="month" id="month-{{item.month}}" class="n-view month-stop"><button class="n-button month-capsule {{selectedMonth===index?'selected':''}}" data-index="{{index}}" bindtap="monthTap" aria-label="{{i18n.t(item.label,uiLanguage)}}，{{item.count}}{{kind==='live'?i18n.t('场',uiLanguage):i18n.t('张',uiLanguage)}}"><text class="n-text">{{i18n.t(item.label,uiLanguage)}}</text><text class="n-text">{{item.count}} {{kind==='live'?i18n.t('场',uiLanguage):i18n.t('张',uiLanguage)}}</text></button><view class="n-view month-baseline"><view class="n-view month-dot {{selectedMonth===index?'selected':''}}"/></view></view></view></scroll-view></block>
      <block wx:elif="{{module.id==='format'}}"><view class="n-view between"><view class="n-view h2"><image class="n-image ico" src="/assets/ui/disc.svg"/>{{i18n.t('收藏形式',uiLanguage)}}</view><text class="n-text muted">{{units}} {{i18n.t('件',uiLanguage)}}</text></view><data-chart visible="{{visible&&!panel}}" mode="ring" rows="{{formats}}" total="{{units}}" label="收藏"/><view wx:for="{{formats}}" wx:key="name" class="n-view legend"><view class="n-view "><text class="n-text dot" style="background:{{item.color}}"/>{{item.name}}</view><text class="n-text ">{{item.count}} {{i18n.t('件',uiLanguage)}} <text class="n-text muted">{{item.percent}}%</text></text></view></block>
      <block wx:elif="{{module.id==='artists'}}"><view class="n-view between"><view class="n-view h2"><image class="n-image ico" src="/assets/ui/people.svg"/>{{i18n.t('艺人排行',uiLanguage)}}</view><view class="n-view pills"><button class="n-button pill {{rankMetric==='count'?'active':''}}" data-metric="count" bindtap="rankChange">{{kind==='live'?i18n.t('场次',uiLanguage):i18n.t('数量',uiLanguage)}}</button><button class="n-button pill {{rankMetric==='amount'?'active':''}}" data-metric="amount" bindtap="rankChange">{{i18n.t('花费',uiLanguage)}}</button></view></view><view wx:if="{{kind==='live'&&rankMetric==='amount'}}" class="n-view between rank-currency"><text class="n-text muted">{{i18n.t('多人场次均分',uiLanguage)}}</text><ui-select range="{{currencies}}" bindchange="currencyChange"><view class="n-view select ui-disclosure-row"><text>{{currency}}</text><image class="ui-disclosure ui-disclosure-down" src="/assets/ui/chevron-down.svg" mode="aspectFit" aria-hidden="true"/></view></ui-select></view><view wx:for="{{ranks}}" wx:key="name" class="n-view rankrow" data-name="{{item.name}}" bindtap="artistDetail"><text class="n-text rank-index">{{item.rank}}</text><image wx:if="{{item.cover}}" class="n-image rank-avatar" src="{{item.cover}}" data-src="{{item.cover}}" binderror="imageError" mode="aspectFill"/><view wx:else class="n-view rank-avatar initial">{{item.initial}}</view><view class="n-view rankcopy"><text class="n-text ">{{item.name}}</text><view class="n-view rankbar"><view class="n-view " style="width:{{item.bar}}%"/></view></view><view class="n-view rankvalue"><text wx:if="{{item.currency}}" class="n-text muted">{{item.currency}}</text><text class="n-text ">{{item.symbol}}{{item.value}}</text></view></view><view wx:if="{{!ranks.length}}" class="n-view empty">{{i18n.t('暂无记录',uiLanguage)}}</view></block>
      <block wx:elif="{{module.id==='genres'}}"><view class="n-view between"><view class="n-view h2"><image class="n-image ico" src="/assets/ui/music.svg"/>{{i18n.t('曲风排行',uiLanguage)}}</view><text class="n-text muted">{{genres.length}} {{i18n.t('种',uiLanguage)}}</text></view><data-chart visible="{{visible&&!panel}}" mode="ring" rows="{{genres}}" total="{{genreTotal}}" label="曲风"/><scroll-view class="n-scroll-view genre-scroll" wx:if="{{genres.length}}" scroll-y="{{genres.length>3}}" style="height:{{(genres.length>3?3:genres.length)*66}}px" enhanced="{{true}}" show-scrollbar="{{true}}" aria-label="{{i18n.t('曲风排行，上下滑动查看全部',uiLanguage)}}"><view wx:for="{{genres}}" wx:key="name" class="n-view rankrow genre-row" data-name="{{item.name}}" bindtap="genreDetail"><text class="n-text rank-index">{{item.rank}}</text><view class="n-view rankcopy"><view class="n-view genre-name"><text class="n-text dot {{item.accent?'genre-accent':''}}" style="background:{{item.color}}"/><text class="n-text ">{{item.name}}</text></view></view><view class="n-view rankvalue"><text class="n-text ">{{item.count}} {{i18n.t('张',uiLanguage)}}</text><text class="n-text muted">{{item.percent}}%</text></view></view></scroll-view><view wx:if="{{!genres.length}}" class="n-view empty">{{i18n.t('暂无记录',uiLanguage)}}</view></block>
      <block wx:elif="{{module.id==='cities'}}"><view class="n-view between"><view class="n-view h2"><image class="n-image ico" src="/assets/ui/location.svg"/>{{i18n.t('城市足迹',uiLanguage)}}</view><text class="n-text muted">{{cities.length}} {{i18n.t('座',uiLanguage)}}</text></view><data-chart visible="{{visible&&!panel}}" mode="ring" rows="{{distribution}}" total="{{distributionTotal}}" label="现场"/><view wx:for="{{cities}}" wx:key="name" class="n-view city" data-name="{{item.name}}" bindtap="cityDetail"><text class="n-text ">{{item.name}}</text><view class="n-view ">{{item.count}}<text class="n-text unit"> {{i18n.t('场',uiLanguage)}}</text></view><image class="n-text  ui-disclosure ui-disclosure-right" src="/assets/ui/chevron-right.svg" mode="aspectFit" aria-hidden="true"/></view><view wx:if="{{!cities.length}}" class="n-view empty">{{i18n.t('暂无城市足迹',uiLanguage)}}</view></block>
      <block wx:elif="{{module.id==='timeline'}}"><view class="n-view timeline-header"><view class="n-view h2"><image class="n-image ico" src="/assets/ui/calendar.svg"/>{{i18n.t('时间线',uiLanguage)}}</view><button wx:if="{{!readOnly}}" class="n-button timeline-share" bindtap="openTimelineShare" aria-label="{{i18n.t('分享时间线',uiLanguage)}}"><image class="n-image ico" src="/assets/ui/share.svg"/></button></view><view class="n-view timeline-filter-row"><ui-select range="{{timelineYearLabels}}" value="{{timelineYearIndex}}" bindchange="timelineChange" disabled="{{readOnly}}"><view class="n-view select timeline-select"><text class="n-text">{{i18n.t(timelineYear,uiLanguage)}}</text><image class="n-text select-chevron ui-disclosure ui-disclosure-down" src="/assets/ui/chevron-down.svg" mode="aspectFit" aria-hidden="true"/></view></ui-select><text class="n-text muted">{{timeline.length}} {{kind==='live'?i18n.t('场',uiLanguage):i18n.t('张',uiLanguage)}}</text></view><template is="record-timeline" data="{{rows:timelinePreview,kind:kind,readOnly:readOnly,uiLanguage:uiLanguage}}"/><view wx:if="{{!timeline.length}}" class="n-view empty">{{i18n.t('这一年还没有记录',uiLanguage)}}</view><button wx:if="{{timeline.length&&viewScope!=='timeline'}}" class="n-button timeline-more" bindtap="openTimeline"><text class="n-text">{{i18n.t('查看完整时间线',uiLanguage)}}</text><view class="n-view"><text class="n-text">{{timeline.length}}</text><image class="n-text timeline-arrow ui-disclosure ui-disclosure-right" src="/assets/ui/chevron-right.svg" mode="aspectFit" aria-hidden="true"/></view></button></block>
    </view></block>
    <view wx:if="{{!readOnly}}" class="n-view actions"><button class="n-button primary" bindtap="openShare"><image class="n-image ico inverse" src="/assets/ui/share.svg"/>{{i18n.t('统计分享',uiLanguage)}}</button><button class="n-button secondary" bindtap="openLayout"><image class="n-image ico" src="/assets/ui/filter.svg"/>{{i18n.t('统计排列',uiLanguage)}}</button></view>
  </view>
  <view wx:if="{{panel}}" class="n-view overlay" catchtouchmove="noop"><view class="n-view scrim" bindtap="close"/><view class="n-view sheet {{panel==='share'||panel==='timelineShare'?'share-sheet':''}}"><view class="n-view sheet-head"><text class="n-text h2">{{i18n.t(panelTitle,uiLanguage)}}</text><button wx:if="{{panel==='timeline'&&!readOnly}}" class="n-button timeline-share" bindtap="openTimelineShare" aria-label="{{i18n.t('分享时间线',uiLanguage)}}"><image class="n-image ico" src="/assets/ui/share.svg"/></button><button class="n-button close" bindtap="close" aria-label="{{i18n.t('关闭',uiLanguage)}}">×</button></view><scroll-view scroll-y class="n-scroll-view sheet-scroll">
    <block wx:if="{{panel==='layout'}}"><text class="n-text muted">{{i18n.t('选择要显示的板块，用上下按钮调整顺序。',uiLanguage)}}</text><view wx:for="{{layoutDraft}}" wx:key="id" class="n-view layout-row"><checkbox-group data-index="{{index}}" bindchange="layoutCheck"><label class="n-label"><checkbox class="n-checkbox" checked="{{item.visible}}" value="on" color="#171a17"/>{{i18n.t(item.label,uiLanguage)}}</label></checkbox-group><view class="n-view move"><button class="n-button " data-index="{{index}}" data-step="-1" bindtap="moveLayout" disabled="{{index===0}}" aria-label="上移{{i18n.t(item.label,uiLanguage)}}"><image class="n-image reorder-icon" src="/assets/ui/reorder-up.svg" mode="aspectFit" aria-hidden="true"/></button><button class="n-button " data-index="{{index}}" data-step="1" bindtap="moveLayout" disabled="{{index===layoutDraft.length-1}}" aria-label="下移{{i18n.t(item.label,uiLanguage)}}"><image class="n-image reorder-icon" src="/assets/ui/reorder-down.svg" mode="aspectFit" aria-hidden="true"/></button></view></view><button class="n-button link" bindtap="resetLayout">{{i18n.t('恢复默认排列',uiLanguage)}}</button><view class="n-view actions"><button class="n-button secondary" bindtap="close">{{i18n.t('取消',uiLanguage)}}</button><button class="n-button primary" bindtap="applyLayout">{{i18n.t('应用排列',uiLanguage)}}</button></view></block>
    <block wx:elif="{{panel==='share'}}"><view wx:if="{{shareError}}" class="n-view muted">{{shareError}}</view><block wx:if="{{!readOnly}}"><button class="n-button share-choice" wx:if="{{collectionShareReady}}" open-type="share" data-scope="all"><image class="n-image ico" src="/assets/ui/share.svg"/><view class="n-view"><text class="n-text">{{kind==='live'?i18n.t('分享全部演出集收藏链接页面',uiLanguage):i18n.t('分享全部唱片柜收藏链接页面',uiLanguage)}}</text><text class="n-text">{{i18n.t('与添加页的全部收藏一致',uiLanguage)}}</text></view><image class="n-text ui-disclosure ui-disclosure-right" src="/assets/ui/chevron-right.svg" mode="aspectFit" aria-hidden="true"/></button><button class="n-button share-choice" wx:else bindtap="prepareCollectionShare" loading="{{collectionPreparing}}" disabled="{{collectionPreparing}}"><image class="n-image ico" src="/assets/ui/share.svg"/><view class="n-view"><text class="n-text">{{kind==='live'?i18n.t('分享全部演出集收藏链接页面',uiLanguage):i18n.t('分享全部唱片柜收藏链接页面',uiLanguage)}}</text><text class="n-text">{{i18n.t('点击准备完整收藏分享',uiLanguage)}}</text></view><image class="n-text ui-disclosure ui-disclosure-right" src="/assets/ui/chevron-right.svg" mode="aspectFit" aria-hidden="true"/></button></block><button class="n-button share-choice" bindtap="openModules"><image class="n-image ico" src="/assets/ui/image.svg"/><view class="n-view "><text class="n-text ">{{i18n.t('分享统计页长图海报',uiLanguage)}}</text><text class="n-text ">{{i18n.t('用户名与完整统计页面',uiLanguage)}}</text></view><image class="n-text  ui-disclosure ui-disclosure-right" src="/assets/ui/chevron-right.svg" mode="aspectFit" aria-hidden="true"/></button><button class="n-button share-choice" open-type="share" disabled="{{!sharePath}}"><image class="n-image ico" src="/assets/ui/share.svg"/><view class="n-view "><text class="n-text ">{{i18n.t('分享统计页面给好友',uiLanguage)}}</text><text class="n-text ">{{i18n.t('分享当前统计页面',uiLanguage)}}</text></view><image class="n-text  ui-disclosure ui-disclosure-right" src="/assets/ui/chevron-right.svg" mode="aspectFit" aria-hidden="true"/></button></block>
    <block wx:elif="{{panel==='timelineShare'}}"><view wx:if="{{shareError}}" class="n-view muted">{{shareError}}</view><button wx:if="{{shareError&&!readOnly}}" class="n-button secondary" bindtap="prepareCollectionShare" loading="{{collectionPreparing}}" disabled="{{collectionPreparing}}">{{i18n.t('点击准备完整收藏分享',uiLanguage)}}</button><button class="n-button share-choice" open-type="share" disabled="{{!sharePath}}"><image class="n-image ico" src="/assets/ui/share.svg"/><view class="n-view"><text class="n-text">{{i18n.t('分享时间线给好友',uiLanguage)}}</text><text class="n-text">{{i18n.t(timelineYear,uiLanguage)}} · {{timeline.length}} {{kind==='live'?i18n.t('场',uiLanguage):i18n.t('张',uiLanguage)}}</text></view><image class="n-text ui-disclosure ui-disclosure-right" src="/assets/ui/chevron-right.svg" mode="aspectFit" aria-hidden="true"/></button><button class="n-button share-choice" bindtap="generateTimelinePoster" loading="{{generating}}" disabled="{{generating}}"><image class="n-image ico" src="/assets/ui/image.svg"/><view class="n-view"><text class="n-text">{{i18n.t('时间线长图',uiLanguage)}}</text><text class="n-text">{{i18n.t('仅包含当前时间线',uiLanguage)}}</text></view><image class="n-text ui-disclosure ui-disclosure-right" src="/assets/ui/chevron-right.svg" mode="aspectFit" aria-hidden="true"/></button></block><block wx:elif="{{panel==='modules'}}"><checkbox-group bindchange="posterCheck"><label wx:for="{{posterChoices}}" wx:key="id" class="n-label module-choice"><checkbox class="n-checkbox" value="{{item.id}}" checked="{{item.selected}}" color="#171a17"/>{{i18n.t(item.label,uiLanguage)}}</label></checkbox-group><view class="n-view actions"><button class="n-button secondary" bindtap="openShare">{{i18n.t('返回',uiLanguage)}}</button><button class="n-button primary ui-disclosure-row" bindtap="generatePoster" loading="{{generating}}" disabled="{{generating}}"><text>{{i18n.t('生成海报',uiLanguage)}}</text><image class="ui-disclosure ui-disclosure-right" src="/assets/ui/chevron-right.svg" mode="aspectFit" aria-hidden="true"/></button></view></block>
    <block wx:elif="{{panel==='link'}}"><view class="n-view share-path">{{sharePath}}</view><view class="n-view actions"><button class="n-button secondary" bindtap="openShare">{{i18n.t('切换形式',uiLanguage)}}</button><button class="n-button primary" open-type="share" disabled="{{!sharePath}}">{{i18n.t('发送给好友',uiLanguage)}}</button></view><button class="n-button link" bindtap="copyPath">{{i18n.t('复制页面路径',uiLanguage)}}</button></block>
    <block wx:elif="{{panel==='poster'}}"><image wx:for="{{posterUrls}}" wx:key="*this" class="n-image poster-preview" src="{{item}}" mode="widthFix" data-index="{{index}}" bindtap="previewPoster"/><view class="n-view actions"><button class="n-button secondary" bindtap="openModules">{{i18n.t('调整模块',uiLanguage)}}</button><button class="n-button primary" bindtap="savePosters">{{i18n.t('保存图片',uiLanguage)}}</button></view></block>
    <block wx:else><view wx:for="{{detailCosts}}" wx:key="currency" class="n-view currency-total"><text class="n-text ">{{item.currency}}</text><text class="n-text ">{{item.symbol}}{{item.exact}}</text></view><template is="record-timeline" data="{{rows:detailRecords,kind:kind,readOnly:readOnly,uiLanguage:uiLanguage}}"/><view wx:if="{{detailEmpty||(!detailRecords.length&&!detailCosts.length)}}" class="n-view empty">{{i18n.t('暂无记录',uiLanguage)}}</view></block>
  </scroll-view></view></view>
  <canvas type="2d" id="statsPoster" class="poster-canvas"/>
</view>

<template name="record-timeline"><view class="n-view timeline record-timeline"><view wx:for="{{rows}}" wx:key="id" class="n-view timeline-event" data-id="{{item.id}}" bindtap="selectRecord"><image wx:if="{{item.cover}}" class="n-image timeline-art {{kind==='live'?'portrait':''}}" src="{{item.cover}}" data-src="{{item.cover}}" binderror="imageError" mode="aspectFill"/><view wx:else class="n-view timeline-art initial">{{kind==='live'?'LIVE':'♪'}}</view><view class="n-view timeline-info"><text class="n-text">{{item.date||i18n.t('日期待补',uiLanguage)}}</text><text class="n-text timeline-title">{{item.title}}</text><text class="n-text">{{kind==='live'?(item.city||i18n.t('城市待补',uiLanguage))+(item.venue?' · '+item.venue:''):item.artist}}</text><text wx:if="{{item.sequence}}" class="n-text life-tag">{{i18n.t('人生第',uiLanguage)}} {{item.sequence}} {{kind==='live'?i18n.t('场演出',uiLanguage):i18n.t('张唱片',uiLanguage)}}</text></view><image wx:if="{{!readOnly}}" class="n-text timeline-arrow ui-disclosure ui-disclosure-right" src="/assets/ui/chevron-right.svg" mode="aspectFit" aria-hidden="true"/></view></view></template>
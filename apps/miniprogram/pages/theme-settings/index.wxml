<wxs module="i18n" src="../../ui/locale.wxs"/><page-meta root-background-color="#f5f6f2" background-color="#f5f6f2" background-color-top="#f5f6f2" background-color-bottom="#f5f6f2" page-style="background:#f5f6f2;min-height:100vh;"/>
<view class="{{uiThemeClass}} screen settings-screen {{themeClass}}" style="padding-top:{{uiChromeHeight}}px!important;{{themeStyle}};{{uiThemeStyle}}">
  <view class="settings-heading">{{i18n.t('语言设置',uiLanguage)}}</view>
  <view class="settings-section language-section">
    <view class="settings-label">{{i18n.t('界面语言',uiLanguage)}}</view>
    <view class="language-list">
      <button wx:for="{{languages}}" wx:key="code" class="language-choice {{selectedLanguage===item.code?'selected':''}}" data-code="{{item.code}}" bindtap="selectLanguage" aria-role="radio" aria-checked="{{selectedLanguage===item.code}}"><text>{{item.name}}</text><text class="language-check">{{selectedLanguage===item.code?'✓':''}}</text></button>
    </view>
    <view class="settings-hint">{{i18n.t('专辑、艺人和你填写的内容保留原文。',uiLanguage)}}</view>
  </view>
</view>

<button class="{{uiThemeClass}} ui-form-back" style="{{uiThemeStyle}}" bindtap="uiPageBack" aria-label="{{i18n.t('返回',uiLanguage)}}"><image src="/assets/ui/back.svg"/></button>

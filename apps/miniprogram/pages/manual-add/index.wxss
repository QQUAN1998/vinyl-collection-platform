.manual-add-screen {
  padding-bottom: calc(260rpx + var(--safe-bottom));
}

.cover-card {
  min-height: 180rpx;
  box-sizing: border-box;
  display: grid;
  grid-template-columns: 156rpx 1fr;
  gap: 22rpx;
  align-items: center;
  padding: 22rpx;
  border: 1rpx solid rgba(101, 118, 77, 0.24);
  border-radius: var(--radius-card);
  background: var(--theme-card-surface);
  box-shadow: var(--shadow-panel);
  backdrop-filter: blur(18rpx);
}

.manual-cover,
.manual-cover-placeholder {
  width: 156rpx;
  height: 156rpx;
  border-radius: var(--radius-cover);
}

.manual-cover-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed rgba(101, 118, 77, 0.34);
  background: var(--color-soft);
  color: var(--color-action);
  font-size: 52rpx;
  font-weight: 700;
}

.cover-copy {
  min-width: 0;
}

.cover-title {
  color: var(--color-ink);
  font-size: 32rpx;
  font-weight: 900;
}

.cover-desc {
  margin-top: 10rpx;
  color: var(--color-muted);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
}

.manual-form {
  display: grid;
  gap: 24rpx;
}

.manual-actions {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + var(--safe-bottom));
  display: grid;
  grid-template-columns: 180rpx 1fr;
  gap: 18rpx;
}

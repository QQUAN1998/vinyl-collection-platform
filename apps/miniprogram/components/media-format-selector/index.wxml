<view class="media-format-selector">
  <view class="media-format-label">{{label}}</view>
  <view class="media-format-grid">
    <view
      wx:for="{{options}}"
      wx:key="key"
      class="media-format-option {{item.key === selectedKey ? 'is-active' : ''}}"
      data-key="{{item.key}}"
      bindtap="handleSelect"
      aria-role="button"
      aria-label="选择{{item.label}}"
    >
      <view class="media-format-dot" style="background: {{item.color}}"></view>
      <text>{{item.label}}</text>
    </view>
  </view>
</view>

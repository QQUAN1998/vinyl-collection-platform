:host{display:block;height:64px;margin-bottom:24px}.topline{position:fixed;z-index:70;top:0;left:0;right:0;height:64px;padding:0 20px;box-sizing:border-box;background:#f5f6f2;display:flex;align-items:center;justify-content:space-between;gap:12px}.topline .avatar{display:flex;align-items:center;justify-content:center;width:36px!important;height:36px;min-width:36px;max-width:36px;flex:0 0 36px;padding:0;margin:0!important;border:0;border-radius:50%;background:#d1ff66}.avatar::after{border:0}.avatar-image{display:block;width:24px;height:24px}.avatar-cover{width:100%;height:100%;border-radius:50%}

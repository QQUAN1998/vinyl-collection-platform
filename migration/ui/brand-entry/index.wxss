:host{pointer-events:none}
.brand-entry{position:fixed;left:50%;top:42%;width:138px;height:76px;transform:translate(-50%,-50%);z-index:3000;opacity:0;pointer-events:none}
.brand-entry image{display:block;width:100%;height:100%;pointer-events:none}
.brand-entry.is-ready{animation:brand-fade 1s ease-out both}
@keyframes brand-fade{0%,22%{opacity:1}100%{opacity:0}}

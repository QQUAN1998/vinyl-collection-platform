.album-row {
  min-height: 128rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 20rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-card);
  background: var(--color-paper);
  transition: background-color 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
}

.album-row-hover {
  border-color: rgba(101, 118, 77, 0.36);
  background: var(--palette-green-soft);
}

.album-row.is-selected {
  border-color: var(--color-select);
  box-shadow: 0 0 0 2rpx rgba(101, 118, 77, 0.16);
}

.album-row.is-disabled {
  opacity: 0.52;
}

.album-row.is-compact {
  min-height: 108rpx;
  padding: 16rpx;
}

.album-row-cover {
  width: 112rpx;
  height: 112rpx;
  flex: 0 0 112rpx;
  border-radius: var(--radius-cover);
  background: var(--color-soft);
}

.album-row.is-compact .album-row-cover {
  width: 88rpx;
  height: 88rpx;
  flex-basis: 88rpx;
}

.album-row-copy {
  min-width: 0;
  flex: 1;
}

.album-row-title {
  overflow: hidden;
  color: var(--color-ink);
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.album-row-subtitle,
.album-row-meta {
  overflow: hidden;
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.album-row-meta {
  color: var(--color-faint);
}

.album-row-check {
  width: 44rpx;
  height: 44rpx;
  flex: 0 0 44rpx;
  box-sizing: border-box;
  border: 3rpx solid var(--color-select);
  border-radius: var(--radius-card);
  display: flex;
  align-items: center;
  justify-content: center;
}

.album-row-check.is-on {
  background: var(--color-select);
}

.album-row-check-mark {
  width: 16rpx;
  height: 26rpx;
  border-right: 4rpx solid var(--theme-card-surface);
  border-bottom: 4rpx solid var(--theme-card-surface);
  transform: rotate(45deg) translate(-1rpx, -3rpx);
}

.album-row-check:not(.is-on) .album-row-check-mark {
  display: none;
}

.album-row-arrow {
  color: var(--color-action);
  font-size: 34rpx;
  font-weight: 800;
}

@import "../../ui/preference-theme.wxss";
@import "../../ui/disclosure-icons.wxss";

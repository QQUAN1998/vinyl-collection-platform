<wxs module="i18n" src="../../ui/locale.wxs"/>
<view class="{{uiThemeClass}} date-control" style="{{uiThemeStyle}}"><picker mode="date" value="{{value}}" start="{{start}}" end="{{end}}" disabled="{{disabled}}" bindchange="nativeChange"><view class="date-trigger {{!value?'muted':''}}" aria-label="{{i18n.t(label,uiLanguage)}}">{{value||i18n.t('选择日期',uiLanguage)}}<image class="date-icon" src="/assets/ui/calendar.svg"/></view></picker><button wx:if="{{value&&!required}}" class="native-date-clear" bindtap="clear" disabled="{{disabled}}" aria-label="{{i18n.t('清除日期',uiLanguage)}}">×</button></view>
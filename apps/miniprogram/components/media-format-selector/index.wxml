<wxs module="i18n" src="../../ui/locale.wxs"/>
<view class="{{uiThemeClass}} n-view media-format-selector" style="{{uiThemeStyle}}"><view class="n-view media-format-label">{{i18n.t(label,uiLanguage)}}</view><ui-select range="{{options}}" range-key="label" value="{{selectedIndex}}" bindchange="handleSelect" label="{{label}}"><view class="n-view media-format-control">{{i18n.t(selectedLabel,uiLanguage)}}<image class="n-text ui-disclosure ui-disclosure-down" src="/assets/ui/chevron-down.svg" mode="aspectFit" aria-hidden="true"/></view></ui-select></view>
<view class="page"><view wx:if="{{message}}" class="notice">{{message}}</view><block wx:if="{{record}}"><view class="hero"><view class="poster theme-{{record.theme}}"><image wx:if="{{record.cover||record.posterUrl}}" src="{{record.cover||record.posterUrl}}" mode="aspectFill" bindtap="previewPoster" show-menu-by-longpress="{{true}}" aria-role="button" aria-label="查看海报原图，长按保存"/><block wx:else><text class="poster-label">LIVE ARCHIVE</text><text class="poster-name">{{record.name}}</text><text class="tiny">{{record.date}}</text></block></view><view class="facts"><view class="title">{{record.name}}</view><view class="detail-artist">{{record.artist||record.type}}</view><view class="muted detail-date">{{record.date||'日期待定'}}</view><view class="muted detail-place">{{record.city}}{{record.city&&record.venue ? ' · ' : ''}}{{record.venue}}</view></view></view><view class="detail-toolbar" wx:if="{{!shared}}"><picker class="status-picker" range="{{statuses}}" bindchange="status" disabled="{{busy}}" aria-label="收藏状态"><view class="pill">{{record.status}} ▾</view></picker><button class="outline detail-edit" bindtap="edit" disabled="{{busy}}">编辑现场</button></view><view wx:else class="pill section">{{record.type}}</view><block wx:if="{{!shared}}"><view class="section detail-section"><view class="row section-title"><text>票根</text><button class="link tiny" data-kind="tickets" bindtap="upload" disabled="{{busy}}">上传</button></view><view class="media-grid"><image wx:for="{{record.tickets}}" wx:key="*this" src="{{item}}" mode="aspectFill" data-kind="tickets" data-index="{{index}}" bindtap="preview" bindlongpress="mediaMenu"/></view><text wx:if="{{!record.tickets.length}}" class="muted">未上传</text></view><view class="section detail-section"><view class="row section-title"><text>现场照片</text><button class="link tiny" data-kind="photos" bindtap="upload" disabled="{{busy}}">添加</button></view><view class="media-grid"><image wx:for="{{record.photos}}" wx:key="*this" src="{{item}}" mode="aspectFill" data-kind="photos" data-index="{{index}}" bindtap="preview" bindlongpress="mediaMenu"/></view><text class="muted">{{record.photos.length ? '长按图片调整顺序、封面或删除' : '未上传'}}</text></view><view class="section detail-section"><view class="row section-title"><text>曲目</text><button class="link tiny" data-panel="songs" bindtap="panel">编辑</button></view><view wx:for="{{record.songs}}" wx:key="index" class="song"><text class="muted">{{index+1}}</text><text>{{item}}</text></view><text wx:if="{{!record.songs.length}}" class="muted">未记录</text></view><view class="section detail-section"><view class="row section-title"><text>费用与同行</text><button class="link tiny" data-panel="expenses" bindtap="panel">编辑</button></view><view class="muted">同行人 · {{record.companion||'未填写'}}</view><view wx:for="{{record.expenses}}" wx:key="index" class="row expense"><text>{{item.type}}</text><text>{{item.currency}} {{item.amount}}</text></view></view><view wx:if="{{record.source}}" class="section source-action"><button class="link source-link" bindtap="copySource">复制来源链接 ↗</button></view><button class="danger section" bindtap="remove" disabled="{{busy}}">删除收藏</button></block></block></view>
<view wx:if="{{panel}}" class="overlay"><view class="sheet"><view class="row section-title"><text>{{panel==='songs'?'曲目':'费用与同行'}}</text><button class="link" bindtap="close">关闭</button></view><block wx:if="{{panel==='songs'}}"><textarea class="large-input" placeholder="每行一首曲目" value="{{songsText}}" data-key="songsText" bindinput="input" maxlength="40000"/></block><block wx:else><input placeholder="同行人" value="{{companion}}" data-key="companion" bindinput="input" maxlength="300"/><view class="label section">每行：类别,金额,币种</view><textarea class="large-input" placeholder="票价,680,CNY" value="{{expensesText}}" data-key="expensesText" bindinput="input" maxlength="10000"/><view class="muted section">类别：票价、交通、住宿、其他。币种：CNY/HKD/USD/EUR/GBP/JPY/TWD/KRW。</view></block><view wx:if="{{message}}" class="notice">{{message}}</view><button class="primary section" bindtap="savePanel" disabled="{{busy}}" loading="{{busy}}">保存</button></view></view>

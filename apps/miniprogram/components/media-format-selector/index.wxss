.media-format-selector {
  display: grid;
  gap: 14rpx;
}

.media-format-label {
  color: var(--color-muted);
  font-size: 22rpx;
  font-weight: 900;
}

.media-format-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
}

.media-format-option {
  min-width: 0;
  min-height: 66rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 0 12rpx;
  border: 1rpx solid var(--color-line);
  border-radius: var(--radius-card);
  background: var(--color-paper);
  color: var(--color-ink);
  font-size: 22rpx;
  font-weight: 900;
}

.media-format-option.is-active {
  border-color: var(--color-ink);
  background: var(--color-ink);
  color: #ffffff;
}

.media-format-dot {
  flex: none;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  box-shadow: inset 0 0 0 1rpx rgba(17, 20, 24, 0.08);
}

.media-format-option text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

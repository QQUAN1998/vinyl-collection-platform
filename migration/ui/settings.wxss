.settings-screen{display:block;padding:24px 20px 48px;color:var(--color-ink);background:var(--color-screen);min-height:100vh;box-sizing:border-box}.settings-heading{font-size:28px;font-weight:750;line-height:1.3;margin-bottom:30px}.settings-section{margin-bottom:32px}.settings-label{font-size:14px;font-weight:650;margin-bottom:16px}.theme-choices{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.theme-choice{position:relative;display:flex;flex-direction:column;align-items:center;gap:12px;padding:12px 8px;min-width:0;margin:0;background:var(--theme-card-surface);color:var(--color-ink);border:1px solid var(--color-line);border-radius:16px;font-size:12px;line-height:1.4}.theme-choice::after,.language-choice::after{border:0}.theme-choice.selected{border-color:var(--color-ink);box-shadow:0 0 0 1px var(--color-ink)}.theme-mini{position:relative;width:62px;height:86px;border:1px solid #d5d8d0;border-radius:9px;background:#f5f6f2;padding:10px 8px;box-sizing:border-box}.mini-bar{height:4px;width:25px;background:#171a17;border-radius:2px}.mini-art{height:29px;width:29px;margin:10px auto 6px;background:#b8c8ae;box-shadow:2px 2px 0 #0002}.mini-line{height:3px;width:23px;background:#7d8377;margin:auto;border-radius:2px}.mini-dock{position:absolute;left:8px;right:8px;bottom:7px;height:5px;border-radius:3px;background:#d1ff66}.mini-dark{background:#101113;border-color:#363a36}.mini-dark .mini-bar{background:#f7f3ea}.mini-dark .mini-art{background:#667859}.choice-label{max-width:100%;text-align:center;overflow-wrap:anywhere}.choice-check{position:absolute;right:7px;top:5px;font-size:12px;line-height:1}.settings-hint{font-size:11px;line-height:1.6;color:var(--color-muted);margin-top:14px}.language-list{overflow:hidden;border:1px solid var(--color-line);border-radius:16px;background:var(--theme-card-surface)}.language-choice{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:56px;width:100%;margin:0;padding:14px 18px;border-radius:0;background:transparent;color:var(--color-ink);border-bottom:1px solid var(--color-line);font-size:14px;line-height:1.5;text-align:left}.language-choice:last-child{border:0}.language-choice.selected{font-weight:650}.language-check{display:flex;align-items:center;justify-content:center;flex:none;width:22px;height:22px;border-radius:50%;font-size:13px;background:var(--color-soft)}.language-choice.selected .language-check{background:#d1ff66;color:#171a17}
.theme-choices button.theme-choice{width:100%;box-sizing:border-box;max-width:100%}.language-list button.language-choice{width:100%;max-width:none;box-sizing:border-box;margin:0}

@import "../../ui/deep-pages.wxss";
.settings-heading{font-size:20px;margin-bottom:24px}

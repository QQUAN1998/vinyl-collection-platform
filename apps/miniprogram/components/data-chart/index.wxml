<wxs module="i18n" src="../../ui/locale.wxs"/>
<view class="{{uiThemeClass}} chart-wrap" aria-label="{{i18n.t(label,uiLanguage)}}" style="{{uiThemeStyle}}"><view wx:if="{{visible}}" class="ring-plot"><view class="ring-track" style="border-color:{{trackColor}}"/><view wx:for="{{segments}}" wx:key="id" class="ring-piece" style="transform:rotate({{item.start}}deg)"><view class="ring-window"><view class="ring-half" style="transform:rotate({{item.sweep}}deg)"><view class="ring-ink" style="border-color:{{item.color}}"/></view></view></view></view><view class="ring-total" style="color:#171a17"><text>{{total}}</text><text>{{i18n.t(label,uiLanguage)}}</text></view></view>

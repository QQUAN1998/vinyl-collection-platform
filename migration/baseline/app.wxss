.icon-import {
  -webkit-mask-image: url("/assets/icons/import.svg");
  mask-image: url("/assets/icons/import.svg");
}

.icon-export {
  -webkit-mask-image: url("/assets/icons/export.svg");
  mask-image: url("/assets/icons/export.svg");

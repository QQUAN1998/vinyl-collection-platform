<wxs module="i18n" src="../../ui/locale.wxs"/><page-meta root-background-color="{{uiModalBackground}}" background-color="#f5f6f2" background-color-top="#f5f6f2" background-color-bottom="{{uiModalBackground}}" page-style="background:#f5f6f2;min-height:100vh;"/>
<view class="{{uiThemeClass}} screen cabinet-screen home-gallery {{themeClass}}" style="{{themeStyle}};{{uiThemeStyle}}">
<view hidden="{{uiTab!=='home'}}">  <collection-deck items="{{deckAlbums}}" collections="{{deckCollections}}" count="{{collectionCount}}" owner="{{deckOwner}}" avatar="{{deckAvatar}}" bindselect="openHomeAlbum" bindempty="openAdd"/></view>
<view class="album-card-modal ui-album-dialog" wx:if="{{albumCard}}" catchtouchmove="noop"><view class="album-card-scrim" bindtap="closeAlbumCard"/><view class="ui-album-sheet" catchtap="noop"><view class="ui-dialog-head"><text>{{i18n.t('唱片收藏',uiLanguage)}}</text><button class="ui-dialog-close" bindtap="closeAlbumCard" aria-label="{{i18n.t('关闭',uiLanguage)}}">×</button></view><scroll-view scroll-y class="ui-preview-body"><view class="ui-preview-content"><image class="ui-dialog-cover" src="{{albumCard.cover}}" mode="aspectFit" catchtap="uiImageActions" aria-role="button" aria-label="查看或保存图片"/><view class="ui-dialog-meta"><view class="ui-dialog-kicker"><text>{{albumCard.mediumLabel}} · {{albumCard.year}}</text><text>{{albumCard.priceLabel}}</text></view><view class="ui-dialog-title">{{albumCard.title}}</view><view class="ui-dialog-artist">{{albumCard.artist}}</view><view wx:if="{{uiLife[albumCard.id]}}" class="ui-life">{{i18n.t('人生第',uiLanguage)}} {{uiLife[albumCard.id]}} {{i18n.t('张唱片',uiLanguage)}}</view></view><view class="ui-preview-chips"><text>{{albumCard.style||albumCard.region}}</text><text>{{albumCard.mediumLabel}}</text><text>{{albumCard.priceLabel}}</text><text>{{albumCard.collectionDateLabel}}</text><text>{{albumCard.conditionLabel}}</text></view><view class="ui-preview-tracks"><view class="ui-preview-track" wx:for="{{albumCard.tracksPreview}}" wx:key="index"><text>{{index+1}}</text><text>{{item.title}}</text></view></view></view></scroll-view><view class="ui-preview-footer"><view class="ui-dialog-actions"><button class="ui-dialog-primary" bindtap="openCardDetail" aria-label="{{i18n.t('查看详情',uiLanguage)}}"><image src="/assets/ui/detail.svg" mode="aspectFit"/><text>{{i18n.t('查看详情',uiLanguage)}}</text></button><button class="ui-dialog-secondary" bindtap="handleCardCollectionAction" aria-label="{{i18n.t('编辑唱片',uiLanguage)}}"><image src="/assets/ui/edit.svg" mode="aspectFit"/><text>{{i18n.t('编辑唱片',uiLanguage)}}</text></button><button class="ui-dialog-delete" bindtap="handleCardDeleteAction" aria-label="{{i18n.t('删除唱片',uiLanguage)}}"><image src="/assets/ui/delete.svg" mode="aspectFit"/><text>{{i18n.t('删除唱片',uiLanguage)}}</text></button><button wx:if="{{albumCard.isCollected}}" class="ui-dialog-share" bindtap="uiTicketShare" aria-label="{{i18n.t('分享唱片',uiLanguage)}}"><image src="/assets/ui/share.svg" mode="aspectFit"/><text>{{i18n.t('分享唱片',uiLanguage)}}</text></button></view><view class="ui-dialog-pager"><button data-direction="-1" bindtap="moveAlbumCard" aria-label="{{i18n.t('上一张',uiLanguage)}}">‹</button><text>{{cardPositionLabel}}</text><button data-direction="1" bindtap="moveAlbumCard" aria-label="{{i18n.t('下一张',uiLanguage)}}">›</button></view></view></view></view>

  <view wx:if="{{uiMounted.add}}" hidden="{{uiTab!=='add'}}"><add-pane id="ui-add" visible="{{uiTab==='add'}}"/></view>
  <view wx:if="{{uiMounted.stats}}" hidden="{{uiTab!=='stats'}}"><stats-pane id="ui-stats" visible="{{uiTab==='stats'}}"/></view>
  <home-dock active="{{uiTab}}"/>
</view>

<page-container show="{{uiDetailOpen}}" position="bottom" duration="280" overlay="{{true}}" bindbeforeleave="uiDismissDetail" bindafterleave="uiDetailLeft" custom-style="height:100%;background:#f5f6f2;"><detail-sheet wx:if="{{uiDetailOptions}}" id="uiDetail" options="{{uiDetailOptions}}" bindclose="uiDismissDetail"/></page-container>
<ticket-share wx:if="{{uiTicket}}" ticket="{{uiTicket}}" bindclose="uiTicketClose"/>

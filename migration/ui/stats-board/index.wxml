<view class="board">
  <view wx:if="{{readOnly}}" class="snapshot-user"><text class="avatar">{{ownerInitial}}</text><view><view class="h2">{{owner}}</view><text class="muted">{{kind==='live'?'演出集':'唱片柜'}} · {{year}}</text></view></view>
  <view class="title-row"><text class="muted">统计年份</text><picker range="{{years}}" value="{{yearIndex}}" bindchange="yearChange" disabled="{{readOnly}}"><view class="select year-select">{{year}}<text>⌄</text></view></picker></view>
  <view class="card currency-card"><view class="h2"><image class="ico lime-icon" src="/assets/ui/wallet.svg"/>花费</view><view wx:for="{{totals}}" wx:key="currency" class="currency-total"><text>{{item.currency}}</text><text class="amount" data-exact="{{item.exact}}" bindtap="exactAmount">{{item.display}}</text></view></view>
  <view class="metrics"><view class="metric" wx:for="{{metrics}}" wx:key="label"><view class="metric-label"><image class="ico" src="/assets/ui/{{item.icon}}.svg"/><text>{{item.label}}</text></view><view class="number">{{item.value}}<text class="unit">{{item.unit}}</text></view></view></view>
  <view class="stack">
    <block wx:for="{{layout}}" wx:for-item="module" wx:key="id"><view wx:if="{{module.visible}}" class="card module" data-module="{{module.id}}">
      <block wx:if="{{module.id==='calendar'}}"><view class="between"><view class="h2"><image class="ico" src="/assets/ui/calendar.svg"/>{{module.label}}</view><text class="muted">{{year}}</text></view><view class="months"><view wx:for="{{months}}" wx:key="month" class="month tone-{{item.tone}}" data-month="{{item.month}}" bindtap="monthDetail" aria-role="button" aria-label="{{item.month}}月，{{item.count}}{{kind==='live'?'场':'张'}}"><text class="month-label">{{item.label}}</text><view class="month-number">{{item.count}}<text class="unit">{{kind==='live'?'场':'张'}}</text></view></view></view><view class="heat"><text>数量</text><view wx:for="{{[0,1,2,3,4]}}" wx:key="*this" class="heat-key tone-{{item}}"/><text>由少到多</text></view></block>
      <block wx:elif="{{module.id==='format'}}"><view class="between"><view class="h2"><image class="ico" src="/assets/ui/disc.svg"/>收藏形式</view><text class="muted">{{units}} 件</text></view><view class="donut" style="background:{{donutGradient}}"><view><text>{{units}}</text><text>COLLECTIONS</text></view></view><view wx:for="{{formats}}" wx:key="name" class="legend"><view><text class="dot" style="background:{{item.color}}"/>{{item.name}}</view><text>{{item.count}} 件 <text class="muted">{{item.percent}}%</text></text></view></block>
      <block wx:elif="{{module.id==='artists'}}"><view class="between"><view class="h2"><image class="ico" src="/assets/ui/people.svg"/>艺人排行</view><view class="pills"><button class="pill {{rankMetric==='count'?'active':''}}" data-metric="count" bindtap="rankChange">{{kind==='live'?'场次':'数量'}}</button><button class="pill {{rankMetric==='amount'?'active':''}}" data-metric="amount" bindtap="rankChange">花费</button></view></view><view wx:if="{{kind==='live'&&rankMetric==='amount'}}" class="between rank-currency"><text class="muted">多人场次均分</text><picker range="{{currencies}}" bindchange="currencyChange"><view class="select">{{currency}} ⌄</view></picker></view><view wx:for="{{ranks}}" wx:key="name" class="rankrow" data-name="{{item.name}}" bindtap="artistDetail"><text class="rank-index">{{item.rank}}</text><image wx:if="{{item.cover}}" class="rank-avatar" src="{{item.cover}}" data-src="{{item.cover}}" binderror="imageError" mode="aspectFill"/><view wx:else class="rank-avatar initial">{{item.initial}}</view><view class="rankcopy"><text>{{item.name}}</text><view class="rankbar"><view style="width:{{item.bar}}%"/></view></view><view class="rankvalue"><text wx:if="{{item.currency}}" class="muted">{{item.currency}}</text><text>{{item.value}}</text></view></view><view wx:if="{{!ranks.length}}" class="empty">暂无记录</view></block>
      <block wx:elif="{{module.id==='genres'}}"><view class="between"><view class="h2"><image class="ico" src="/assets/ui/music.svg"/>曲风排行</view><text class="muted">{{genres.length}} 种</text></view><data-chart mode="ring" rows="{{genres}}" total="{{genreTotal}}" label="曲风"/><scroll-view class="genre-scroll" wx:if="{{genres.length}}" scroll-y="{{genres.length>3}}" style="height:{{(genres.length>3?3:genres.length)*66}}px" enhanced="{{true}}" show-scrollbar="{{true}}" aria-label="曲风排行，上下滑动查看全部"><view wx:for="{{genres}}" wx:key="name" class="rankrow genre-row" data-name="{{item.name}}" bindtap="genreDetail"><text class="rank-index">{{item.rank}}</text><view class="rankcopy"><view class="genre-name"><text class="dot {{item.accent?'genre-accent':''}}" style="background:{{item.color}}"/><text>{{item.name}}</text></view></view><view class="rankvalue"><text>{{item.count}} 张</text><text class="muted">{{item.percent}}%</text></view></view></scroll-view><view wx:if="{{!genres.length}}" class="empty">暂无记录</view></block>
      <block wx:elif="{{module.id==='cities'}}"><view class="between"><view class="h2"><image class="ico" src="/assets/ui/location.svg"/>城市足迹</view><text class="muted">{{cities.length}} 座</text></view><view wx:for="{{cities}}" wx:key="name" class="city" data-name="{{item.name}}" bindtap="cityDetail"><text>{{item.name}}</text><view>{{item.count}}<text class="unit"> 场</text></view><text>›</text></view><view wx:if="{{!cities.length}}" class="empty">暂无城市足迹</view></block>
      <block wx:elif="{{module.id==='timeline'}}"><view class="between"><view class="h2"><image class="ico" src="/assets/ui/calendar.svg"/>时间线</view><picker range="{{timelineYearLabels}}" value="{{timelineYearIndex}}" bindchange="timelineChange" disabled="{{readOnly}}"><view class="select timeline-select">{{timelineYearLabel}} ⌄</view></picker></view><view class="timeline timeline-preview"><view wx:for="{{timelinePreview}}" wx:key="id" class="timeline-event" data-id="{{item.id}}" bindtap="selectRecord"><image wx:if="{{item.cover}}" class="timeline-art {{kind==='live'?'portrait':''}}" src="{{item.cover}}" data-src="{{item.cover}}" binderror="imageError" mode="aspectFill"/><view wx:else class="timeline-art initial">{{kind==='live'?'LIVE':'♪'}}</view><view class="timeline-info"><text>{{item.date||'日期待补'}}</text><text class="timeline-title">{{item.title}}</text><text>{{kind==='live'?item.city+' · '+item.venue:item.artist}}</text><text wx:if="{{item.sequence}}" class="life-tag">人生第 {{item.sequence}} {{kind==='live'?'场演出':'张唱片'}}</text></view><text>›</text></view><view wx:if="{{!timeline.length}}" class="empty">这一年还没有记录</view></view><button wx:if="{{timeline.length}}" class="timeline-more" bindtap="openTimeline">完整时间线 <text>{{timeline.length}} {{kind==='live'?'场':'张'}} ›</text></button></block>
    </view></block>
    <view wx:if="{{!readOnly}}" class="actions"><button class="primary" bindtap="openShare"><image class="ico inverse" src="/assets/ui/share.svg"/>统计分享</button><button class="secondary" bindtap="openLayout"><image class="ico" src="/assets/ui/filter.svg"/>统计排列</button></view>
  </view>
  <view wx:if="{{panel}}" class="overlay" catchtouchmove="noop"><view class="scrim" bindtap="close"/><view class="sheet"><view class="sheet-head"><text class="h2">{{panelTitle}}</text><button class="close" bindtap="close" aria-label="关闭">×</button></view><scroll-view scroll-y class="sheet-scroll">
    <block wx:if="{{panel==='layout'}}"><text class="muted">选择要显示的板块，用上下按钮调整顺序。</text><view wx:for="{{layoutDraft}}" wx:key="id" class="layout-row"><checkbox-group data-index="{{index}}" bindchange="layoutCheck"><label><checkbox checked="{{item.visible}}" value="on" color="#171a17"/>{{item.label}}</label></checkbox-group><view class="move"><button data-index="{{index}}" data-step="-1" bindtap="moveLayout" disabled="{{index===0}}" aria-label="上移{{item.label}}"><image class="reorder-icon" src="/assets/ui/reorder-up.svg" mode="aspectFit" aria-hidden="true"/></button><button data-index="{{index}}" data-step="1" bindtap="moveLayout" disabled="{{index===layoutDraft.length-1}}" aria-label="下移{{item.label}}"><image class="reorder-icon" src="/assets/ui/reorder-down.svg" mode="aspectFit" aria-hidden="true"/></button></view></view><button class="link" bindtap="resetLayout">恢复默认排列</button><view class="actions"><button class="secondary" bindtap="close">取消</button><button class="primary" bindtap="applyLayout">应用排列</button></view></block>
    <block wx:elif="{{panel==='share'}}"><button class="share-choice" bindtap="openModules"><image class="ico" src="/assets/ui/image.svg"/><view><text>分享统计页长图海报</text><text>用户名与完整统计页面</text></view><text>›</text></button><button class="share-choice" bindtap="openLink"><image class="ico" src="/assets/ui/copy.svg"/><view><text>页面链接</text><text>分享当前统计快照</text></view><text>›</text></button></block>
    <block wx:elif="{{panel==='modules'}}"><checkbox-group bindchange="posterCheck"><label wx:for="{{posterChoices}}" wx:key="id" class="module-choice"><checkbox value="{{item.id}}" checked="{{item.selected}}" color="#171a17"/>{{item.label}}</label></checkbox-group><view class="actions"><button class="secondary" bindtap="openShare">返回</button><button class="primary" bindtap="generatePoster" loading="{{generating}}" disabled="{{generating}}">生成海报 ›</button></view></block>
    <block wx:elif="{{panel==='link'}}"><view class="share-path">{{sharePath}}</view><view class="actions"><button class="secondary" bindtap="openShare">切换形式</button><button class="primary" open-type="share" disabled="{{!sharePath}}">发送给好友</button></view><button class="link" bindtap="copyPath">复制页面路径</button></block>
    <block wx:elif="{{panel==='poster'}}"><image wx:for="{{posterUrls}}" wx:key="*this" class="poster-preview" src="{{item}}" mode="widthFix" data-index="{{index}}" bindtap="previewPoster"/><view class="actions"><button class="secondary" bindtap="openModules">调整模块</button><button class="primary" bindtap="savePosters">保存图片</button></view></block>
    <block wx:else><view wx:for="{{detailCosts}}" wx:key="currency" class="currency-total"><text>{{item.currency}}</text><text>{{item.exact}}</text></view><view wx:for="{{detailRecords}}" wx:key="id" class="detail-row" data-id="{{item.id}}" bindtap="selectRecord"><image wx:if="{{item.cover}}" src="{{item.cover}}" data-src="{{item.cover}}" binderror="imageError" mode="aspectFill"/><view><text>{{item.date}}</text><text>{{item.title}}</text><text>{{item.artist}}</text></view><text>›</text></view><view wx:if="{{!detailRecords.length&&!detailCosts.length}}" class="empty">暂无记录</view></block>
  </scroll-view></view></view>
  <canvas type="2d" id="statsPoster" class="poster-canvas"/>
</view>

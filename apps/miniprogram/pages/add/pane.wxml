<wxs module="i18n" src="../../ui/locale.wxs"/>
<view class="{{uiThemeClass}} screen ui-add {{themeClass}}" style="{{themeStyle}};{{uiThemeStyle}}"><space-header avatar="{{uiAvatar||''}}"/><view class="ui-method-tabs"><button class="ui-method {{uiMethod==='search'?'active':''}}" data-method="search" bindtap="uiMethod">{{i18n.t('搜索唱片',uiLanguage)}}</button><button class="ui-method {{uiMethod==='batch'?'active':''}}" data-method="batch" bindtap="uiMethod">{{i18n.t('批量输入',uiLanguage)}}</button><button class="ui-method {{uiMethod==='manual'?'active':''}}" data-method="manual" bindtap="uiMethod">{{i18n.t('手动新建',uiLanguage)}}</button></view><view class="ui-add-card"><block wx:if="{{uiMethod==='search'}}"><view class="ui-h2">{{i18n.t('搜索唱片',uiLanguage)}}</view><view class="ui-search-row"><view class="ui-search"><image class="ui-icon" src="/assets/ui/search.svg"/><input class="ui-search-input" value="{{query}}" bindinput="handleQuery" bindconfirm="goSearch" confirm-type="search" placeholder="{{i18n.t('艺人或专辑名',uiLanguage)}}"/><button wx:if="{{query}}" class="ui-clear" bindtap="clearQuery" aria-label="{{i18n.t('清空搜索',uiLanguage)}}">×</button></view><button class="ui-primary" bindtap="goSearch">{{i18n.t('搜索',uiLanguage)}}</button></view><view wx:if="{{hasSearch}}" class="ui-search-results"><view wx:if="{{searchLoading}}" class="ui-muted">{{i18n.t('搜索中…',uiLanguage)}}</view><view wx:for="{{results}}" wx:key="id" class="ui-result" data-album-id="{{item.id}}" bindtap="openAlbum"><image class="ui-result-cover" src="{{item.cover}}" mode="aspectFill"/><view class="ui-result-copy"><text class="ui-result-title">{{item.title}}</text><text class="ui-muted">{{item.artist}} · {{item.year}}</text></view><image class="ui-disclosure ui-disclosure-right" src="/assets/ui/chevron-right.svg" mode="aspectFit" aria-hidden="true"/></view><view wx:if="{{!results.length&&!searchLoading}}" class="ui-muted">{{i18n.t('没有匹配结果',uiLanguage)}}</view><button wx:if="{{results.length}}" class="ui-more" bindtap="goSearch">{{i18n.t('查看全部结果 →',uiLanguage)}}</button></view></block><block wx:elif="{{uiMethod==='batch'}}"><view class="ui-h2">{{i18n.t('批量输入',uiLanguage)}}</view><view class="ui-muted">{{i18n.t('每行一张 · 艺人 — 专辑',uiLanguage)}}</view><textarea class="ui-add-textarea" value="{{uiBatchText}}" bindinput="uiBatchInput" maxlength="40000" placeholder="{{uiBatchPlaceholder}}" aria-label="{{i18n.t('批量唱片文本',uiLanguage)}}"/><button class="ui-primary ui-full" bindtap="uiMatchBatch">{{i18n.t('匹配唱片 →',uiLanguage)}}</button><view wx:if="{{i18n.t(uiError,uiLanguage)}}" class="ui-error">{{i18n.t(uiError,uiLanguage)}}</view></block><block wx:else><view class="ui-h2">{{i18n.t('手动新建',uiLanguage)}}</view><button class="ui-manual-entry" bindtap="goManualAdd"><image class="ui-icon" src="/assets/ui/add.svg"/><text>{{i18n.t('新建一张唱片',uiLanguage)}}</text></button></block></view><view class="ui-share-card"><view class="ui-between"><view class="ui-h2">{{i18n.t('全部收藏',uiLanguage)}}</view><button class="ui-link" open-type="share" data-ui-all="true"><image class="ui-icon" src="/assets/ui/share.svg"/>{{i18n.t('分享',uiLanguage)}}</button></view><button class="ui-share-open" bindtap="goAllCollection"><view class="ui-menu-icon"><image class="ui-icon" src="/assets/ui/disc.svg"/></view><view class="ui-result-copy"><text class="ui-share-count">{{collectionCount}} {{i18n.t('张唱片',uiLanguage)}}</text><text class="ui-muted">{{i18n.t('查看全部收藏',uiLanguage)}}</text></view><image class="ui-disclosure ui-disclosure-right" src="/assets/ui/chevron-right.svg" mode="aspectFit" aria-hidden="true"/></button></view></view>

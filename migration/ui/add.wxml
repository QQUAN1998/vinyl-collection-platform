<view class="screen ui-add {{themeClass}}" style="{{themeStyle}}"><space-header avatar="{{uiAvatar||''}}"/><view class="ui-page-title">添加唱片</view><view class="ui-method-tabs"><button class="ui-method {{uiMethod==='search'?'active':''}}" data-method="search" bindtap="uiMethod">搜索唱片</button><button class="ui-method {{uiMethod==='batch'?'active':''}}" data-method="batch" bindtap="uiMethod">批量输入</button><button class="ui-method {{uiMethod==='manual'?'active':''}}" data-method="manual" bindtap="uiMethod">手动新建</button></view><view class="ui-add-card"><block wx:if="{{uiMethod==='search'}}"><view class="ui-h2">搜索唱片</view><view class="ui-search-row"><view class="ui-search"><image class="ui-icon" src="/assets/ui/search.svg"/><input class="ui-search-input" value="{{query}}" bindinput="handleQuery" bindconfirm="goSearch" confirm-type="search" placeholder="艺人或专辑名"/><button wx:if="{{query}}" class="ui-clear" bindtap="clearQuery" aria-label="清空搜索">×</button></view><button class="ui-primary" bindtap="goSearch">搜索</button></view><view wx:if="{{hasSearch}}" class="ui-search-results"><view wx:if="{{searchLoading}}" class="ui-muted">搜索中…</view><view wx:for="{{results}}" wx:key="id" class="ui-result" data-album-id="{{item.id}}" bindtap="openAlbum"><image class="ui-result-cover" src="{{item.cover}}" mode="aspectFill"/><view class="ui-result-copy"><text class="ui-result-title">{{item.title}}</text><text class="ui-muted">{{item.artist}} · {{item.year}}</text></view><text>›</text></view><view wx:if="{{!results.length&&!searchLoading}}" class="ui-muted">没有匹配结果</view><button wx:if="{{results.length}}" class="ui-more" bindtap="goSearch">查看全部结果 →</button></view></block><block wx:elif="{{uiMethod==='batch'}}"><view class="ui-h2">批量输入</view><view class="ui-muted">每行一张 · 艺人 — 专辑</view><textarea class="ui-add-textarea" value="{{uiBatchText}}" bindinput="uiBatchInput" maxlength="40000" placeholder="伍佰 - 浪人情歌&#10;Adele - 21" aria-label="批量唱片文本"/><button class="ui-primary ui-full" bindtap="uiMatchBatch">匹配唱片 →</button><view wx:if="{{uiError}}" class="ui-error">{{uiError}}</view></block><block wx:else><view class="ui-h2">手动新建</view><button class="ui-manual-entry" bindtap="goManualAdd"><image class="ui-icon" src="/assets/ui/add.svg"/><text>新建一张唱片</text></button></block></view><view class="ui-share-card"><view class="ui-between"><view class="ui-h2">全部收藏</view><button class="ui-link" open-type="share" data-ui-all="true"><image class="ui-icon" src="/assets/ui/share.svg"/>分享</button></view><button class="ui-share-open" bindtap="goAllCollection"><view class="ui-menu-icon"><image class="ui-icon" src="/assets/ui/disc.svg"/></view><view class="ui-result-copy"><text class="ui-share-count">{{collectionCount}} 张唱片</text><text class="ui-muted">查看全部收藏</text></view><text>›</text></button></view><bottom-nav active="add"/></view>

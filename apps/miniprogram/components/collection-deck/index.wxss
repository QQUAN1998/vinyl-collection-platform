loss{pointer-events:none;position:absolute;inset:0;box-shadow:inset 0 0 0 1px #ffffff8c,inset 2px 2px 6px #fff4,inset -3px -3px 8px #0003;background:linear-gradient(135deg,#ffffff36 0%,#ffffff05 27%,#fff0 47%,#ffffff20 49%,#ffffff05 55%,#00000008 100%)}.deck-slide.is-opening{animation:cover-rise .24s ease-in forwards}.deck-placeholder{height:100%;box-sizing:border-box;padding:20px;display:flex;flex-direction:column;justify-content:space-between;background:var(--color-soft);font-size:10px}.deck-placeholder-title{font-size:22px;font-weight:700;line-height:1.3;display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden}.deck-caption{padding:16px 32px 0;display:flex;align-items:center;text-align:center;flex-direction:column;gap:5px;min-height:96px;box-sizing:border-box}.deck-title{font-size:21px;font-weight:600;line-height:1.35;max-width:100%;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.deck-artist{font-size:12px;color:var(--color-muted);max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.deck-sequence{font-size:10px;color:var(--color-muted);margin-top:12px;min-height:14px}.deck-pagination{margin-top:auto;padding:22px 16px 4px}.deck-ruler{position:relative;height:30px;overflow:hidden}.ruler-track{position:absolute;left:-24px;right:-24px;top:9px;height:12px;background-image:repeating-linear-gradient(90deg,var(--color-line) 0px,var(--color-line) 2px,transparent 2px,transparent 12px);will-change:background-position}.ruler-needle{position:absolute;top:0;bottom:0;left:calc(50% - 1px);width:2px;background:var(--color-ink);box-shadow:0 0 0 4px var(--color-screen)}.deck-position{display:block;text-align:center;font-size:10px;font-variant-numeric:tabular-nums;color:var(--color-muted);margin-top:8px}.deck-empty{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:24px;padding:64px 24px}.deck-empty>.n-image{width:100px;height:100px;opacity:.25}.deck-empty .n-button{font-size:12px;background:#d1ff66;border-radius:22px;padding:12px 20px}.deck-empty .n-button::after{border:0}.live-deck .deck-scroll{height:clamp(220px,calc(100vh - 385px),400px);max-height:none}.ticket-art{height:clamp(190px,calc(100vh - 415px),370px);aspect-ratio:auto;padding:12px 12px 0;border:0;box-shadow:0 14px 23px -12px #171a1760}.ticket-art .art-picture{height:calc(100% - 37px);background:#0000000a}.ticket-footer{display:flex;align-items:center;justify-content:space-between;gap:8px;height:37px;color:var(--theme-card-surface);font-size:10px;line-height:1.3;padding:0 3px;overflow:hidden}.ticket-footer .n-text:first-child{flex-shrink:0}.ticket-footer .n-text:last-child{max-width:70%;text-overflow:ellipsis;white-space:nowrap;overflow:hidden}.ticket-art::before,.ticket-art::after{content:'';position:absolute;top:0;bottom:0;width:7px;pointer-events:none}.ticket-art::before{left:0;background:radial-gradient(circle at 0 6px,var(--color-screen) 3px,transparent 3.5px) 0 0/7px 12px repeat-y}.ticket-art::after{right:0;background:radial-gradient(circle at 7px 6px,var(--color-screen) 3px,transparent 3.5px) 0 0/7px 12px repeat-y}

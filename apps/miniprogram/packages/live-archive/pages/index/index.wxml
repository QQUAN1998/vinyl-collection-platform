<wxs module="i18n" src="../../../../ui/locale.wxs"/><page-meta root-background-color="{{uiModalBackground}}" background-color="#f5f6f2" background-color-top="#f5f6f2" background-color-bottom="{{uiModalBackground}}" page-style="background:#f5f6f2;min-height:100vh;"/>
<view class="{{uiThemeClass}} page {{tab==='home'&&!shared?'home-gallery':''}}" style="{{uiThemeStyle}}">
  <space-header wx:if="{{tab!=='mine'&&tab!=='home'&&!shared}}" kind="live" avatar="{{account.avatar||''}}"/><view class="loading" wx:if="{{busy}}">{{i18n.t('加载中…',uiLanguage)}}</view>
  <view class="notice" wx:if="{{i18n.t(message,uiLanguage)}}">{{i18n.t(message,uiLanguage)}}<button class="link" wx:if="{{tab==='home'&&!sessions.length}}" bindtap="refresh">{{i18n.t('重试加载',uiLanguage)}}</button></view>
  <block>
    <view hidden="{{tab!=='home'}}" style="display:{{tab==='home'?'block':'none'}}"><collection-deck wx:if="{{uiHomeMounted}}" visible="{{tab==='home'}}" loading="{{busy}}" kind="live" items="{{records}}" count="{{count}}" owner="{{shared?'':account.name||''}}" avatar="{{account.avatar||''}}" show-amount="{{!shared}}" read-only="{{shared}}" bindselect="openDeck" bindempty="manual"/></view>
    <view wx:if="{{tab==='collection'}}" class="catalog"><view class="ui-catalog-head"><view class="ui-catalog-heading"><view class="ui-catalog-title">{{i18n.t('全部演出',uiLanguage)}}</view><text class="ui-catalog-count">{{count}} {{i18n.t('场收藏',uiLanguage)}}</text></view><block wx:if="{{!shared}}"><button wx:if="{{allShareReady}}" class="ui-catalog-share" open-type="share" data-scope="all" disabled="{{!count||busy}}" aria-label="{{i18n.t('分享全部演出',uiLanguage)}}"><image src="/assets/ui/share.svg"/>{{i18n.t('分享',uiLanguage)}}</button><button wx:else class="ui-catalog-share" bindtap="prepareAllShare" loading="{{preparingAllShare}}" disabled="{{!count||busy||preparingAllShare}}" aria-label="{{i18n.t('准备分享全部演出',uiLanguage)}}"><image src="/assets/ui/share.svg"/>{{i18n.t('分享',uiLanguage)}}</button></block></view>
<view class="ui-catalog-search"><image src="/assets/ui/search.svg"/><input placeholder="{{i18n.t('搜索演出、艺人、城市',uiLanguage)}}" value="{{query}}" bindinput="search" aria-label="{{i18n.t('搜索收藏',uiLanguage)}}"/></view>
      <view class="filter-row">
        <ui-select range="{{cities}}" data-key="filterCity" data-options="cities" bindchange="picker"><view class="ui-disclosure-row"><text>{{i18n.t(filterCity,uiLanguage)}}</text><image class="ui-disclosure ui-disclosure-down" src="/assets/ui/chevron-down.svg" mode="aspectFit" aria-hidden="true"/></view></ui-select>
        <ui-select range="{{types}}" data-key="filterType" data-options="types" bindchange="picker"><view class="ui-disclosure-row"><text>{{i18n.t(filterType,uiLanguage)}}</text><image class="ui-disclosure ui-disclosure-down" src="/assets/ui/chevron-down.svg" mode="aspectFit" aria-hidden="true"/></view></ui-select>
        <ui-select range="{{yearOptions}}" data-key="filterYear" data-options="yearOptions" bindchange="picker"><view class="ui-disclosure-row"><text>{{i18n.t(filterYear,uiLanguage)}}</text><image class="ui-disclosure ui-disclosure-down" src="/assets/ui/chevron-down.svg" mode="aspectFit" aria-hidden="true"/></view></ui-select>
      </view>
      <view class="ui-catalog-results"><text>{{query?filtered.length+' / ':''}}{{count}} {{i18n.t('场演出',uiLanguage)}}</text></view>
      <view class="{{view==='grid'?'poster-grid':'ticket-list'}}">
        <view wx:for="{{filtered}}" wx:key="id" data-id="{{item.id}}" bindtap="open" class="record-card" aria-role="button" aria-label="{{item.name}}">
          <view class="poster theme-{{item.theme}}"><image wx:if="{{item.cover||item.posterUrl}}" src="{{item.cover||item.posterUrl}}" mode="aspectFit" lazy-load/><block wx:else><text class="poster-label">LIVE</text><text class="poster-name">{{item.name}}</text><text class="tiny">{{item.date||i18n.t('待定',uiLanguage)}}</text></block></view>
          <view class="record-copy"><view class="card-name">{{item.name}}</view><view class="card-meta">{{item.artist||item.type}}</view><view class="card-meta">{{item.date||i18n.t('待定',uiLanguage)}} · {{item.city||i18n.t('城市待补',uiLanguage)}}</view></view>
        </view>
      </view>
      <view wx:if="{{!filtered.length&&!busy}}" class="empty">{{count?i18n.t('没有符合条件的现场',uiLanguage):i18n.t('收藏第一场现场',uiLanguage)}}<button wx:if="{{!shared}}" bindtap="manual" class="primary">{{i18n.t('添加现场',uiLanguage)}}</button></view>
    </view>
  </block>
  <block wx:if="{{tab==='add'}}">
    <view class="ui-method-tabs"><button class="ui-method {{addEntry==='search'?'active':''}}" data-value="search" bindtap="entry" disabled="{{busy}}">{{i18n.t('秀动搜索',uiLanguage)}}</button><button class="ui-method {{addEntry==='link'?'active':''}}" data-value="link" bindtap="entry" disabled="{{busy}}">{{i18n.t('大麦搜索',uiLanguage)}}</button><button class="ui-method {{addEntry==='manual'?'active':''}}" data-value="manual" bindtap="entry" disabled="{{busy}}">{{i18n.t('手动添加',uiLanguage)}}</button></view>
    <view class="ui-add-card ui-live-add"><view wx:if="{{addEntry==='search'}}"><view class="ui-h2">{{i18n.t('秀动搜索',uiLanguage)}}</view>
      <view class="ui-search-row"><view class="ui-search"><image class="ui-icon" src="/assets/ui/search.svg"/><input class="ui-search-input" placeholder="{{i18n.t('艺人名称',uiLanguage)}}" value="{{artistQuery}}" bindinput="artistQuery" bindconfirm="searchArtists" confirm-type="search" maxlength="80" disabled="{{busy}}" aria-label="{{i18n.t('搜索艺人',uiLanguage)}}"/></view><button class="ui-primary" bindtap="searchArtists" disabled="{{busy}}" loading="{{busy}}">{{i18n.t('搜索',uiLanguage)}}</button></view>
      <view class="candidate" wx:for="{{artists}}" wx:key="id" data-id="{{item.id}}" bindtap="selectArtist" aria-role="button" aria-label="{{i18n.t('选择',uiLanguage)}}{{item.name}}"><view>{{item.name}}</view><view class="muted" wx:if="{{item.style}}">{{item.style}}</view><text class="candidate-arrow" wx:if="{{selectedArtist.id===item.id}}">✓</text><image wx:else class="ui-disclosure ui-disclosure-right" src="/assets/ui/chevron-right.svg" mode="aspectFit" aria-hidden="true"/></view>
      <view class="empty" wx:if="{{searched&&!artists.length&&!busy}}">{{i18n.t('没有匹配艺人',uiLanguage)}}</view>
      <view class="section-title section" wx:if="{{selectedArtist}}">{{selectedArtist.name}} {{i18n.t('· 场次',uiLanguage)}}</view>
      <view class="candidate event" wx:for="{{artistEvents}}" wx:key="id" data-id="{{item.id}}" bindtap="selectEvent" aria-role="button" aria-label="{{i18n.t('选择',uiLanguage)}}{{item.name}}"><image wx:if="{{item.posterUrl}}" class="event-poster" src="{{item.posterUrl}}" mode="aspectFill" lazy-load/><view class="event-copy"><view>{{item.name}}</view><view class="muted">{{item.date||i18n.t('日期待补',uiLanguage)}} {{item.time}} · {{item.city}}</view><view class="muted" wx:if="{{item.venue}}">{{item.venue}}</view></view><image class="candidate-arrow ui-disclosure ui-disclosure-right" src="/assets/ui/chevron-right.svg" mode="aspectFit" aria-hidden="true"/></view>
    </view>
    <view wx:elif="{{addEntry==='link'}}" class="ui-live-add"><view class="ui-h2">{{i18n.t('大麦搜索',uiLanguage)}}</view><textarea class="ui-add-textarea" placeholder="{{i18n.t('粘贴大麦链接或分享文案',uiLanguage)}}" value="{{source}}" bindinput="source" aria-label="{{i18n.t('大麦分享链接',uiLanguage)}}" disabled="{{busy}}"/><button class="ui-primary ui-full" bindtap="importLink" disabled="{{busy}}" loading="{{busy}}">{{i18n.t('识别链接',uiLanguage)}}</button><ui-select wx:if="{{sessions.length}}" range="{{sessions}}" range-key="label" bindchange="session"><view class="select section ui-disclosure-row"><text>{{i18n.t('选择场次',uiLanguage)}}</text><image class="ui-disclosure ui-disclosure-down" src="/assets/ui/chevron-down.svg" mode="aspectFit" aria-hidden="true"/></view></ui-select></view>
    <view wx:elif="{{addEntry==='manual'}}"><view class="ui-h2">{{i18n.t('手动添加',uiLanguage)}}</view><button class="ui-manual-entry" bindtap="manual" disabled="{{busy}}"><image class="ui-icon" src="/assets/ui/add.svg"/><text>{{i18n.t('记录一场现场',uiLanguage)}}</text></button></view></view>
    <view class="ui-share-card"><view class="ui-between"><view class="ui-h2">{{i18n.t('全部收藏',uiLanguage)}}</view><button wx:if="{{allShareReady}}" class="ui-link" open-type="share" data-scope="all" disabled="{{!count||busy}}"><image class="ui-icon" src="/assets/ui/share.svg"/>{{i18n.t('分享',uiLanguage)}}</button><button wx:else class="ui-link" bindtap="prepareAllShare" disabled="{{!count||busy||preparingAllShare}}" loading="{{preparingAllShare}}"><image class="ui-icon" src="/assets/ui/share.svg"/>{{i18n.t('分享',uiLanguage)}}</button></view><button class="ui-share-open" bindtap="allCollection"><view class="ui-menu-icon"><image class="ui-icon" src="/assets/ui/ticket.svg"/></view><view class="ui-result-copy"><text class="ui-share-count">{{count}} {{i18n.t('场现场',uiLanguage)}}</text><text class="ui-muted">{{i18n.t('查看全部收藏',uiLanguage)}}</text></view><image class="ui-disclosure ui-disclosure-right" src="/assets/ui/chevron-right.svg" mode="aspectFit" aria-hidden="true"/></button></view>
  </block>
  <block wx:if="{{tab==='stats'}}"><stats-board share-source="{{uiStatsShareSource}}" avatar="{{shared ? null : account.avatar}}" collection-share-ready="{{allShareReady}}" collection-preparing="{{preparingAllShare}}" bindcollectionshare="uiCollectionShare" records="{{uiStatsRecords}}" kind="live" media-share="{{uiShareToken}}" owner="{{account.name||'音乐收藏者'}}" read-only="{{shared}}" bindselect="uiSelect" bindsnapshot="uiShare"/></block>
  <block wx:if="{{tab==='mine'}}">
    <button class="account-card section" bindtap="openAccount"><image wx:if="{{account.avatar}}" class="account-avatar" src="{{account.avatar}}" mode="aspectFill"/><image wx:else class="account-avatar" src="/assets/ui/brand/default-avatar.jpg" mode="aspectFill"/><view class="account-copy"><text class="account-name">{{account.name}}</text><text class="muted account-caption">{{i18n.t('唱片柜 · 演出集',uiLanguage)}}</text></view><image class="menu-arrow ui-disclosure ui-disclosure-right" src="/assets/ui/chevron-right.svg" mode="aspectFit" aria-hidden="true"/></button>
    <view class="archive-summary section"><text class="muted">LIVE ARCHIVE</text><view class="title">{{i18n.t('我的现场档案',uiLanguage)}}</view><view class="numbers"><view><text>{{count}}</text><view>{{i18n.t('场收藏',uiLanguage)}}</view></view><view><text>{{archiveYears}}</text><view>{{i18n.t('个年份',uiLanguage)}}</view></view><view><text>{{cities.length-1}}</text><view>{{i18n.t('座城市',uiLanguage)}}</view></view></view></view>
    <view class="mine-menu section"><button wx:if="{{shareReady}}" class="menu row" open-type="share"><text>{{i18n.t('分享演出集',uiLanguage)}}</text><text class="menu-arrow">↗</text></button><button wx:else class="menu row" bindtap="prepareShare"><text>{{i18n.t('准备分享',uiLanguage)}}</text><text class="menu-arrow">↗</text></button><button class="menu row" bindtap="annual"><text>{{i18n.t('年度回顾',uiLanguage)}}</text><text class="menu-arrow">↗</text></button><button class="menu row" bindtap="exportData" disabled="{{busy}}"><text>{{i18n.t('导出完整备份',uiLanguage)}}</text><text class="menu-arrow">↓</text></button></view>
  </block>
  <button wx:if="{{shared}}" class="outline section" bindtap="exitShare">{{i18n.t('打开我的演出集',uiLanguage)}}</button>
</view>
<home-dock wx:if="{{!shared}}" kind="live" active="{{tab==='collection'?'add':tab}}"/>
<canvas type="2d" id="annualCanvas" class="annual-canvas"/>

<page-container show="{{uiDetailOpen}}" position="bottom" duration="280" overlay="{{true}}" bindbeforeleave="uiDismissDetail" bindafterleave="uiDetailLeft" custom-style="height:100%;background:#f5f6f2;"><detail-sheet wx:if="{{uiDetailOptions}}" id="uiDetail" options="{{uiDetailOptions}}" bindclose="uiDismissDetail"/></page-container>
<view class="{{uiThemeClass}} ui-album-dialog ui-live-preview" style="{{uiThemeStyle}}" wx:if="{{uiPreviewRecord}}" catchtouchmove="noop"><view class="album-card-scrim" bindtap="uiPreviewClose"/><view class="ui-album-sheet"><view class="ui-dialog-head"><text>{{i18n.t('现场收藏',uiLanguage)}}</text><button class="ui-dialog-close" bindtap="uiPreviewClose" aria-label="{{i18n.t('关闭',uiLanguage)}}">×</button></view><scroll-view scroll-y class="ui-preview-body"><view class="ui-preview-content"><image class="ui-dialog-cover" src="{{uiPreviewRecord.cover||uiPreviewRecord.posterUrl}}" mode="aspectFit" catchtap="uiImageActions" aria-role="button" aria-label="查看或保存图片"/><view class="ui-dialog-title">{{uiPreviewRecord.name}}</view><view class="ui-dialog-artist">{{uiPreviewRecord.artist}}</view><view class="ui-preview-chips"><text>{{uiPreviewRecord.date}}</text><text>{{uiPreviewRecord.city}}</text><text>{{uiPreviewRecord.type}}</text><text wx:if="{{!shared}}">{{uiPreviewPrice}}</text></view><view class="ui-preview-venue">{{uiPreviewRecord.venue}}</view><view class="ui-preview-tracks"><view class="ui-preview-track" wx:for="{{uiPreviewRecord.songs}}" wx:key="index"><text>{{index+1}}</text><text>{{item}}</text></view></view></view></scroll-view><view class="ui-preview-footer"><view class="ui-dialog-actions"><button class="ui-dialog-primary" bindtap="uiPreviewDetail" aria-label="{{i18n.t('查看详情',uiLanguage)}}"><image src="/assets/ui/detail.svg" mode="aspectFit"/><text>{{i18n.t('查看详情',uiLanguage)}}</text></button><button wx:if="{{!shared}}" class="ui-dialog-secondary" bindtap="uiPreviewEdit" aria-label="{{i18n.t('编辑演出',uiLanguage)}}"><image src="/assets/ui/edit.svg" mode="aspectFit"/><text>{{i18n.t('编辑演出',uiLanguage)}}</text></button><button wx:if="{{!shared}}" class="ui-dialog-delete" bindtap="uiPreviewDelete" disabled="{{busy}}" aria-label="{{i18n.t('删除演出',uiLanguage)}}"><image src="/assets/ui/delete.svg" mode="aspectFit"/><text>{{i18n.t('删除演出',uiLanguage)}}</text></button><button wx:if="{{!shared}}" class="ui-dialog-share" bindtap="uiTicketShare" aria-label="{{i18n.t('分享演出',uiLanguage)}}"><image src="/assets/ui/share.svg" mode="aspectFit"/><text>{{i18n.t('分享演出',uiLanguage)}}</text></button></view><view class="ui-dialog-pager"><button data-step="-1" bindtap="uiPreviewMove" aria-label="{{i18n.t('上一场',uiLanguage)}}">‹</button><text>{{uiPreviewIndex+1}} / {{count}}</text><button data-step="1" bindtap="uiPreviewMove" aria-label="{{i18n.t('下一场',uiLanguage)}}">›</button></view></view></view></view>

<ticket-share wx:if="{{uiTicket}}" ticket="{{uiTicket}}" bindclose="uiTicketClose"/>
